{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.65.0"},"browser":{"name":"firefox","version":"159.0"},"pages":[{"startedDateTime":"2026-11-27T23:27:19.266Z","id":"page@4c64dcba6b879337edd4a42cb471a1fa","title":"ApkStart","pageTimings":{"onContentLoad":504,"onLoad":594}}],"entries":[{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.286Z","time":48.315,"request":{"method":"GET","url":"http://127.0.0.1:8765/index.html","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"}],"queryString":[],"headersSize":428,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/html"},{"name":"Content-Length","value":"56108"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":56108,"mimeType":"text/html","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; img-src 'self' file: data:; style-src 'self' 'unsafe-inline'; script-src 'self'\" />\n<title>ApkStart</title>\n<link rel=\"stylesheet\" href=\"style.css\" />\n<link rel=\"stylesheet\" href=\"theme.css\" />\n</head>\n<body>\n\n<!-- 品牌标记：小尺寸下也要认得出来，所以用矢量而不是 1024 的位图缩到 22px -->\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n  <defs>\n    <linearGradient id=\"brandGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#2ee6a6\"/>\n      <stop offset=\"55%\" stop-color=\"#12b886\"/>\n      <stop offset=\"100%\" stop-color=\"#0a6f47\"/>\n    </linearGradient>\n  </defs>\n  <symbol id=\"brandMark\" viewBox=\"0 0 48 48\">\n    <rect x=\"1.5\" y=\"1.5\" width=\"45\" height=\"45\" rx=\"13.5\" fill=\"url(#brandGrad)\"/>\n    <rect x=\"1.5\" y=\"1.5\" width=\"45\" height=\"45\" rx=\"13.5\" fill=\"none\" stroke=\"rgba(255,255,255,.34)\" stroke-width=\"1.4\"/>\n    <path d=\"M18.5 14.5 35 24 18.5 33.5z\" fill=\"#fff\"/>\n  </symbol>\n</svg>\n\n<header class=\"titlebar\">\n  <div class=\"brand\">\n    <div class=\"logo\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 48 48\" width=\"22\" height=\"22\"><use href=\"#brandMark\"/></svg>\n    </div>\n    <span class=\"brand-name\">ApkStart</span>\n    <span class=\"brand-tag\" id=\"engineTag\">未连接运行时</span>\n  </div>\n  <div class=\"titlebar-spacer\"></div>\n  <div class=\"titlebar-actions\">\n    <button class=\"icon-btn\" id=\"btnManual\" title=\"使用手册（含故障解决方案）\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.4 9a2.8 2.8 0 1 1 4.4 2.3c-.9.6-1.8 1.1-1.8 2.4\"/><circle cx=\"12\" cy=\"17.2\" r=\".9\" fill=\"currentColor\" stroke=\"none\"/></svg>\n    </button>\n    <button class=\"icon-btn\" id=\"btnSettings\" title=\"设置\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6h.09A1.7 1.7 0 0 0 10 3.05V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9v.09a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1z\"/></svg>\n    </button>\n  </div>\n</header>\n\n<main class=\"shell\">\n  <section class=\"toolbar\">\n    <div class=\"search\">\n      <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n      <input id=\"search\" type=\"text\" placeholder=\"搜索已安装应用\" autocomplete=\"off\" />\n    </div>\n    <div class=\"toolbar-right\">\n      <button class=\"btn primary\" id=\"btnInstall\">\n        <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 5v10\"/><path d=\"m7 12 5 5 5-5\"/><path d=\"M5 20h14\"/></svg>\n        安装 APK\n      </button>\n    </div>\n  </section>\n\n  <section class=\"content\" id=\"content\">\n    <div class=\"grid\" id=\"grid\"></div>\n    <div class=\"empty\" id=\"empty\">\n      <div class=\"empty-art\">\n        <svg viewBox=\"0 0 160 120\" width=\"220\">\n          <rect x=\"18\" y=\"16\" width=\"124\" height=\"50\" rx=\"10\" fill=\"#eef1f4\" stroke=\"#dde2e8\"/>\n          <rect x=\"34\" y=\"34\" width=\"30\" height=\"14\" rx=\"4\" fill=\"#cfd8e3\"/>\n          <rect x=\"72\" y=\"34\" width=\"52\" height=\"6\" rx=\"3\" fill=\"#dde5ee\"/>\n          <rect x=\"72\" y=\"44\" width=\"36\" height=\"6\" rx=\"3\" fill=\"#e6ecf3\"/>\n          <path d=\"M80 76v22m0 0-9-9m9 9 9-9\" stroke=\"#9fb0c2\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n          <rect x=\"40\" y=\"100\" width=\"80\" height=\"8\" rx=\"4\" fill=\"#eef1f4\"/>\n        </svg>\n      </div>\n      <h2>把 APK 拖进来就能装</h2>\n      <p>安装完成后会自动生成桌面图标，双击即以独立窗口运行，和普通 Windows 软件一样。<br/>已注册 .apk 关联时，在资源管理器里双击 APK 也会直接装到 ApkStart。</p>\n      <button class=\"btn primary lg\" id=\"btnInstall2\">选择 APK 文件</button>\n      <p class=\"hint\" id=\"emptyHint\"></p>\n    </div>\n  </section>\n\n  <footer class=\"statusbar\">\n    <div class=\"status-left\">\n      <span class=\"dot\" id=\"statusDot\"></span>\n      <span id=\"statusText\">正在检查运行时…</span>\n      <button class=\"status-chip\" id=\"envChip\" hidden></button>\n    </div>\n    <div class=\"status-right\">\n      <span class=\"status-item status-net\" id=\"statusNet\" hidden></span>\n      <span class=\"sep\" id=\"statusNetSep\" hidden></span>\n      <span class=\"status-item\" id=\"statusDevice\"></span>\n      <span class=\"sep\"></span>\n      <span class=\"status-item\" id=\"statusStats\"></span>\n      <span class=\"sep\"></span>\n      <a class=\"status-item powered-link\" href=\"https://github.com/meshackbahati/apkstart-linux\" target=\"_blank\" rel=\"noopener\">ApkStart Linux</a>\n    </div>\n  </footer>\n</main>\n\n<!-- 启动欢迎卡：替代原来散落的各种启动小提示 -->\n<div class=\"modal-mask welcome-mask\" id=\"welcomeMask\" hidden>\n  <div class=\"welcome\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"welcomeHi\">\n    <div class=\"welcome-hero\">\n      <div class=\"welcome-halo\"></div>\n      <div class=\"welcome-badge\"><svg viewBox=\"0 0 48 48\" width=\"44\" height=\"44\" aria-hidden=\"true\"><use href=\"#brandMark\"/></svg></div>\n      <div class=\"welcome-hi\" id=\"welcomeHi\">你好</div>\n      <div class=\"welcome-sub\" id=\"welcomeSub\">ApkStart 已就绪</div>\n    </div>\n    <div class=\"welcome-body\">\n      <div class=\"welcome-stats\" id=\"welcomeStats\"></div>\n      <div class=\"welcome-tips\" id=\"welcomeTips\"></div>\n      <label class=\"welcome-opt\">\n        <input type=\"checkbox\" id=\"welcomeNever\" />\n        <span>下次启动不再自动弹出</span>\n      </label>\n    </div>\n    <div class=\"welcome-actions\">\n      <button class=\"btn ghost\" id=\"welcomeSettings\">打开设置</button>\n      <button class=\"btn primary\" id=\"welcomeOk\">开始使用</button>\n    </div>\n  </div>\n</div>\n\n<!-- 安装进度 -->\n<div class=\"toast-wrap\" id=\"toastWrap\"></div>\n\n<!-- 拖放遮罩 -->\n<div class=\"dropzone\" id=\"dropzone\">\n  <div class=\"dropzone-inner\">\n    <svg viewBox=\"0 0 24 24\" width=\"34\" height=\"34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 16V4\"/><path d=\"m7 9 5-5 5 5\"/><path d=\"M5 20h14\"/></svg>\n    <strong>松手开始安装</strong>\n    <span>支持单个或多个 .apk 文件</span>\n  </div>\n</div>\n\n<!-- 右键菜单 -->\n<div class=\"ctxmenu\" id=\"ctxmenu\"></div>\n\n<!-- 设置 -->\n<div class=\"modal-mask\" id=\"settingsMask\">\n  <div class=\"modal\">\n    <header class=\"modal-head\">\n      <h2>设置</h2>\n      <div class=\"set-search-wrap\">\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n        <input id=\"setSearch\" class=\"set-search\" type=\"search\" autocomplete=\"off\" placeholder=\"搜索设置项：横屏 / 内存 / 代理 / 快照…\" />\n        <button class=\"set-search-clear\" id=\"btnClearSearch\" type=\"button\" hidden aria-label=\"清除搜索\">×</button>\n      </div>\n      <button class=\"icon-btn\" id=\"btnCloseSettings\">\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n      </button>\n    </header>\n    <div class=\"modal-main\">\n      <nav class=\"set-nav\" id=\"setNav\" aria-label=\"设置分类\">\n        <button class=\"set-nav-item on\" type=\"button\" data-cat=\"basic\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 7h16M4 12h16M4 17h10\"/></svg></span>\n          <span class=\"set-nav-label\">常用与安装</span>\n          <span class=\"set-nav-badge\" data-badge=\"basic\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"display\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M9 20h6M12 17v3\"/></svg></span>\n          <span class=\"set-nav-label\">显示与窗口</span>\n          <span class=\"set-nav-badge\" data-badge=\"display\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"input\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 10v4M17 10v4\"/></svg></span>\n          <span class=\"set-nav-label\">操作与输入</span>\n          <span class=\"set-nav-badge\" data-badge=\"input\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"perf\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M13 3 5 14h6l-1 7 8-11h-6z\"/></svg></span>\n          <span class=\"set-nav-label\">性能与资源</span>\n          <span class=\"set-nav-badge\" data-badge=\"perf\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"net\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M5 12a7 7 0 0 1 14 0M8.5 12a3.5 3.5 0 0 1 7 0\"/><circle cx=\"12\" cy=\"16\" r=\"1.6\"/></svg></span>\n          <span class=\"set-nav-label\">网络与下载</span>\n          <span class=\"set-nav-badge\" data-badge=\"net\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"diag\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3 3 8v5c0 5 3.8 7.6 9 9 5.2-1.4 9-4 9-9V8z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span>\n          <span class=\"set-nav-label\">诊断与修复</span>\n          <span class=\"set-nav-badge\" data-badge=\"diag\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"files\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg></span>\n          <span class=\"set-nav-label\">集成与文件</span>\n          <span class=\"set-nav-badge\" data-badge=\"files\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"about\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\"/></svg></span>\n          <span class=\"set-nav-label\">更新与关于</span>\n          <span class=\"set-nav-badge\" data-badge=\"about\" hidden></span>\n        </button>\n        <button class=\"set-nav-item\" type=\"button\" data-cat=\"lab\">\n          <span class=\"set-nav-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M9 3h6M10 3v7L5 20a1 1 0 0 0 .9 1.5h12.2A1 1 0 0 0 19 20l-5-10V3\"/><path d=\"M7.5 15h9\"/></svg></span>\n          <span class=\"set-nav-label\">实验室</span>\n          <span class=\"set-nav-badge\" data-badge=\"lab\" hidden></span>\n        </button>\n      </nav>\n    <div class=\"modal-body\" id=\"settingsBody\">\n      <div class=\"group\" id=\"runtimeGroup\" data-cat=\"basic\">\n        <div class=\"group-title\">运行时与环境</div>\n        <div class=\"field\">\n          <label>运行状态</label>\n          <div class=\"row\" style=\"align-items:center;\">\n            <span class=\"inline-note\" id=\"setupStateText\">正在检查…</span>\n            <span style=\"flex:1\"></span>\n            <button class=\"btn primary sm\" id=\"btnDeployAll\">一键完成</button>\n            <button class=\"btn ghost sm\" id=\"btnSetupAdvanced\">高级：连接已有运行时</button>\n          </div>\n          <span class=\"sub\" id=\"setupNote\">全自动：无需选择镜像、无需启用加速、无需调内存</span>\n        </div>\n        <div class=\"field\">\n          <div class=\"steps\" id=\"setupSteps\"></div>\n        </div>\n        <div id=\"envCheck\" class=\"env-check\" hidden></div>\n\n        <div class=\"setup-guide\" id=\"setupGuide\" hidden>\n          <h2>安装 Android 到虚拟磁盘</h2>\n          <p class=\"guide-sub\">虚拟机窗口已打开。按下面 6 步操作一次，之后 ApkStart 会直接从磁盘启动，不再需要镜像。</p>\n          <ol class=\"guide-list\">\n            <li><b>启动菜单</b>：用 <kbd>↓</kbd> 选到 <code>Installation - Install Android-x86 to harddisk</code>，回车</li>\n            <li><b>Choose Partition</b>：选 <code>Create/Modify partitions</code>；询问是否使用 GPT 时选 <code>No</code></li>\n            <li><b>cfdisk 分区</b>：<code>New</code> → <code>Primary</code> → 容量直接回车 → <code>Bootable</code> → <code>Write</code> → 输入 <code>yes</code> → <code>Quit</code></li>\n            <li><b>格式化</b>：选 <code>vda1</code> → 提示格式化时选 <code>ext4</code> → <code>Yes</code></li>\n            <li><b>引导与系统</b>：<code>Install GRUB</code> 选 <code>Yes</code>；<code>Install /system as read-write</code> 选 <code>Yes</code></li>\n            <li><b>完成</b>：进度到 100% 后点下面的「我已安装完成」（ApkStart 会自动重启并接管）</li>\n          </ol>\n          <p class=\"guide-tip\">如果之后提示 adb 未连接：在虚拟机窗口按 <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>F1</kbd> 进入终端，执行\n            <code>setprop service.adb.tcp.port 5555</code>、<code>stop adbd</code>、<code>start adbd</code>，\n            再按 <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>F7</kbd> 回到图形界面。</p>\n          <div class=\"guide-foot\">\n            <button class=\"btn primary\" id=\"btnMarkInstalled\">我已安装完成</button>\n            <button class=\"btn ghost\" id=\"btnGuideClose\">稍后再说</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"basic\">\n        <div class=\"group-title\">自动模式（默认，无需设置）</div>\n        <div class=\"field\">\n          <label>本机自适应参数</label>\n          <div class=\"inline-note\" id=\"autoProfileText\">正在检测…</div>\n          <span class=\"sub\">内存、核心数、渲染后端、端口、加速方式全部自动选择；启动失败会自动降级重试，不需要手动改。\n            ApkStart 用<b>专用 adb 服务端口 5044</b>（你系统里自己的 adb 是 5037），所以命令行里\n            <code>adb devices</code> 看不到这台安卓设备 —— 这是刻意的隔离。想连的话用\n            <code>$env:ANDROID_ADB_SERVER_PORT=5044</code> 再执行 adb。\n            注意：别对着 5555 端口手动 <code>adb connect</code>，那会在正在运行的应用上弹出\n            「允许 USB 调试吗」的系统弹窗。</span>\n        </div>\n        <div class=\"field\">\n          <label>磁盘总占用（运行时 + 安卓数据 + 缓存）</label>\n          <div class=\"row\">\n            <span class=\"inline-note\" id=\"usageText\">正在统计…</span>\n            <button class=\"btn ghost sm\" id=\"btnCleanup\">清理可回收文件</button>\n            <button class=\"btn ghost sm\" id=\"btnLeftovers\" title=\"扫描并清掉旧版本留下的程序目录、失效的卸载项和更新临时文件\">清理旧版本残留</button>\n            <button class=\"btn ghost sm\" id=\"btnRepairNetwork\" title=\"安卓虚拟机没有网络时（应用里联网页面一直黑屏/转圈），用这个把安卓数据重置掉来修网络。应用清单会保留，点开应用会自动重装\">修复网络</button>\n            <button class=\"btn ghost sm danger\" id=\"btnResetData\" title=\"清空安卓 /data 用户数据 + 已装应用 + 快速启动快照，还原成刚装好系统的干净状态\">重置安卓数据</button>\n          </div>\n          <label class=\"checkbox-inline\">\n            <input type=\"checkbox\" id=\"chkCleanSnapshots\" />\n            <span>连当前 AVD 的快速启动快照也一起清（会先停运行时，能真正回收几 GB 快照）</span>\n          </label>\n          <span class=\"sub\">系统镜像全机共享一份，应用数据用差分层保存；旧镜像、旧快照、日志和锁文件都可回收。日志超过上限会自动滚动，不会无限增长。「重置安卓数据」会真实删除数 GB 用户数据，仅保留系统本身。</span>\n        </div>\n        <div class=\"runtime-actions\">\n          <button class=\"btn ghost sm\" id=\"btnDiagnostics\">导出诊断报告</button>\n          <button class=\"btn ghost sm\" id=\"btnRebuildShortcuts\">重建快捷方式</button>\n          <span class=\"inline-note\">诊断报告用于排障；重建会补齐桌面 + 开始菜单入口</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>开机自动启动（默认开启）</label>\n            <span class=\"sub\">随 Windows 登录常驻托盘，双击桌面图标秒开应用，无需手动启动。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAutoStart\" class=\"switch\" />\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"display\">\n        <div class=\"group-title\">应用窗口</div>\n        <div class=\"field\">\n          <label>显示模式</label>\n          <select id=\"setDisplayMode\">\n            <option value=\"window\">竖屏窗口（可自由拉伸，记住每个应用的大小）</option>\n            <option value=\"fullscreen\">全屏（铺满屏幕，保持手机比例两侧留黑）</option>\n          </select>\n          <span class=\"sub\">随时按 <b>F11</b> 或右键托盘切换；全屏只放大窗口，不改变画面比例，切换不重启应用。</span>\n        </div>\n        <div class=\"field\">\n          <label>自动全屏</label>\n          <select id=\"setAutoFullscreen\">\n            <option value=\"off\">关闭（按上面选的显示模式走）</option>\n            <option value=\"on\">打开 · 每次启动应用都自动全屏</option>\n          </select>\n          <span class=\"sub\">打开后，每次点开应用直接铺满屏幕，不用再按 F11。配合下面的「横屏」使用效果最好\n            —— 横屏面板的宽高比本来就贴合屏幕，全屏不会留黑边。</span>\n        </div>\n        <div class=\"field\">\n          <label>屏幕方向</label>\n          <select id=\"setOrientationMode\">\n            <option value=\"auto\">跟随应用（推荐 · 自动选横竖屏，画面铺满不留黑边）</option>\n            <option value=\"portrait\">强制竖屏（手机比例，适合刷短视频、看小说）</option>\n            <option value=\"landscape\">强制横屏（宽屏铺满，适合看剧、玩游戏）</option>\n          </select>\n          <span class=\"sub\">安卓的横竖屏是<b>虚拟手机面板的真实方向</b>决定的。面板方向和应用自己声明的方向不一致时，\n            安卓只会给应用中间一条窄画面、两侧补黑 —— 换窗口大小、改分辨率都填不满。\n            「跟随应用」会在安装 APK 时读出应用的方向，启动时自动把面板换成一致的那个，\n            所以红果、墨读这类应用会正立且铺满。方向不对时才重启一次运行时（约十几秒），\n            之后再打开同一方向的应用都是秒进。</span>\n        </div>\n        <div class=\"field\">\n          <label>镜像自动旋转</label>\n          <select id=\"setAutoRotate\">\n            <option value=\"on\">打开（默认）· 系统设置里显示自动旋转已开启</option>\n            <option value=\"off\">关闭 · 回到旧的锁定行为</option>\n          </select>\n          <span class=\"sub\">安卓里<b>自动旋转开关默认打开</b>。注意这不影响画面方向：面板方向和屏幕方向仍由上面的\n            策略 + 忽略应用方向请求决定，不会被传感器带歪。只有个别应用读取这个开关值时才会用到。</span>\n        </div>\n        <div class=\"field\">\n          <label>平板排版</label>\n          <select id=\"setTabletMode\">\n            <option value=\"on\">打开（推荐 · 逻辑密度 190dpi，sw606dp 走平板排版）</option>\n            <option value=\"off\">关闭（镜像默认密度，手机排版）</option>\n          </select>\n          <span class=\"sub\">720 宽按 190dpi 算等于 606dp，正好越过 Android 的 600dp 平板断点，\n            红果短剧的双列剧集页、设置页的分栏都只在这个排版下出现。关掉会回到手机排版\n            （字更大、信息更少）。切换后下次打开应用生效。</span>\n        </div>\n        <div class=\"field\">\n          <label>当前面板方向</label>\n          <select id=\"setLandscape\">\n            <option value=\"portrait\">竖屏面板</option>\n            <option value=\"landscape\">横屏面板</option>\n          </select>\n          <span class=\"sub\">这是运行时<b>现在</b>用的物理面板方向，由上面那条策略自动写入。\n            只有在「强制」模式下它才完全由你决定。</span>\n        </div>\n        <div class=\"field\">\n          <label>窗口承载方式</label>\n          <select id=\"setWindowEmbed\">\n            <option value=\"detached\">原生窗口（默认·推荐）· 模拟器自己开窗口，帧率与缩放最稳</option>\n            <option value=\"embed\">嵌入模式 · 安卓画面嵌在 ApkStart 窗口里，标题栏带旋转按钮</option>\n          </select>\n          <span class=\"sub\">原生窗口由模拟器直接渲染和排布，拖拽、缩放、旋转都跟手，不会出现黑边或点击错位，\n            代价是多一个任务栏图标（横屏用托盘菜单或 Ctrl+Alt+R）。嵌入模式会把模拟器窗口塞进我们的窗口，\n            观感更统一、自带旋转按钮，但在缩放/旋转/切换应用时容易掉帧并出现黑边。改动在下次打开应用时生效。</span>\n        </div>\n        <div class=\"field\" id=\"portraitField\">\n          <label>竖屏画面大小</label>\n          <select id=\"setPortrait\">\n            <option value=\"720x1280\">小 · 720 × 1280</option>\n            <option value=\"900x1600\">中 · 900 × 1600</option>\n            <option value=\"1080x1920\">大 · 1080 × 1920</option>\n            <option value=\"1440x2560\">超大 · 1440 × 2560</option>\n          </select>\n          <span class=\"sub\">窗口模式下可拖动边框任意缩放；这里调的是 Android 内部渲染尺寸，越小越省性能。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"input\">\n        <div class=\"group-title\">鼠标键位</div>\n        <div class=\"field\">\n          <label>左键 · 确认 / 点击</label>\n          <span class=\"sub\">模拟器原生把左键当成手指点击，按住拖动就是滑动，无需额外设置。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>右键 · 安卓返回</label>\n            <span class=\"sub\">模拟器默认把右键也当成一次点击（容易误触）。开启后右键只执行返回，不再触发点击。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setMouseRightBack\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label>滚轮 · 滑动</label>\n          <select id=\"setMouseWheelMode\">\n            <option value=\"smooth\">平滑（推荐）· 合并多次滚动为一次流畅滑动</option>\n            <option value=\"native\">原生 · 交给模拟器逐格处理</option>\n            <option value=\"off\">关闭 · 不拦截滚轮</option>\n          </select>\n          <span class=\"sub\">平滑模式把一小段时间内的滚动合并成一次滑动手势，避免逐格抽搐，也不会每格都拉起一个 adb 进程。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>鼠标侧键 · 返回 / 前进（默认关闭）</label>\n            <span class=\"sub\">侧键映射需要全局鼠标钩子。钩子只在 ApkStart 应用窗口处于前台时安装，失焦或关闭立即卸载，不会拖慢桌面。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setMouseSideButtons\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\">以上映射只在应用窗口前台生效；切回桌面或关闭窗口后，鼠标行为完全恢复 Windows 原生。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"input\">\n        <div class=\"group-title\">键盘映射（游戏手柄）</div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>启用键盘映射</label>\n            <span class=\"sub\">把键盘按键映射成安卓触屏点击/滑动。适合用键盘玩手游（WASD 移动、J/K 技能等）。\n              每个应用可以单独配置，右键应用卡片 → 「按键映射」选择预设模板或自定义。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setKeymapEnabled\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\" id=\"keymapHint\">当前应用未配置按键映射。右键应用卡片可快速套用预设模板。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"perfGroup\" data-cat=\"perf\">\n        <div class=\"group-title\">性能与资源占用</div>\n        <div class=\"field\">\n          <label>资源策略</label>\n          <select id=\"setResourceMode\">\n            <option value=\"save\">省资源 · 2 核 / 让出前台 / 540p（老机器、挂机）</option>\n            <option value=\"balanced\">均衡 · 一半物理核 / 让出前台 / 720p（推荐）</option>\n            <option value=\"smooth\">流畅 · 不限核数 / 与前台同优先级（视频、游戏）</option>\n          </select>\n          <span class=\"sub\">决定安卓虚拟机吃多少 CPU、画面多细腻。红果/抖音发卡就切「流畅」，只想挂着跑小应用就切「省资源」。改完下一次打开应用生效。</span>\n        </div>\n        <div class=\"field two\">\n          <div>\n            <label>画质（安卓内部渲染分辨率）</label>\n            <select id=\"setRenderSize\">\n              <option value=\"auto\">自动（按加速状态）</option>\n              <option value=\"540x960\">流畅 · 540 × 960</option>\n              <option value=\"720x1280\">均衡 · 720 × 1280</option>\n              <option value=\"1080x1920\">高清 · 1080 × 1920</option>\n            </select>\n          </div>\n          <div>\n            <label>安卓数据分区（应用与游戏装这里）</label>\n            <select id=\"setDataGB\">\n              <option value=\"0\">自动</option>\n              <option value=\"4\">4 GB</option>\n              <option value=\"6\">6 GB</option>\n              <option value=\"8\">8 GB</option>\n              <option value=\"12\">12 GB</option>\n              <option value=\"16\">16 GB</option>\n              <option value=\"24\">24 GB</option>\n              <option value=\"32\">32 GB</option>\n              <option value=\"48\">48 GB</option>\n              <option value=\"64\">64 GB（50GB 级游戏）</option>\n              <option value=\"96\">96 GB</option>\n              <option value=\"128\">128 GB</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"field\">\n          <div class=\"row\">\n            <button class=\"btn ghost sm\" id=\"btnGrowData\">立即扩容</button>\n            <span class=\"sub\" style=\"flex:1;margin:0\">扩容是就地做的：已装应用与存档都保留，只是下次打开应用会多花十几秒。</span>\n          </div>\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\" id=\"dataNote\">正在读取数据分区…</span>\n        </div>\n        <div class=\"field\">\n          <label>系统语言</label>\n          <select id=\"setLocale\">\n            <option value=\"zh-CN\">简体中文（推荐）</option>\n            <option value=\"zh-TW\">繁體中文</option>\n            <option value=\"en-US\">English（镜像原生）</option>\n            <option value=\"ja-JP\">日本語</option>\n            <option value=\"ko-KR\">한국어</option>\n          </select>\n          <span class=\"sub\">系统设置、权限弹窗、日期格式的语言。开机时注入到虚拟机，\n            <b>下次重启运行时生效</b>。中文输入法不受此项影响，单独在下面开关。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>中文输入法（推荐）</label>\n            <span class=\"sub\">镜像只带英文键盘，勾上会静默安装并启用随包的谷歌拼音输入法，\n              这样在安卓应用里能直接打中文。关掉则保持系统原生输入法。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setChineseIme\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label for=\"setDnsPreset\">DNS 服务器</label>\n          <select id=\"setDnsPreset\">\n            <option value=\"cn\">国内公共 DNS（阿里 / 腾讯，推荐）</option>\n            <option value=\"cloudflare\">Cloudflare（1.1.1.1）</option>\n            <option value=\"google\">Google（8.8.8.8）</option>\n            <option value=\"off\">关闭 · 沿用主机 DNS</option>\n          </select>\n          <span class=\"sub\">安卓默认通过 10.0.2.3 走主机 DNS，VPN、公司网或某些运营商下解析可能拖到几百毫秒，视频类应用首屏发慢。内网域名必须走主机 DNS 时选「关闭」。下次启动安卓运行时生效。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>安卓声音</label>\n            <span class=\"sub\">让应用提示音、视频声音正常播放。仅在你完全不需要声音、想再省一点 CPU 时关闭。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAudio\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>保留快速启动快照（推荐）</label>\n            <span class=\"sub\">第二次打开应用只要几秒，代价是磁盘上多一份约 2–3 GB 的 <code>ram.bin</code>。磁盘紧张可以关掉：只影响启动速度，不影响应用与存档。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setKeepSnapshot\" class=\"switch\" />\n        </div>\n        <details class=\"mini-details\">\n          <summary>容器细节（高级）</summary>\n          <div class=\"field switch-field\">\n            <div>\n              <label>轻量容器</label>\n              <span class=\"sub\">收敛 vCPU 配额并降低进程优先级，CPU 优先让给 Windows 桌面。上面的「资源策略」已经会自动设置这一项。</span>\n            </div>\n            <input type=\"checkbox\" id=\"setLiteMode\" class=\"switch\" />\n          </div>\n          <div class=\"field\">\n            <label>虚拟机优先级</label>\n            <select id=\"setPriorityMode\">\n              <option value=\"balanced\">均衡（推荐）· 运行时让着前台窗口</option>\n              <option value=\"performance\">性能优先 · 运行时与前台同等优先级</option>\n              <option value=\"game\">游戏 / 低延迟 · 运行时高优先级，适合 FPS、音游</option>\n            </select>\n            <span class=\"sub\">游戏模式会让安卓虚拟机保持较高 CPU 优先级并减少宿主侧轮询，输入与画面延迟最低；代价是整机其他程序会变慢。没有应用窗口时容器仍会自动降优先级停放。</span>\n          </div>\n        </details>\n        <div class=\"field switch-field\">\n          <div>\n            <label>深度裁剪系统后台</label>\n            <span class=\"sub\">额外禁用 Play 商店、设置向导、打印服务等后台包，只留打开应用必需的环境。若遇到应用提示缺少 Google Play 服务，关掉此开关会自动恢复。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setDeepTrim\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>开机预热（推荐）</label>\n            <span class=\"sub\">启动 ApkStart 后就在后台把安卓环境引导好（窗口全程隐藏，不会看到模拟器）。之后点任何应用只剩一次「打开」，实测从 20 多秒降到几乎不用等。代价是空闲时常驻约 1GB 内存，关掉后第一次打开应用需要冷启动。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setPrewarm\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\">安卓环境只开机一次并常驻；之后打开应用不再重跑整个系统，只启动该应用并停掉其他应用进程。关掉最后一个窗口会清后台、停放容器，下次点开仍是秒进。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"downloadGroup\" data-cat=\"net\">\n        <div class=\"group-title\">下载与更新源</div>\n        <div class=\"field\">\n          <label>更新与下载源</label>\n          <select id=\"setSourcePref\">\n            <option value=\"auto\">自动选择较快的源（推荐）</option>\n            <option value=\"gitee\">只用 Gitee（国内通常最快）</option>\n            <option value=\"github\">只用 GitHub</option>\n          </select>\n          <span class=\"sub\">「自动」会同时问 GitHub 与 Gitee 的最新版本，把每个下载地址都真下 256KB 测一次速度，再从最快的那个地址下载；其中一个源不通不影响更新。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>自动尝试公共加速镜像</label>\n            <span class=\"sub\">GitHub 直连太慢时，额外测速 ghfast.top / gh-proxy.com 这两个公开转发服务（只转发公开的发布文件，不涉及账号）。关掉后只用直连和你自己填的前缀。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAutoMirror\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label>下载镜像前缀（可选，加速 GitHub）</label>\n          <input id=\"setMirrorPrefix\" type=\"text\" placeholder=\"例如 https://ghfast.top/\" />\n          <span class=\"sub\">填了就只用你填的前缀，不再尝试上面那两个公共镜像；留空则由「自动」逻辑决定。下载器会把它拼在真实地址前面。</span>\n        </div>\n        <div class=\"field\">\n          <label>下载线程数（1–16，默认 8）</label>\n          <input id=\"setConnections\" type=\"number\" min=\"1\" max=\"16\" step=\"1\" />\n          <span class=\"sub\">大文件按块并行下载。默认 8 线程已经能跑满大多数家宽；网络稳定时可以试 16。</span>\n        </div>\n        <details class=\"mini-details\">\n          <summary>Gitee 更新源（可选）</summary>\n          <div class=\"field\">\n            <label>Gitee 只读 token（一般不用填）</label>\n            <input id=\"setGiteeToken\" type=\"password\" placeholder=\"留空即可：公开仓库匿名也能读\" />\n            <span class=\"sub\">本项目仓库已公开，Gitee 的发行版列表匿名就能读，留空也能用 Gitee 源。\n              只有在「Gitee 被限流（返回 403/429）」或你想读私有分支时才需要填：\n              gitee.com → 设置 → 私人令牌，只勾「projects」即可，它只用于读取发行版列表，\n              不会上传任何东西。</span>\n          </div>\n        </details>\n      </div>\n\n      <div class=\"group\" id=\"preflightGroup\" data-cat=\"diag\">\n        <div class=\"group-title\">本机体检 · 自动配置</div>\n        <div class=\"field\">\n          <span class=\"sub\">先查一遍这台机器：CPU 虚拟化有没有开、Windows 的虚拟机监控程序平台在不在、\n            显卡是什么、显存多大、内存和系统版本够不够。能自动改的（内存 / 核心 / 画质 / 渲染后端）直接写进设置，\n            并把结果固化成一份驱动；必须管理员权限的给按钮；只能在 BIOS 里改的会告诉你怎么改。</span>\n        </div>\n        <div class=\"field\">\n          <div class=\"row\">\n            <button class=\"btn primary sm\" id=\"btnPreflight\">开始体检</button>\n            <button class=\"btn ghost sm\" id=\"btnPreflightApply\" hidden>应用推荐配置</button>\n          </div>\n        </div>\n        <div id=\"preflightList\" class=\"drv-list\"></div>\n        <div class=\"field\">\n          <span class=\"sub\" id=\"preflightSummary\"></span>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"driverGroup\" data-cat=\"diag\">\n        <div class=\"group-title\">驱动 · 兼容补丁</div>\n        <div class=\"field\">\n          <span class=\"sub\">有些机器要改启动参数才跑得起来（老显卡 GLES 版本低、没开硬件加速、某版驱动一开硬件渲染就崩）。\n            驱动就是一份 JSON：声明「匹配哪些机器」+「命中后改哪些启动参数」。你可以自己写、导入、分享。\n            驱动只改白名单里的启动项，<b>不执行任何代码</b>；匹配不上就不生效。</span>\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\" id=\"drvSummary\">正在读取驱动…</span>\n        </div>\n        <div id=\"drvList\" class=\"drv-list\"></div>\n        <div class=\"field\">\n          <div class=\"row\">\n            <button class=\"btn ghost sm\" id=\"btnDrvReload\">刷新</button>\n            <button class=\"btn ghost sm\" id=\"btnDrvImport\">导入驱动…</button>\n            <button class=\"btn ghost sm\" id=\"btnDrvFolder\">打开驱动目录</button>\n            <button class=\"btn ghost sm\" id=\"btnDrvExport\">导出本机模板</button>\n          </div>\n          <span class=\"sub\">「导出本机模板」会把匹配条件按这台机器填好，改 <code>effect</code> 里的\n            <code>gpuMode</code> / <code>forceTcg</code> 就能用。字段说明见仓库里的 <code>docs/drivers.md</code>。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"autodebugGroup\" data-cat=\"diag\">\n        <div class=\"group-title\">自动检测 · 智能诊断</div>\n        <div class=\"field\">\n          <span class=\"sub\">后台定时把这台机器查一遍：安卓运行时有没有起来、adb 授权是否正常、磁盘还剩多少、\n            数据分区是不是被差量盘挡住、快照有没有坏、设置之间有没有互相打架。\n            只在发现<b>新</b>的严重问题时弹一次通知，其余都安静地列在下面。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>启用自动检测（默认开启）</label>\n            <span class=\"sub\">关掉后不再定时扫描；随时可以点「立即检测」手动跑一次。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAutodebugAuto\" class=\"switch\" />\n        </div>\n        <div class=\"field two\">\n          <div>\n            <label>检测间隔</label>\n            <select id=\"setAutodebugInterval\">\n              <option value=\"1\">每 1 分钟</option>\n              <option value=\"5\">每 5 分钟</option>\n              <option value=\"10\">每 10 分钟（推荐）</option>\n              <option value=\"30\">每 30 分钟</option>\n              <option value=\"60\">每 1 小时</option>\n            </select>\n          </div>\n          <div class=\"switch-field\" style=\"align-items:center\">\n            <div>\n              <label>发现新问题时通知我</label>\n              <span class=\"sub\">只对严重问题弹通知；已知的老问题不重复打扰。</span>\n            </div>\n            <input type=\"checkbox\" id=\"setAutodebugNotify\" class=\"switch\" />\n          </div>\n        </div>\n        <div class=\"runtime-actions\">\n          <button class=\"btn primary sm\" id=\"btnAutodebugRun\">立即检测</button>\n          <button class=\"btn ghost sm\" id=\"btnAutodebugReport\">导出诊断报告</button>\n          <span class=\"inline-note\" id=\"autodebugStateText\">尚未检测</span>\n        </div>\n        <div id=\"autodebugList\" class=\"dbg-list\"></div>\n      </div>\n\n      <details class=\"advanced-group\" data-cat=\"perf\">\n        <summary>高级参数（一般无需修改）</summary>\n      <div class=\"group\" data-cat=\"perf\">\n        <div class=\"group-title\">运行时</div>\n        <div class=\"field\">\n          <label>运行时</label>\n          <div class=\"row\">\n            <input id=\"setEngineLabel\" type=\"text\" readonly value=\"ApkStart 自带运行时（QEMU + Android 14，独立运行）\" />\n          </div>\n          <span class=\"sub\">ApkStart 只跑自己的运行时：adb / emulator / 系统镜像都由它自己下载和管理，\n            不探测、不接管、不依赖你电脑上装的任何模拟器（MuMu / 雷电 / 蓝叠 / WSA 都不会被使用）。\n            这样换机器、别人装没装模拟器、模拟器怎么升级，都不影响这里。</span>\n        </div>\n        <div class=\"field\">\n          <label>adb 路径</label>\n          <input id=\"setAdbPath\" type=\"text\" placeholder=\"留空则自动在 PATH / Android SDK 中查找\" />\n        </div>\n        <div class=\"field\">\n          <label>设备地址</label>\n          <span class=\"sub\" id=\"deviceAddrNote\">由 ApkStart 自己分配（emulator-5554，端口冲突时自动顺延），无需填写。</span>\n        </div>\n        <div class=\"field\">\n          <label>系统镜像（ISO）</label>\n          <input id=\"setSystemImage\" type=\"text\" placeholder=\"Android-x86 / Bliss OS 的 ISO 或 IMG 路径，留空使用默认位置\" />\n        </div>\n        <div class=\"field two\">\n          <div>\n            <label>内存 (MB，0 = 自动)</label>\n            <input id=\"setMemory\" type=\"number\" min=\"0\" step=\"512\" />\n          </div>\n          <div>\n            <label>CPU 核心（0 = 自动）</label>\n            <input id=\"setCores\" type=\"number\" min=\"0\" max=\"16\" />\n          </div>\n        </div>\n        <div class=\"field\">\n          <span class=\"sub\" id=\"builtinResNote\"></span>\n        </div>\n        <div class=\"field\">\n          <label>空闲回收（分钟，0 = 不回收）</label>\n          <input id=\"setIdle\" type=\"number\" min=\"0\" step=\"1\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>通用兼容镜像（自动管理）</label>\n            <span class=\"sub\">现在只有一个 Android 14 通用镜像，x86 与 ARM 应用都能跑，首次遇到 ARM 应用时会自动下载，不需要手动切换。此开关仅用于旧配置兼容。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setCompat\" class=\"switch\" />\n        </div>\n        <div class=\"field\" id=\"compatInstallField\" hidden>\n          <label>兼容镜像</label>\n          <div class=\"row\">\n            <span class=\"inline-note\" id=\"compatImgStatus\">未下载</span>\n            <button class=\"btn ghost sm\" id=\"btnInstallPlay\">下载兼容镜像</button>\n          </div>\n        </div>\n        <div class=\"runtime-actions\">\n          <button class=\"btn ghost sm\" id=\"btnRuntimeStart\">启动运行时</button>\n          <button class=\"btn ghost sm\" id=\"btnRuntimeStop\">停止内置虚拟机</button>\n          <span class=\"inline-note\" id=\"probeResult\"></span>\n        </div>\n      </div>\n      </details>\n\n      <div class=\"group\" data-cat=\"display\">\n        <div class=\"group-title\">安卓系统设置（不用进安卓桌面）</div>\n        <div class=\"field\">\n          <label>运行状态</label>\n          <div class=\"row\">\n            <span class=\"inline-note\" id=\"androidStatus\">运行时未启动</span>\n            <button class=\"btn ghost sm\" id=\"btnAndroidRefresh\">刷新</button>\n            <button class=\"btn ghost sm\" id=\"btnAndroidTune\">一键流畅优化</button>\n          </div>\n          <span class=\"sub\">关闭系统动画、放开后台进程上限并把当前应用加入电池白名单，低配电脑体感最明显。</span>\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>Wi-Fi</label>\n            <span class=\"sub\">安卓虚拟机内部的无线网，关掉可省一点 CPU。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAndroidWifi\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>飞行模式</label>\n            <span class=\"sub\">彻底断网（含移动数据），需要安静时打开。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAndroidAirplane\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>系统动画</label>\n            <span class=\"sub\">关掉后界面切换明显更快，功能不受影响。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAndroidAnim\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>安卓软键盘</label>\n            <span class=\"sub\">默认关闭：直接用电脑键盘输入。需要屏幕键盘时再打开。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAndroidSoftKeyboard\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label>媒体音量</label>\n          <div class=\"row\">\n            <input type=\"range\" id=\"setAndroidVolume\" min=\"0\" max=\"100\" step=\"1\" style=\"flex:1\" />\n            <span class=\"inline-note\" id=\"androidVolumeText\">—</span>\n          </div>\n        </div>\n        <div class=\"field two\">\n          <div>\n            <label>字体大小</label>\n            <select id=\"setAndroidFont\">\n              <option value=\"0.85\">小</option>\n              <option value=\"1.00\">标准</option>\n              <option value=\"1.15\">大</option>\n              <option value=\"1.30\">特大</option>\n            </select>\n          </div>\n          <div>\n            <label>显示大小</label>\n            <select id=\"setAndroidDensity\">\n              <option value=\"240\">紧凑（省性能）</option>\n              <option value=\"320\">标准</option>\n              <option value=\"420\">宽松</option>\n              <option value=\"480\">特大</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"runtime-actions\">\n          <button class=\"btn ghost sm\" id=\"btnAndroidSettings\">安卓原生设置</button>\n          <button class=\"btn ghost sm\" id=\"btnAndroidDisplay\">显示设置</button>\n          <button class=\"btn ghost sm\" id=\"btnAndroidSound\">声音设置</button>\n          <button class=\"btn ghost sm\" id=\"btnAndroidLocale\">语言设置</button>\n          <button class=\"btn ghost sm\" id=\"btnAndroidApps\">应用管理</button>\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"files\">\n        <div class=\"group-title\">桌面与应用</div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>安装后自动创建桌面快捷方式</label>\n            <span class=\"sub\">快捷方式带真实应用图标，双击直接进应用</span>\n          </div>\n          <input type=\"checkbox\" id=\"setAutoShortcut\" class=\"switch\" />\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>同时添加到开始菜单</label>\n            <span class=\"sub\">Windows 搜索能搜到应用名，任务栏也按应用分组</span>\n          </div>\n          <input type=\"checkbox\" id=\"setStartMenuShortcut\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label>快捷方式目录</label>\n          <input id=\"setShortcutDir\" type=\"text\" placeholder=\"留空 = 桌面\" />\n        </div>\n        <div class=\"runtime-actions\">\n          <button class=\"btn ghost sm\" id=\"btnRebuildShortcuts\">重建快捷方式</button>\n          <span class=\"inline-note\">桌面图标被误删或被安全软件拦掉时，点这里按当前设置全部补齐。</span>\n        </div>\n      </div>\n\n      <div class=\"group\" data-cat=\"files\">\n        <div class=\"group-title\">文件互通</div>\n        <div class=\"field\">\n          <label>本机共享目录</label>\n          <div class=\"row\">\n            <input id=\"setSharedDir\" type=\"text\" />\n            <button class=\"btn ghost sm\" id=\"btnBrowseShared\">浏览</button>\n            <button class=\"btn ghost sm\" id=\"btnOpenShared\">打开</button>\n            <button class=\"btn ghost sm\" id=\"btnSyncShared\">立即同步</button>\n            <button class=\"btn primary sm\" id=\"btnSaveShared\">保存并迁移</button>\n          </div>\n          <span class=\"sub\">修改后旧目录里已有的文件会自动搬到新目录；正在运行的文件互通不受影响。</span>\n        </div>\n        <div class=\"field\">\n          <label>安卓内对应目录</label>\n          <input id=\"setDeviceSharedDir\" type=\"text\" placeholder=\"/sdcard/ApkStartShared\" />\n        </div>\n        <p class=\"note\">两侧目录会持续双向同步；在安卓应用里保存到该目录的文件，会出现在本机共享目录中。</p>\n      </div>\n\n      <div class=\"group\" data-cat=\"files\">\n        <div class=\"group-title\">系统集成</div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>关联 .apk 文件</label>\n            <span class=\"sub\">双击 APK 直接安装到 ApkStart（仅写入当前用户，无需管理员）</span>\n          </div>\n          <button class=\"btn ghost sm\" id=\"btnAssoc\">检查中…</button>\n        </div>\n        <div class=\"field\">\n          <label>运行时数据目录（系统镜像 · 已装应用 · 快照）</label>\n          <div class=\"row\">\n            <input id=\"setRuntimeDir\" type=\"text\" readonly placeholder=\"默认：C 盘用户数据目录\" />\n            <button class=\"btn ghost sm\" id=\"btnBrowseRuntimeDir\">浏览</button>\n            <button class=\"btn ghost sm\" id=\"btnOpenData\">打开</button>\n          </div>\n          <span class=\"sub\">这里占用空间最大（数 GB）。改到非系统盘可大幅减轻 C 盘压力；修改后需重启软件，已存在的数据不会自动搬移（请手动复制后删除旧目录）。</span>\n        </div>\n        <div class=\"field\">\n          <label>安卓数据目录（应用、游戏与快速启动快照）</label>\n          <div class=\"row\">\n            <input id=\"setAvdDir\" type=\"text\" readonly placeholder=\"默认：运行时目录下的 avd 文件夹\" />\n            <button class=\"btn ghost sm\" id=\"btnBrowseAvdDir\">浏览</button>\n            <button class=\"btn ghost sm\" id=\"btnOpenAvdDir\">打开</button>\n          </div>\n          <span class=\"sub\">真正吃盘的是这一块：数据分区（默认 6 GB，可在上面对大）+ 快速启动快照（约 2–3 GB）。\n            磁盘紧张时把它指到另一个盘（如 D:），重启软件后生效；旧目录里的 <code>apkstart.avd</code> 可整体搬过去再删。</span>\n        </div>\n        <div class=\"field\">\n          <label>卸载 ApkStart</label>\n          <div class=\"row\">\n            <button class=\"btn ghost sm\" id=\"btnUninstall\">一键卸载</button>\n            <span class=\"inline-note\">卸载会取消 .apk 关联并移除程序；便携版请按提示手动删除目录。</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"group\" id=\"updateGroup\" data-cat=\"about\">\n        <div class=\"group-title\">软件更新</div>\n        <div class=\"field\">\n          <label>当前版本 <span class=\"inline-note\" id=\"updateCurrent\">—</span></label>\n          <div class=\"row\">\n            <span class=\"inline-note\" id=\"updateState\">尚未检查</span>\n            <span style=\"flex:1\"></span>\n            <button class=\"btn ghost sm\" id=\"btnCheckUpdate\">检查更新</button>\n            <button class=\"btn primary sm\" id=\"btnDoUpdate\" style=\"display:none\" hidden>立即更新</button>\n          </div>\n          <div class=\"update-bar\" id=\"updateBar\" hidden><i id=\"updateBarFill\"></i></div>\n          <span class=\"sub\" id=\"updateNote\">\n            从本分支的 GitHub Releases（meshackbahati/apkstart-linux）获取最新版本；更新只替换程序文件，\n            运行时、已装应用与快照都不受影响。\n          </span>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"aboutGroup\" data-cat=\"about\">\n        <div class=\"group-title\">关于</div>\n        <div class=\"about-box\">\n          <div class=\"about-brand\">\n            <img class=\"about-logo\" src=\"assets/logo.png\" alt=\"ApkStart Logo\" draggable=\"false\" />\n          </div>\n          <div class=\"about-qrs\">\n            <div class=\"about-qr\" style=\"width:auto\">\n              <span class=\"about-qr-tip\">Linux 分支由 meshackbahati 维护；原始项目由 RoutineMiku 创建。</span>\n              <span class=\"about-qr-tip\">本分支专注于 Linux 桌面、KVM、Waydroid 与 ATL 后端。</span>\n            </div>\n          </div>\n          <div class=\"about-info\">\n            <div class=\"about-name\">ApkStart <span class=\"about-ver\" id=\"aboutVer\"></span></div>\n            <p class=\"note\">Linux 桌面的安卓应用运行器：双击安装 APK，生成 .desktop 入口，每个应用独立窗口，推荐使用 Waydroid 后端（原生应用窗口），内置模拟器兜底，ATL 为实验性后端。</p>\n            <div class=\"about-links\">\n              <button class=\"btn ghost sm\" id=\"btnOpenManual\">打开使用手册（含故障解决方案）</button>\n              <a href=\"https://github.com/meshackbahati/apkstart-linux\" target=\"_blank\" rel=\"noopener\">GitHub · ApkStart Linux</a>\n              <a href=\"https://github.com/RoutineMiku/apkstart\" target=\"_blank\" rel=\"noopener\">上游 · RoutineMiku/apkstart</a>\n              <span class=\"powered\">ApkStart Linux · MIT</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"group\" id=\"labGroup\" data-cat=\"lab\">\n        <div class=\"group-title\">实验室</div>\n        <div class=\"lab-notice\">\n          这里的功能还在实验阶段，行为可能随版本变化。遇到问题可在「诊断与修复 → 导出诊断报告」反馈。\n        </div>\n        <div class=\"field switch-field\">\n          <div>\n            <label>Windows 原生多窗口 · 多开（实验性）</label>\n            <span class=\"sub\">开启后打开新应用不再强制关闭上一个：多个应用可同时驻留、随时快速切回（保留登录态，不必重新加载），切回体验接近多窗口。\n              受限于安卓运行时只有一个模拟器窗口，同一时刻仍只有一个应用画面在前台显示，并非真正的同时并排多窗口。\n              会明显增加内存占用；关闭则回到「一次只显示一个应用」的稳定模式。</span>\n          </div>\n          <input type=\"checkbox\" id=\"setMultiWindow\" class=\"switch\" />\n        </div>\n        <div class=\"field\">\n          <label for=\"setKeepBackground\">后台保留应用数</label>\n          <select id=\"setKeepBackground\">\n            <option value=\"0\">0 · 最省内存（只留当前应用）</option>\n            <option value=\"1\">1 · 平衡（推荐）</option>\n            <option value=\"2\">2 · 多开更稳</option>\n            <option value=\"3\">3 · 最多并存</option>\n          </select>\n          <span class=\"sub\">多开模式下，超过这个数量的后台应用会被挂起（保留数据、秒切回），释放内存。</span>\n        </div>\n      </div>\n    </div>\n    </div>\n    <footer class=\"modal-foot\">\n      <span class=\"inline-note\">设置修改后立即生效</span>\n      <button class=\"btn primary\" id=\"btnDoneSettings\">完成</button>\n    </footer>\n  </div>\n</div>\n\n<script src=\"stub.js\"></script>\n  <script src=\"i18n.js\"></script>\n  <script src=\"app.js\"></script>\n</body>\n</html>\n"},"headersSize":189,"bodySize":56108,"redirectURL":"","_transferSize":56297},"cache":{},"timings":{"dns":0.071,"connect":0.182,"ssl":29.544,"send":0,"wait":18.274,"receive":0.244},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4108.747,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.525Z","time":138.76,"request":{"method":"GET","url":"http://127.0.0.1:8765/style.css","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":378,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/css"},{"name":"Content-Length","value":"30514"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":30514,"mimeType":"text/css","compression":0,"text":":root {\n  --bg: #f7f8fa;\n  --panel: #ffffff;\n  --panel-2: #fbfcfd;\n  --line: #e6e8ec;\n  --line-strong: #d9dde3;\n  --text: #1b1f24;\n  --muted: #6b7480;\n  --faint: #97a0ac;\n  --brand: #16a34a;\n  --brand-dark: #12833c;\n  --brand-soft: #eaf7ef;\n  --danger: #dc2626;\n  --shadow-sm: 0 1px 2px rgba(16, 24, 40, .06);\n  --shadow-md: 0 8px 24px rgba(16, 24, 40, .10);\n  --shadow-lg: 0 20px 48px rgba(16, 24, 40, .16);\n  --r-sm: 8px;\n  --r-md: 12px;\n  --r-lg: 16px;\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n  background: var(--bg);\n  color: var(--text);\n  font-family: \"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", system-ui, sans-serif;\n  font-size: 13px;\n  -webkit-font-smoothing: antialiased;\n  user-select: none;\n}\n\nbody {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n}\n\n/* ---------------- 标题栏 ---------------- */\n\n.titlebar {\n  height: 44px;\n  flex: 0 0 44px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 12px 0 14px;\n  background: var(--bg);\n  border-bottom: 1px solid transparent;\n  -webkit-app-region: drag;\n  padding-right: 148px; /* 给系统窗口按钮留位 */\n}\n\n.brand { display: flex; align-items: center; gap: 8px; }\n.logo { display: flex; }\n.logo img {\n  width: 20px; height: 20px;\n  border-radius: 6px;\n  display: block;\n  -webkit-user-drag: none;\n}\n.brand-name { font-weight: 650; font-size: 13.5px; letter-spacing: .2px; }\n.brand-tag {\n  margin-left: 4px;\n  font-size: 11px;\n  color: var(--muted);\n  background: #eef1f4;\n  border-radius: 999px;\n  padding: 2px 8px;\n  line-height: 16px;\n}\n.brand-tag.ok { color: var(--brand-dark); background: var(--brand-soft); }\n/* 状态标签兼作入口：点它进设置里的运行时面板 */\n.brand-tag { cursor: pointer; user-select: none; }\n.brand-tag:hover { filter: brightness(.97); }\n\n.titlebar-spacer { flex: 1; }\n.titlebar-actions { display: flex; gap: 4px; -webkit-app-region: no-drag; }\n\n.icon-btn {\n  width: 30px; height: 30px;\n  display: grid; place-items: center;\n  border: none; border-radius: 8px;\n  background: transparent; color: var(--muted);\n  cursor: pointer;\n}\n.icon-btn:hover { background: #edf0f3; color: var(--text); }\n\n/* ---------------- 布局 ---------------- */\n\n.shell {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  padding: 0 18px 0 18px;\n}\n\n.toolbar {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 0 14px;\n}\n\n.search {\n  display: flex; align-items: center; gap: 8px;\n  height: 34px; padding: 0 11px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  width: 280px;\n  color: var(--faint);\n  transition: border-color .15s, box-shadow .15s;\n}\n.search:focus-within { border-color: #b9c6d4; box-shadow: 0 0 0 3px rgba(22,163,74,.08); }\n.search input {\n  border: none; outline: none; background: transparent;\n  width: 100%; font-size: 13px; color: var(--text);\n  font-family: inherit;\n}\n.search input::placeholder { color: var(--faint); }\n\n.toolbar-right { margin-left: auto; display: flex; gap: 8px; }\n\n.btn {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 34px; padding: 0 13px;\n  border-radius: 10px;\n  border: 1px solid var(--line);\n  background: var(--panel);\n  color: var(--text);\n  font-size: 13px; font-family: inherit; font-weight: 500;\n  cursor: pointer;\n  transition: background .15s, border-color .15s, transform .06s;\n}\n.btn:hover { background: #f4f6f8; }\n.btn:active { transform: translateY(.5px); }\n.btn.primary {\n  background: var(--brand);\n  border-color: var(--brand);\n  color: #fff;\n  box-shadow: 0 1px 2px rgba(22,163,74,.25);\n}\n.btn.primary:hover { background: var(--brand-dark); border-color: var(--brand-dark); }\n.btn.ghost { background: transparent; }\n.btn.ghost:hover { background: #eef1f4; }\n.btn.ghost.danger { color: var(--danger); border-color: var(--danger); }\n.btn.ghost.danger:hover { background: rgba(220,53,69,.08); }\n.btn.sm { height: 28px; padding: 0 10px; font-size: 12px; border-radius: 8px; }\n.btn.lg { height: 38px; padding: 0 18px; border-radius: 11px; }\n.btn:disabled { opacity: .55; cursor: default; }\n\n/* ---------------- 应用网格 ---------------- */\n\n.content {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding-bottom: 18px;\n}\n.content::-webkit-scrollbar { width: 10px; }\n.content::-webkit-scrollbar-thumb { background: #d8dde3; border-radius: 8px; border: 3px solid var(--bg); }\n.content::-webkit-scrollbar-thumb:hover { background: #c3cad3; }\n\n.grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));\n  gap: 10px;\n}\n\n.card {\n  position: relative;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: var(--r-lg);\n  padding: 14px 12px 12px;\n  display: flex; flex-direction: column; align-items: center;\n  cursor: pointer;\n  transition: border-color .15s, box-shadow .18s, transform .12s;\n  overflow: hidden;\n}\n.card:hover {\n  border-color: var(--line-strong);\n  box-shadow: var(--shadow-md);\n  transform: translateY(-1px);\n}\n.card:active { transform: translateY(0); }\n\n.card .icon {\n  width: 64px; height: 64px;\n  border-radius: 15px;\n  background: #f0f3f6;\n  display: grid; place-items: center;\n  overflow: hidden;\n  margin-bottom: 10px;\n  box-shadow: 0 1px 3px rgba(16,24,40,.10);\n}\n.card .icon img { width: 100%; height: 100%; object-fit: cover; }\n.card .icon .fallback {\n  width: 100%; height: 100%;\n  display: grid; place-items: center;\n  color: #fff; font-weight: 600; font-size: 24px;\n}\n\n.card .name {\n  font-size: 12.5px; font-weight: 550;\n  max-width: 100%;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  text-align: center;\n}\n.card .meta {\n  margin-top: 3px;\n  font-size: 11px; color: var(--faint);\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  max-width: 100%;\n}\n\n.card .badge-run {\n  position: absolute; top: 9px; right: 9px;\n  width: 7px; height: 7px; border-radius: 50%;\n  background: var(--brand);\n  box-shadow: 0 0 0 3px var(--brand-soft);\n}\n.card .pin {\n  position: absolute; top: 8px; left: 9px;\n  font-size: 11px; color: var(--faint);\n}\n\n.card .open-hint {\n  margin-top: 10px;\n  width: 100%;\n  height: 26px;\n  border-radius: 8px;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-size: 11.5px; font-weight: 600;\n  display: grid; place-items: center;\n  opacity: 0;\n  transform: translateY(3px);\n  transition: opacity .16s, transform .16s;\n}\n.card:hover .open-hint { opacity: 1; transform: none; }\n\n/* ---------------- 空状态 ---------------- */\n\n.empty {\n  height: 100%;\n  display: flex; flex-direction: column; align-items: center; justify-content: center;\n  text-align: center;\n  padding: 20px;\n}\n.empty.hidden, .grid.hidden { display: none; }\n.empty h2 { margin: 10px 0 8px; font-size: 17px; font-weight: 600; }\n.empty p { margin: 0; color: var(--muted); line-height: 1.75; font-size: 12.5px; }\n.empty .btn { margin-top: 18px; }\n.empty-art { opacity: .9; }\n.hint { margin-top: 14px !important; font-size: 11.5px !important; color: var(--faint) !important; }\n\n/* ---------------- 状态栏 ---------------- */\n\n.statusbar {\n  flex: 0 0 32px;\n  display: flex; align-items: center;\n  border-top: 1px solid var(--line);\n  font-size: 11.5px;\n  color: var(--muted);\n}\n.status-left { display: flex; align-items: center; gap: 7px; }\n.status-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }\n.status-item { white-space: nowrap; }\n.sep { width: 1px; height: 11px; background: var(--line-strong); }\n.dot { width: 7px; height: 7px; border-radius: 50%; background: #cbd2da; }\n.dot.ok { background: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }\n.dot.err { background: #e8833a; }\n.dot.warn {\n  background: #f0b429;\n  box-shadow: 0 0 0 3px rgba(240, 180, 41, .18);\n  animation: dotPulse 1.4s ease-in-out infinite;\n}\n@keyframes dotPulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: .45; }\n}\n\n\n/* ---------------- Toast ---------------- */\n\n.toast-wrap {\n  position: fixed;\n  right: 16px; bottom: 44px;\n  display: flex; flex-direction: column-reverse; gap: 8px;\n  z-index: 60;\n  pointer-events: none;\n}\n.toast {\n  pointer-events: auto;\n  min-width: 240px; max-width: 340px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: var(--r-md);\n  box-shadow: var(--shadow-lg);\n  padding: 11px 13px;\n  animation: slide-in .18s ease-out;\n}\n@keyframes slide-in { from { opacity: 0; transform: translateY(6px); } }\n.toast .t-title { font-weight: 600; font-size: 12.5px; display: flex; align-items: center; gap: 7px; }\n.toast .t-body { margin-top: 4px; font-size: 11.5px; color: var(--muted); line-height: 1.55; word-break: break-all; }\n.toast.error .t-title { color: var(--danger); }\n.toast .bar { margin-top: 9px; height: 3px; border-radius: 3px; background: #eef1f4; overflow: hidden; }\n.toast .bar i { display: block; height: 100%; width: 0%; background: var(--brand); border-radius: 3px; transition: width .25s; }\n.spinner {\n  width: 12px; height: 12px; border-radius: 50%;\n  border: 2px solid #dfe5ec; border-top-color: var(--brand);\n  animation: spin .7s linear infinite;\n}\n@keyframes spin { to { transform: rotate(360deg); } }\n\n/* ---------------- 拖放 ---------------- */\n\n.dropzone {\n  position: fixed; inset: 0;\n  background: rgba(247,248,250,.82);\n  backdrop-filter: blur(2px);\n  display: none;\n  place-items: center;\n  z-index: 80;\n}\n.dropzone.on { display: grid; }\n.dropzone-inner {\n  width: 380px; height: 200px;\n  border: 2px dashed #a9bccd;\n  border-radius: 18px;\n  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;\n  color: #5a6b7c;\n  background: rgba(255,255,255,.7);\n}\n.dropzone-inner strong { font-size: 15px; color: var(--text); }\n.dropzone-inner span { font-size: 12px; color: var(--muted); }\n\n/* ---------------- 右键菜单 ---------------- */\n\n.ctxmenu {\n  position: fixed;\n  display: none;\n  min-width: 190px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  box-shadow: var(--shadow-lg);\n  padding: 5px;\n  z-index: 90;\n}\n.ctxmenu.on { display: block; }\n.ctxmenu .item {\n  height: 30px;\n  display: flex; align-items: center; gap: 9px;\n  padding: 0 9px;\n  border-radius: 7px;\n  font-size: 12.5px;\n  cursor: pointer;\n  color: var(--text);\n}\n.ctxmenu .item:hover { background: #f1f4f7; }\n.ctxmenu .item.danger { color: var(--danger); }\n.ctxmenu .item .k { margin-left: auto; color: var(--faint); font-size: 11px; }\n.ctxmenu .divider { height: 1px; background: var(--line); margin: 5px 6px; }\n\n/* ---------------- 设置弹窗 ---------------- */\n\n.modal-mask {\n  position: fixed; inset: 0;\n  background: rgba(20, 26, 33, .28);\n  display: none;\n  place-items: center;\n  z-index: 100;\n}\n.modal-mask.on { display: grid; }\n\n.modal {\n  width: 880px;\n  max-width: calc(100vw - 48px);\n  max-height: 88vh;\n  background: var(--panel);\n  border-radius: 16px;\n  box-shadow: var(--shadow-lg);\n  display: flex; flex-direction: column;\n  overflow: hidden;\n  animation: pop .16s ease-out;\n}\n@keyframes pop { from { opacity: 0; transform: scale(.985) translateY(4px); } }\n\n/* 设置页分类导航（左侧一列）+ 内容区（右侧滚动） */\n.modal-main {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  align-items: stretch;\n}\n\n.set-nav {\n  flex: 0 0 auto;\n  width: 178px;\n  overflow-y: auto;\n  padding: 10px 8px 14px;\n  border-right: 1px solid var(--line);\n  background: var(--panel-2);\n}\n.set-nav::-webkit-scrollbar { width: 8px; }\n.set-nav::-webkit-scrollbar-thumb { background: #dde2e8; border-radius: 8px; border: 2px solid var(--panel-2); }\n\n.set-nav-item {\n  display: flex; align-items: center; gap: 9px;\n  width: 100%;\n  padding: 8px 10px;\n  margin-bottom: 2px;\n  border: 1px solid transparent;\n  border-radius: 9px;\n  background: transparent;\n  font: inherit; font-size: 12.5px; color: var(--text);\n  text-align: left; cursor: pointer;\n}\n.set-nav-item:hover { background: rgba(15, 157, 99, .07); }\n.set-nav-item.dim { opacity: .42; }\n.set-nav-item.dim:hover { opacity: .8; }\n.set-nav-item.on {\n  background: var(--brand-soft);\n  border-color: rgba(15, 157, 99, .28);\n  color: var(--brand-ink);\n  font-weight: 600;\n}\n.set-nav-ico { flex: 0 0 auto; display: inline-flex; color: currentColor; opacity: .85; }\n.set-nav-ico svg { width: 15px; height: 15px; }\n.set-nav-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.set-nav-badge {\n  flex: 0 0 auto;\n  min-width: 17px; padding: 0 5px;\n  font-size: 10.5px; line-height: 16px; text-align: center;\n  border-radius: 999px;\n  background: var(--danger); color: #fff;\n}\n.set-nav-badge[hidden] { display: none; }\n.set-nav-badge.warn { background: #d97706; }\n\n/* 搜索框：设置项太多时按关键词直达 */\n.set-search-wrap {\n  flex: 1 1 auto;\n  max-width: 320px;\n  min-width: 120px;\n  margin-left: 14px;\n  height: 30px;\n  display: flex; align-items: center; gap: 6px;\n  padding: 0 9px;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  background: var(--panel-2);\n  color: var(--faint);\n}\n.set-search-wrap:focus-within { border-color: var(--brand); box-shadow: var(--ring); }\n.set-search {\n  flex: 1; min-width: 0;\n  border: none; outline: none; background: transparent;\n  font: inherit; font-size: 12.5px; color: var(--text);\n}\n.set-search::-webkit-search-cancel-button { display: none; }\n.set-search-clear {\n  flex: 0 0 auto;\n  border: none; background: transparent; padding: 0 2px;\n  font-size: 16px; line-height: 1; color: var(--faint); cursor: pointer;\n}\n.set-search-clear:hover { color: var(--text); }\n.set-search-clear[hidden] { display: none; }\n\n/* 自动检测结果 */\n.dbg-list { margin-bottom: 10px; }\n.dbg-group { margin-bottom: 10px; }\n.dbg-group-title {\n  font-size: 11.5px; font-weight: 650; color: var(--faint);\n  letter-spacing: .3px; margin: 8px 0 6px;\n  display: flex; align-items: center; gap: 6px;\n}\n.dbg-group-title .dbg-count {\n  font-weight: 500; color: var(--muted);\n  background: var(--panel-2); border: 1px solid var(--line);\n  border-radius: 999px; padding: 0 6px; font-size: 10.5px;\n}\n.dbg-item {\n  display: flex; align-items: flex-start; gap: 10px;\n  padding: 9px 11px; margin-bottom: 7px;\n  border: 1px solid var(--line); border-radius: 10px;\n  background: var(--panel-2);\n}\n.dbg-item .dbg-sev { flex: 0 0 auto; width: 6px; align-self: stretch; border-radius: 4px; background: var(--faint); }\n.dbg-item.error .dbg-sev { background: var(--danger); }\n.dbg-item.warn .dbg-sev { background: #d97706; }\n.dbg-item.info .dbg-sev { background: var(--brand); }\n.dbg-item .dbg-body { flex: 1; min-width: 0; }\n.dbg-item .dbg-name { font-size: 12.5px; font-weight: 600; color: var(--text); }\n.dbg-item .dbg-hint { font-size: 11.5px; color: var(--muted); margin-top: 3px; line-height: 1.55; }\n.dbg-item .dbg-detail {\n  font-size: 11px; color: var(--faint); margin-top: 4px; line-height: 1.5;\n  word-break: break-all;\n}\n.dbg-item .dbg-fix {\n  flex: 0 0 auto; align-self: center;\n  height: 28px; padding: 0 12px; font-size: 12px; border-radius: 8px;\n  border: 1px solid var(--brand); color: var(--brand); background: var(--brand-soft);\n}\n.dbg-item .dbg-fix:hover { background: var(--brand); color: #fff; }\n.dbg-item .dbg-help {\n  flex: 0 0 auto; align-self: center;\n  height: 28px; padding: 0 9px; font-size: 12px; border-radius: 8px;\n  border: 1px solid var(--line); color: var(--muted); background: transparent;\n}\n.dbg-item .dbg-help:hover { border-color: var(--brand); color: var(--brand); }\n.dbg-ok {\n  display: flex; align-items: center; gap: 8px;\n  padding: 10px 12px; border-radius: 10px;\n  background: var(--brand-soft); color: var(--brand-ink); font-size: 12.5px;\n}\n\n.modal-head {\n  flex: 0 0 auto;\n  display: flex; align-items: center;\n  padding: 14px 14px 12px 18px;\n  border-bottom: 1px solid var(--line);\n}\n.modal-head h2 { margin: 0; font-size: 14.5px; font-weight: 650; }\n.modal-head .icon-btn { margin-left: auto; }\n\n.modal-body {\n  flex: 1;\n  min-width: 0;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 6px 18px 18px;\n}\n.modal-body::-webkit-scrollbar { width: 10px; }\n.modal-body::-webkit-scrollbar-thumb { background: #dde2e8; border-radius: 8px; border: 3px solid var(--panel); }\n\n.group { padding: 14px 0 6px; border-bottom: 1px solid var(--line); }\n.group:last-child { border-bottom: none; }\n.group.last-visible { border-bottom: none; }\n.group-title {\n  font-size: 11.5px; font-weight: 650; letter-spacing: .4px;\n  color: var(--faint); text-transform: uppercase;\n  margin-bottom: 10px;\n}\n\n/* 实验室分组的实验性提示 */\n.lab-notice {\n  font-size: 11.5px; line-height: 1.6; color: var(--faint);\n  background: rgba(255, 255, 255, .03);\n  border: 1px solid var(--line);\n  border-left: 2px solid #c9a227;\n  border-radius: 6px;\n  padding: 9px 12px;\n  margin-bottom: 14px;\n}\n\n.field { margin-bottom: 12px; }\n.field label { display: block; font-size: 12.5px; margin-bottom: 6px; color: var(--text); font-weight: 500; }\n.field .sub { display: block; font-size: 11.5px; color: var(--faint); margin-top: 2px; line-height: 1.5; }\n.field input[type=text], .field input[type=number], .field select {\n  width: 100%; height: 32px;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  padding: 0 10px;\n  font-size: 12.5px; font-family: inherit;\n  color: var(--text);\n  background: var(--panel-2);\n  outline: none;\n}\n.field input:focus, .field select:focus { border-color: #b9c6d4; box-shadow: 0 0 0 3px rgba(22,163,74,.08); }\n.field input[readonly] { color: var(--muted); }\n.field .row { display: flex; gap: 8px; }\n.checkbox-inline { display: inline-flex; align-items: center; gap: 6px; margin-top: 7px; font-size: 12px; color: var(--faint); }\n.field .row input { flex: 1; }\n.field.two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\n.pf-item { border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px; margin-bottom: 8px; background: var(--panel-2); }\n.pf-head { display: flex; align-items: center; gap: 7px; }\n.pf-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; background: #9aa4b2; }\n.pf-dot.ok { background: #16a34a; }\n.pf-dot.warn { background: #d97706; }\n.pf-dot.bad { background: #dc2626; }\n.pf-title { font-size: 12.5px; font-weight: 600; color: var(--text); flex: 1; }\n.pf-detail { font-size: 11.5px; color: var(--faint); line-height: 1.55; margin-top: 4px; white-space: pre-wrap; }\n.pf-action { margin-top: 7px; }\n\n.drv-list { margin-bottom: 12px; }\n.drv-item {\n  border: 1px solid var(--line); border-radius: 10px;\n  padding: 9px 11px; margin-bottom: 8px; background: var(--panel-2);\n}\n.drv-item.on { border-color: #b7e4c7; }\n.drv-head { display: flex; align-items: center; gap: 8px; }\n.drv-name { font-size: 12.5px; font-weight: 600; color: var(--text); flex: 1; }\n.drv-meta { font-size: 11px; color: var(--faint); margin-top: 3px; line-height: 1.5; }\n.drv-badge {\n  font-size: 10px; padding: 1px 6px; border-radius: 999px;\n  background: #eef2f6; color: var(--faint);\n}\n.drv-badge.hit { background: #e7f6ec; color: #17803d; }\n.drv-err { font-size: 11px; color: #b42318; line-height: 1.5; margin: 4px 0; }\n\n.switch-field { display: flex; align-items: center; gap: 14px; }\n.switch-field > div { flex: 1; }\n.switch {\n  appearance: none;\n  width: 38px; height: 22px;\n  border-radius: 999px;\n  background: #d9dee5;\n  position: relative;\n  cursor: pointer;\n  transition: background .16s;\n  flex: 0 0 auto;\n  border: none;\n}\n.switch::after {\n  content: \"\";\n  position: absolute; top: 2px; left: 2px;\n  width: 18px; height: 18px;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: 0 1px 2px rgba(0,0,0,.2);\n  transition: transform .16s;\n}\n.switch:checked { background: var(--brand); }\n.switch:checked::after { transform: translateX(16px); }\n\n.note {\n  margin: 2px 0 12px;\n  font-size: 11.5px;\n  color: var(--muted);\n  line-height: 1.6;\n  background: #f6f8fa;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  padding: 8px 10px;\n}\n.runtime-actions { display: flex; align-items: center; gap: 8px; margin: 2px 0 10px; }\n.inline-note { font-size: 11.5px; color: var(--faint); }\n\n/* 状态条上的自检计数：主界面不再放大横幅，问题只在底部提示，点开进设置 */\n.status-chip {\n  height: 19px; padding: 0 8px; margin-left: 2px;\n  font-size: 11px; line-height: 17px;\n  border-radius: 999px;\n  border: 1px solid #f0d9a8; background: #fff8e6; color: #a16207;\n  cursor: pointer; white-space: nowrap;\n}\n.status-chip.err { border-color: #f3c6c6; background: #fdeeee; color: #b91c1c; }\n.status-chip:hover { filter: brightness(.97); }\n.status-chip[hidden] { display: none; }\n\n/* ---------------- 环境自检横幅 ---------------- */\n\n.env-check {\n  flex: 0 0 auto;\n  margin: 0 0 12px;\n  border: 1px solid var(--line-strong);\n  border-radius: var(--r-md);\n  background: var(--panel);\n  box-shadow: var(--shadow-sm);\n  overflow: hidden;\n}\n.env-check-head {\n  display: flex; align-items: center; gap: 10px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--line);\n  background: var(--panel-2);\n}\n.env-check-head .ec-title { font-weight: 600; }\n.env-check-head .ec-count {\n  font-size: 11.5px; color: #fff; background: var(--danger);\n  border-radius: 999px; padding: 1px 8px;\n}\n.env-check-head .ec-count.warn { background: #d97706; }\n.env-check-head .ec-spacer { flex: 1; }\n.env-check-head button { height: 28px; padding: 0 12px; font-size: 12px; border-radius: 8px; }\n.env-check-list { padding: 6px 8px; display: flex; flex-direction: column; gap: 6px; }\n.env-check-item {\n  display: flex; align-items: flex-start; gap: 10px;\n  padding: 8px 10px; border-radius: 10px; background: var(--panel-2);\n  border: 1px solid var(--line);\n}\n.env-check-item .ec-sev {\n  flex: 0 0 auto; width: 6px; align-self: stretch; border-radius: 4px; background: var(--faint);\n}\n.env-check-item.error .ec-sev { background: var(--danger); }\n.env-check-item.warn .ec-sev { background: #d97706; }\n.env-check-item .ec-body { flex: 1; min-width: 0; }\n.env-check-item .ec-name { font-weight: 600; font-size: 12.5px; }\n.env-check-item .ec-hint { font-size: 11.5px; color: var(--muted); margin-top: 2px; line-height: 1.5; }\n.env-check-item .ec-fix {\n  flex: 0 0 auto; align-self: center;\n  height: 28px; padding: 0 12px; font-size: 12px; border-radius: 8px;\n  border: 1px solid var(--brand); color: var(--brand); background: var(--brand-soft);\n}\n.env-check-item .ec-fix:hover { background: var(--brand); color: #fff; }\n.env-check-item .ec-help {\n  flex: 0 0 auto; align-self: center;\n  height: 28px; padding: 0 9px; font-size: 12px; border-radius: 8px;\n  border: 1px solid var(--line); color: var(--muted); background: transparent;\n}\n.env-check-item .ec-help:hover { border-color: var(--brand); color: var(--brand); }\n.env-check-ok {\n  display: flex; align-items: center; gap: 8px;\n  padding: 12px 14px; color: var(--brand-dark); font-size: 12.5px;\n}\n\n/* 设置里的运行时面板：自检块与旧向导样式内嵌化（不再整屏、不需要投影） */\n.modal-body .env-check { margin: 6px 0 12px; box-shadow: none; }\n.modal-body .env-check-ok { padding: 10px 12px; }\n.modal-body .setup-guide { max-width: none; padding: 14px 16px; margin: 6px 0 4px; }\n.modal-body .steps .step { padding: 10px 12px; }\n\n\n.modal-foot {\n  flex: 0 0 auto;\n  display: flex; align-items: center;\n  padding: 12px 18px;\n  border-top: 1px solid var(--line);\n  background: var(--panel-2);\n}\n.modal-foot .btn { margin-left: auto; }\n\n/* ---------------- 运行时部署向导 ---------------- */\n\n.setup {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n  padding: 4px 0 24px;\n}\n.setup[hidden] { display: none; }\n.content[hidden] { display: none; }\n\n.setup-card {\n  width: 100%;\n  max-width: 780px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  padding: 22px 24px;\n  box-shadow: var(--shadow-sm);\n}\n.setup-head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 16px; }\n.setup-head h1 { font-size: 17px; margin: 0 0 6px; font-weight: 650; }\n.setup-head p { margin: 0; color: var(--muted); font-size: 12.5px; line-height: 1.7; }\n.setup-head b { color: var(--text); font-weight: 600; }\n.setup-hv {\n  margin-left: auto;\n  font-size: 11.5px;\n  color: var(--muted);\n  background: #f4f6f8;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  padding: 4px 10px;\n  white-space: nowrap;\n  max-width: 260px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.setup-hv.ok { color: var(--brand-dark); background: var(--brand-soft); border-color: #cdebd8; }\n\n.steps { display: flex; flex-direction: column; gap: 8px; }\n\n.step {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 11px 12px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  background: var(--panel-2);\n}\n.step .idx {\n  width: 22px; height: 22px;\n  border-radius: 50%;\n  display: grid; place-items: center;\n  font-size: 11.5px; font-weight: 650;\n  background: #eef1f4; color: var(--muted);\n  flex: 0 0 auto;\n}\n.step.done .idx { background: var(--brand); color: #fff; }\n.step.busy .idx { background: #fff3d6; color: #a16207; }\n.step .body { flex: 1; min-width: 0; }\n.step .t { font-size: 12.5px; font-weight: 600; display: flex; gap: 6px; align-items: center; }\n.step .tag {\n  font-size: 10.5px; font-weight: 500;\n  padding: 1px 6px; border-radius: 5px;\n  background: #eef1f4; color: var(--muted);\n}\n.step .tag.req { background: #fef2f2; color: #b91c1c; }\n.step .d { font-size: 11.5px; color: var(--faint); margin-top: 2px; word-break: break-all; }\n.step .bar { height: 3px; background: #e9edf1; border-radius: 3px; margin-top: 7px; overflow: hidden; display: none; }\n.step.busy .bar { display: block; }\n.step .bar i { display: block; height: 100%; width: 0; background: var(--brand); transition: width .3s; }\n.step .act { flex: 0 0 auto; display: flex; gap: 6px; }\n\n.setup-foot { display: flex; align-items: center; gap: 10px; margin-top: 16px; }\n.setup-foot .inline-note { margin-left: auto; }\n\n.setup-guide {\n  width: 100%;\n  max-width: 780px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  padding: 20px 24px;\n  box-shadow: var(--shadow-sm);\n}\n.setup-guide[hidden] { display: none; }\n.setup-guide h2 { margin: 0 0 4px; font-size: 15px; font-weight: 650; }\n.guide-sub { margin: 0; font-size: 12px; color: var(--muted); }\n.guide-list { margin: 12px 0; padding-left: 20px; font-size: 12.5px; line-height: 1.95; }\n.guide-list li { margin-bottom: 4px; }\n.guide-list code, .guide-tip code {\n  background: #f2f5f8;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  padding: 1px 5px;\n  font-family: Consolas, \"Cascadia Mono\", monospace;\n  font-size: 11.5px;\n}\nkbd {\n  background: #fff;\n  border: 1px solid var(--line-strong);\n  border-bottom-width: 2px;\n  border-radius: 5px;\n  padding: 0 5px;\n  font-size: 11px;\n  font-family: inherit;\n}\n.guide-tip {\n  font-size: 11.5px;\n  color: var(--muted);\n  background: #f7f9fb;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  padding: 9px 11px;\n  line-height: 1.75;\n}\n.guide-foot { display: flex; gap: 10px; margin-top: 14px; }\n\n/* ---- 关于 / 品牌信息 ---- */\n.about-box {\n  display: flex;\n  gap: 16px;\n  align-items: flex-start;\n}\n.about-brand { flex: none; }\n.about-logo {\n  width: 56px; height: 56px;\n  border-radius: 14px;\n  display: block;\n  box-shadow: 0 2px 10px rgba(15, 23, 32, .18);\n  -webkit-user-drag: none;\n}\n.about-qrs {\n  display: flex;\n  gap: 14px;\n  flex: none;\n}\n.about-qr {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  flex: none;\n}\n.about-qr img {\n  border-radius: 10px;\n  border: 1px solid var(--line);\n  display: block;\n}\n.about-qr-tip {\n  font-size: 10.5px;\n  color: var(--muted);\n}\n.about-info { flex: 1; min-width: 0; }\n.about-name {\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n.about-ver {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--muted);\n  margin-left: 6px;\n}\n.about-links {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-top: 10px;\n  font-size: 12px;\n}\n.about-links a {\n  color: #2f6fed;\n  text-decoration: none;\n  word-break: break-all;\n}\n.about-links a:hover { text-decoration: underline; }\n.powered {\n  font-size: 11.5px;\n  color: var(--muted);\n}\n.powered b { color: var(--text); }\n.powered-link {\n  color: var(--muted);\n  text-decoration: none;\n  font-size: 11px;\n}\n.powered-link:hover { color: var(--text); text-decoration: underline; }\n\n/* 高级参数默认折叠：零配置体验，不把内部参数暴露给普通用户 */\n.advanced-group {\n  border-top: 1px solid var(--line, #e8ebf0);\n  margin: 4px 0 0;\n  padding: 0;\n}\n.advanced-group > summary {\n  cursor: pointer;\n  list-style: none;\n  user-select: none;\n  padding: 14px 2px 10px;\n  font-size: 12px;\n  color: var(--muted, #7b828e);\n  font-weight: 600;\n}\n.advanced-group > summary::-webkit-details-marker { display: none; }\n.advanced-group > summary::before {\n  content: '▸';\n  display: inline-block;\n  margin-right: 7px;\n  transition: transform .15s ease;\n}\n.advanced-group[open] > summary::before { transform: rotate(90deg); }\n.advanced-group[open] > summary { color: var(--text, #2b3138); }\n\n/* ---------------- 软件更新 ---------------- */\n.update-bar {\n  margin-top: 9px;\n  height: 4px;\n  border-radius: 4px;\n  background: #e9edf1;\n  overflow: hidden;\n}\n.update-bar i {\n  display: block;\n  height: 100%;\n  width: 0;\n  border-radius: 4px;\n  background: var(--brand);\n  transition: width .25s;\n}\n.update-notes {\n  margin-top: 8px;\n  max-height: 118px;\n  overflow: auto;\n  padding: 9px 11px;\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: var(--panel-2);\n  font-size: 12px;\n  line-height: 1.6;\n  white-space: pre-wrap;\n  color: var(--text-2, #556);\n}\n\n/* 组内的小号折叠块（容器细节等） */\n.mini-details {\n  margin: 2px 0 6px;\n  border: 1px dashed var(--line, #e8ebf0);\n  border-radius: 10px;\n  padding: 0 10px 2px;\n}\n.mini-details > summary {\n  cursor: pointer;\n  list-style: none;\n  user-select: none;\n  padding: 10px 0 8px;\n  font-size: 12px;\n  color: var(--muted, #7b828e);\n  font-weight: 600;\n}\n.mini-details > summary::-webkit-details-marker { display: none; }\n.mini-details > summary::before {\n  content: '▸';\n  display: inline-block;\n  margin-right: 6px;\n  transition: transform .15s ease;\n}\n.mini-details[open] > summary::before { transform: rotate(90deg); }\n\n/* 行内按钮不要折行（空间紧张时「立即扩容」会被拆成两行） */\n.row .btn { white-space: nowrap; flex: 0 0 auto; }\n"},"headersSize":188,"bodySize":30514,"redirectURL":"","_transferSize":30702},"cache":{},"timings":{"dns":0.073,"connect":0.109,"ssl":137.745,"send":0,"wait":0.746,"receive":0.087},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4384.154,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.525Z","time":139.55400000000003,"request":{"method":"GET","url":"http://127.0.0.1:8765/theme.css","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":378,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/css"},{"name":"Content-Length","value":"11936"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":11936,"mimeType":"text/css","compression":0,"text":"/* ============================================================================\n * theme.css —— 全局视觉刷新（在 style.css 之后加载，只做覆盖与增强）\n *\n * 设计目标：更\"安卓运行器\"的气质 —— 深绿品牌色 + 干净的浅色面板 + 圆润的卡片，\n * 同时把启动时的欢迎卡做成一整套统一语言。\n * ========================================================================== */\n\n:root {\n  /* 品牌：翡翠绿 → 青绿渐变 */\n  --brand: #0f9d63;\n  --brand-dark: #0b7d4f;\n  --brand-2: #12b886;\n  --brand-soft: #e8f8f0;\n  --brand-ink: #075c3a;\n\n  --bg: #f4f7f5;\n  --bg-2: #eef3f0;\n  --panel: #ffffff;\n  --panel-2: #fafcfb;\n  --line: #e3e9e5;\n  --line-strong: #cfd8d2;\n  --text: #14201a;\n  --text-2: #3d4a44;\n  --muted: #6b7a72;\n  --faint: #93a19a;\n  --danger: #d92d20;\n\n  --shadow-sm: 0 1px 2px rgba(14, 32, 24, .05);\n  --shadow-md: 0 10px 26px rgba(14, 32, 24, .09);\n  --shadow-lg: 0 24px 60px rgba(14, 32, 24, .16);\n\n  --r-sm: 9px;\n  --r-md: 14px;\n  --r-lg: 20px;\n\n  --ring: 0 0 0 3px rgba(15, 157, 99, .16);\n}\n\nhtml, body {\n  background:\n    radial-gradient(1200px 420px at 12% -12%, rgba(18, 184, 134, .10), transparent 62%),\n    radial-gradient(900px 380px at 100% 0%, rgba(15, 157, 99, .07), transparent 58%),\n    var(--bg);\n}\n\n/* ---------------- 标题栏：玻璃质感 ---------------- */\n\n.titlebar {\n  height: 46px;\n  flex: 0 0 46px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, .82), rgba(255, 255, 255, .46));\n  border-bottom: 1px solid rgba(20, 32, 26, .07);\n  backdrop-filter: saturate(1.4) blur(14px);\n}\n\n.logo img,\n.logo svg {\n  width: 22px; height: 22px;\n  border-radius: 7px;\n  display: block;\n  box-shadow: 0 2px 8px rgba(15, 157, 99, .28);\n}\n\n.brand-name {\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: .1px;\n  background: linear-gradient(92deg, #14201a, #2b6a4d);\n  -webkit-background-clip: text; background-clip: text; color: transparent;\n}\n\n.brand-tag {\n  border: 1px solid rgba(15, 157, 99, .16);\n  background: rgba(18, 184, 134, .09);\n  color: var(--brand-ink);\n  font-weight: 600;\n  transition: background .15s ease, transform .15s ease;\n}\n.brand-tag:hover { background: rgba(18, 184, 134, .16); transform: translateY(-1px); }\n\n.icon-btn {\n  width: 32px; height: 32px;\n  border-radius: 10px;\n  transition: background .15s ease, color .15s ease, transform .12s ease;\n}\n.icon-btn:hover { background: rgba(20, 32, 26, .06); color: var(--text); }\n.icon-btn:active { transform: scale(.95); }\n\n/* ---------------- 搜索框 / 主按钮 ---------------- */\n\n.search {\n  border-radius: 12px;\n  border: 1px solid var(--line);\n  background: rgba(255, 255, 255, .9);\n  box-shadow: var(--shadow-sm);\n  transition: box-shadow .15s ease, border-color .15s ease, background .15s ease;\n}\n.search:focus-within {\n  border-color: rgba(15, 157, 99, .45);\n  box-shadow: var(--ring);\n  background: #fff;\n}\n\n.btn {\n  border-radius: 11px;\n  border: 1px solid var(--line-strong);\n  background: #fff;\n  box-shadow: var(--shadow-sm);\n  font-weight: 600;\n  transition: transform .12s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;\n}\n.btn:hover { background: #fbfdfc; box-shadow: 0 2px 8px rgba(14, 32, 24, .08); }\n.btn:active { transform: translateY(1px) scale(.995); }\n\n.btn.primary {\n  border: none;\n  color: #fff;\n  background: linear-gradient(180deg, var(--brand-2), var(--brand));\n  box-shadow: 0 1px 0 rgba(255, 255, 255, .22) inset, 0 6px 16px rgba(15, 157, 99, .28);\n}\n.btn.primary:hover {\n  background: linear-gradient(180deg, #16c68f, var(--brand-dark));\n  box-shadow: 0 1px 0 rgba(255, 255, 255, .22) inset, 0 8px 22px rgba(15, 157, 99, .34);\n}\n.btn.primary:focus-visible { outline: none; box-shadow: var(--ring), 0 6px 16px rgba(15, 157, 99, .28); }\n\n.btn.ghost { background: rgba(255, 255, 255, .6); }\n.btn.ghost:hover { background: rgba(20, 32, 26, .05); }\n\n/* ---------------- 应用卡片 ---------------- */\n\n.grid { gap: 14px; }\n\n.card {\n  border-radius: var(--r-lg);\n  border: 1px solid var(--line);\n  background: linear-gradient(180deg, #fff, #fdfefe);\n  box-shadow: var(--shadow-sm);\n  transition: transform .16s cubic-bezier(.2, .7, .2, 1), box-shadow .18s ease, border-color .16s ease;\n}\n.card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(15, 157, 99, .28);\n  box-shadow: 0 14px 30px rgba(14, 32, 24, .12);\n}\n.card::after {\n  content: '';\n  position: absolute; inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);\n}\n\n.card .icon {\n  border-radius: 16px;\n  box-shadow: 0 6px 16px rgba(14, 32, 24, .14), inset 0 1px 0 rgba(255, 255, 255, .35);\n}\n\n.card .badge-run {\n  background: linear-gradient(180deg, var(--brand-2), var(--brand));\n  box-shadow: 0 2px 8px rgba(15, 157, 99, .4);\n}\n\n/* ---------------- 「添加应用」虚线卡片 ----------------\n * 应用少的时候网格下面是一大片空白，用户也不知道还能干什么。\n * 这块卡片把「拖 APK 进来」摆到眼前，同时把空白填掉。\n * 用虚线 + 弱化配色，让它看起来是「空位」而不是又一个已经装好的应用。 */\n\n.card-add {\n  background: transparent;\n  border: 1.5px dashed var(--line-strong);\n  box-shadow: none;\n  color: var(--muted);\n  justify-content: center;\n  min-height: 178px;\n}\n.card-add:hover {\n  border-color: rgba(15, 157, 99, .55);\n  border-style: dashed;\n  background: rgba(18, 184, 134, .05);\n  box-shadow: none;\n  color: var(--brand-dark);\n}\n.card-add:active { transform: translateY(0); }\n.card-add:focus-visible {\n  outline: none;\n  border-color: rgba(15, 157, 99, .6);\n  box-shadow: var(--ring);\n}\n\n.card-add .add-plus {\n  width: 52px; height: 52px;\n  margin-bottom: 10px;\n  border-radius: 16px;\n  display: grid; place-items: center;\n  color: var(--faint);\n  background: rgba(20, 32, 26, .045);\n  transition: background .16s ease, color .16s ease, transform .16s ease;\n}\n.card-add:hover .add-plus {\n  color: var(--brand);\n  background: rgba(18, 184, 134, .14);\n  transform: translateY(-1px);\n}\n.card-add .name { font-weight: 600; }\n.card-add .meta { color: var(--faint); }\n\n/* ---------------- 状态栏 ---------------- */\n\n.statusbar {\n  border-top: 1px solid rgba(20, 32, 26, .06);\n  background: linear-gradient(180deg, rgba(255, 255, 255, .5), rgba(255, 255, 255, .82));\n  backdrop-filter: blur(10px);\n}\n\n.dot { box-shadow: 0 0 0 3px rgba(18, 184, 134, .14); }\n\n/* 状态栏里的网络指示：绿灯=已联网，黄灯=虚拟机没网。\n * 这个坑很隐蔽（应用里只显示「网络错误」，看不出是虚拟机的事），所以放在最显眼处。 */\n.status-net::before {\n  content: '';\n  display: inline-block;\n  width: 6px; height: 6px;\n  margin-right: 5px;\n  border-radius: 50%;\n  vertical-align: 1px;\n  background: currentColor;\n}\n.status-net.ok { color: var(--brand-ink); }\n.status-net.ok::before { background: var(--brand); box-shadow: 0 0 0 3px rgba(18, 184, 134, .16); }\n.status-net.warn { color: #9a6b00; }\n.status-net.warn::before { background: #e0a100; box-shadow: 0 0 0 3px rgba(224, 161, 0, .16); }\n\n/* ---------------- 模态框 ---------------- */\n\n.modal-mask { backdrop-filter: blur(6px); background: rgba(12, 24, 19, .34); }\n\n.modal {\n  border-radius: 22px;\n  border: 1px solid rgba(255, 255, 255, .6);\n  box-shadow: var(--shadow-lg);\n  overflow: hidden;\n}\n\n.modal-head {\n  background: linear-gradient(180deg, #fff, #f7faf8);\n  border-bottom: 1px solid var(--line);\n}\n\n.group-title {\n  color: var(--brand-ink);\n  letter-spacing: .3px;\n}\n\n/* ---------------- 滚动条 ---------------- */\n\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-thumb {\n  background: rgba(20, 32, 26, .16);\n  border: 3px solid transparent;\n  border-radius: 999px;\n  background-clip: content-box;\n}\n::-webkit-scrollbar-thumb:hover { background: rgba(20, 32, 26, .28); background-clip: content-box; }\n::-webkit-scrollbar-track { background: transparent; }\n\n/* ============================================================================\n * 启动欢迎卡\n * ========================================================================== */\n\n.welcome-mask[hidden] { display: none; }\n\n.welcome-mask {\n  position: fixed; inset: 0; z-index: 90;\n  display: grid; place-items: center;\n  background: rgba(10, 22, 17, .38);\n  backdrop-filter: blur(8px);\n  animation: wl-fade .22s ease both;\n}\n\n.welcome {\n  position: relative;\n  width: 396px;\n  max-width: calc(100vw - 48px);\n  border-radius: 24px;\n  overflow: hidden;\n  background: #fff;\n  border: 1px solid rgba(255, 255, 255, .7);\n  box-shadow: 0 32px 80px rgba(8, 24, 18, .32);\n  animation: wl-pop .28s cubic-bezier(.2, .8, .2, 1) both;\n}\n\n@keyframes wl-fade { from { opacity: 0; } to { opacity: 1; } }\n@keyframes wl-pop {\n  from { opacity: 0; transform: translateY(14px) scale(.97); }\n  to { opacity: 1; transform: none; }\n}\n\n.welcome-hero {\n  position: relative;\n  padding: 30px 26px 24px;\n  text-align: center;\n  color: #eafff5;\n  background:\n    radial-gradient(120% 130% at 20% 0%, #16c68f 0%, #0f9d63 46%, #0a6f47 100%);\n  overflow: hidden;\n}\n\n/* 光晕 */\n.welcome-halo {\n  position: absolute; left: 50%; top: -120px;\n  width: 340px; height: 240px; transform: translateX(-50%);\n  background: radial-gradient(closest-side, rgba(255, 255, 255, .45), rgba(255, 255, 255, 0) 72%);\n  pointer-events: none;\n}\n.welcome-hero::after {\n  content: '';\n  position: absolute; inset: 0;\n  background-image: radial-gradient(rgba(255, 255, 255, .16) 1px, transparent 1.2px);\n  background-size: 22px 22px;\n  opacity: .35;\n  mask-image: radial-gradient(70% 70% at 50% 30%, #000 20%, transparent 76%);\n  -webkit-mask-image: radial-gradient(70% 70% at 50% 30%, #000 20%, transparent 76%);\n  pointer-events: none;\n}\n\n.welcome-badge {\n  position: relative;\n  width: 66px; height: 66px;\n  margin: 0 auto 14px;\n  border-radius: 20px;\n  display: grid; place-items: center;\n  background: rgba(255, 255, 255, .16);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .4), 0 10px 24px rgba(3, 40, 26, .3);\n  backdrop-filter: blur(6px);\n}\n.welcome-badge img,\n.welcome-badge svg {\n  width: 44px; height: 44px;\n  border-radius: 13px;\n  display: block;\n  box-shadow: 0 6px 16px rgba(3, 40, 26, .35);\n}\n\n.welcome-hi {\n  position: relative;\n  font-size: 20px;\n  font-weight: 750;\n  letter-spacing: .2px;\n  text-shadow: 0 1px 0 rgba(0, 0, 0, .12);\n}\n\n.welcome-sub {\n  position: relative;\n  margin-top: 6px;\n  font-size: 12.5px;\n  color: rgba(234, 255, 245, .82);\n}\n\n.welcome-body { padding: 18px 22px 6px; }\n\n.welcome-stats {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 8px;\n}\n.welcome-stat {\n  border: 1px solid var(--line);\n  background: linear-gradient(180deg, #fbfdfc, #f5f9f7);\n  border-radius: 14px;\n  padding: 10px 8px;\n  text-align: center;\n}\n.welcome-stat b {\n  display: block;\n  font-size: 16px;\n  font-weight: 750;\n  color: var(--brand-ink);\n  line-height: 1.25;\n}\n.welcome-stat span {\n  display: block;\n  margin-top: 2px;\n  font-size: 11px;\n  color: var(--muted);\n}\n\n.welcome-tips { margin: 14px 0 4px; display: grid; gap: 8px; }\n.welcome-tip {\n  display: flex; align-items: flex-start; gap: 9px;\n  font-size: 12.5px;\n  color: var(--text-2);\n  line-height: 1.55;\n}\n.welcome-tip i {\n  flex: 0 0 auto;\n  width: 18px; height: 18px;\n  margin-top: 1px;\n  border-radius: 6px;\n  display: grid; place-items: center;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-style: normal;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.welcome-opt {\n  margin-top: 12px;\n  display: flex; align-items: center; gap: 8px;\n  font-size: 12px;\n  color: var(--muted);\n  cursor: pointer;\n  user-select: none;\n}\n.welcome-opt input { accent-color: var(--brand); width: 14px; height: 14px; }\n\n.welcome-actions {\n  display: flex;\n  gap: 10px;\n  padding: 14px 22px 20px;\n}\n.welcome-actions .btn { flex: 1; height: 40px; border-radius: 12px; font-size: 13.5px; }\n.welcome-actions .btn.ghost { flex: 0 0 auto; padding: 0 16px; }\n"},"headersSize":188,"bodySize":11936,"redirectURL":"","_transferSize":12124},"cache":{},"timings":{"dns":0.02,"connect":0.154,"ssl":137.675,"send":0,"wait":1.638,"receive":0.067},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4385.778,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.528Z","time":140.565,"request":{"method":"GET","url":"http://127.0.0.1:8765/stub.js","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":362,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/javascript"},{"name":"Content-Length","value":"6141"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":6141,"mimeType":"text/javascript","compression":0,"text":"\n'use strict';\n// Deterministic fixture responses for UI screenshots. Mirrors src/preload.js.\nconst SETTINGS = {\n  adbPath: '', runtime: { isoPath: '', sourcePreference: 'auto', autoMirror: true,\n    giteeToken: '', mirrorPrefix: '', downloadConnections: 8 },\n  engine: {\n    memoryMB: 2048, cores: 2, idleShutdownMinutes: 5, audio: true, liteMode: true,\n    prewarm: true, priorityMode: 'balanced', deepTrim: false, mouseRightBack: true,\n    mouseWheelMode: 'smooth', mouseSideButtons: false, keymapEnabled: true,\n    resourceMode: 'save', renderSize: 'auto', dataPartitionGB: 4, dnsPreset: 'cn',\n    fastDns: true, locale: 'en-US', chineseIme: false, keepSnapshot: true,\n    logLimitKB: 2048, backend: 'builtin',\n  },\n  display: {\n    mode: 'window', portrait: '720x1280', landscape: false, orientationMode: 'auto',\n    autoRotate: true, tabletMode: true, windowEmbed: false,\n    autoFullscreenOnLaunch: false,\n  },\n  createShortcutOnInstall: true, createStartMenuShortcut: true,\n  shortcutDir: '', sharedDir: '/home/user/ApkStartShared',\n  deviceSharedDir: '/sdcard/ApkStartShared', autoStart: false,\n  notifyOnInstall: true,\n  debug: { auto: true, intervalMin: 10, notify: false },\n  welcome: { disabled: true },\n};\nconst STATUS = {\n  mode: 'builtin', backend: 'builtin', backendLabel: '内置 QEMU',\n  installed: true, adbOk: true, vmRunning: false, deviceOnline: true,\n  ready: true, phase: 'idle', needsSetup: null, error: '', freeform: true,\n  android: '14', serial: 'emulator-5554',\n  env: { adb: { ok: true }, emulator: { ok: true }, sysimg: { ok: true } },\n  accel: { ok: true, kind: 'kvm' }, network: { ok: true },\n};\nconst APPS = [\n  { package: 'com.example.shortvideo', label: '示例短视频', versionName: '12.4.0',\n    iconUrl: '', accent: '#d97757', pinned: true, lastLaunchAt: Date.now() - 3600000 },\n  { package: 'com.example.reader', label: '示例阅读', versionName: '8.1.2',\n    iconUrl: '', accent: '#5b8def', lastLaunchAt: Date.now() - 86400000 },\n  { package: 'com.example.notes', label: '示例笔记', versionName: '3.7.1',\n    iconUrl: '', accent: '#4f9d76', lastLaunchAt: Date.now() - 172800000 },\n  { package: 'com.example.maps', label: '示例地图', versionName: '6.2.0',\n    iconUrl: '', accent: '#c98cb4', lastLaunchAt: Date.now() - 259200000 },\n];\nconst ISSUES = [\n  { code: 'storage.diskLow', category: 'storage', severity: 'warn',\n    title: '运行时所在磁盘空间偏紧', hint: '剩余不足 8 GB。', fix: 'disk', detail: '剩余 5.1 GB' },\n  { code: 'device.unauthorized', category: 'device', severity: 'error',\n    title: '安卓设备未授权调试', hint: '重启运行时后会重新弹出确认框。', fix: 'restartRuntime', detail: '' },\n];\nconst DEBUG_SUMMARY = { total: 2, errors: 1, warns: 1, infos: 0, health: 'error', byCategory: [] };\nconst EMPTY = {};\nconst OK = { ok: true };\nconst fixture = {\n  info: () => Promise.resolve({ version: '0.6.5', isDev: true, dataDir: '/home/user/.local/share/apkstart',\n    runtimeDir: '/home/user/.local/share/apkstart/runtime' }),\n  getSettings: () => Promise.resolve(SETTINGS),\n  setSettings: (patch) => {\n    Object.assign(SETTINGS.engine, patch.engine || {});\n    Object.assign(SETTINGS.display, patch.display || {});\n    Object.assign(SETTINGS, patch, { engine: SETTINGS.engine, display: SETTINGS.display });\n    return Promise.resolve(SETTINGS);\n  },\n  listApps: () => Promise.resolve(APPS),\n  runtimeStatus: () => Promise.resolve(STATUS),\n  runtimeProbe: () => Promise.resolve(STATUS),\n  doctorProfile: () => Promise.resolve({ profile: {}, text: '省电 · 2 核 / 2 GB / 720p' }),\n  selfCheck: () => Promise.resolve({ issues: ISSUES, accel: { ok: true }, free: 5242880 }),\n  doctorReport: () => Promise.resolve({ ok: true, file: '/tmp/apkstart-report.txt' }),\n  runtimeUsage: () => Promise.resolve({ totalText: '6.4 GB', reclaimableText: '1.1 GB', count: 2 }),\n  dataInfo: () => Promise.resolve({ avdDir: '/home/user/.local/share/apkstart/avd',\n    configuredGB: 4, actualGB: 4 }),\n  resources: () => Promise.resolve({ memory: {}, cores: {} }),\n  startupInfo: () => Promise.resolve({ smoke: true, firstRun: false, autostart: false, tips: [] }),\n  androidStatus: () => Promise.resolve({ status: { running: false, wifi: true, airplane: false,\n    anim: true, volume: 50, font: 1, density: 320 } }),\n  driversList: () => Promise.resolve({ drivers: [], errors: [] }),\n  preflightRun: () => Promise.resolve({ items: [] }),\n  autodebugState: () => Promise.resolve({ issues: ISSUES, summary: DEBUG_SUMMARY, at: Date.now(), running: false }),\n  autodebugRun: () => Promise.resolve({ issues: ISSUES, summary: DEBUG_SUMMARY, at: Date.now(), running: false }),\n  autodebugConfig: () => Promise.resolve(SETTINGS.debug),\n  updateCheck: () => Promise.resolve({ ok: true, current: '0.6.3', hasUpdate: false, sources: [] }),\n  assocStatus: () => Promise.resolve({ registered: false }),\n  appInfo: () => Promise.resolve({ version: '0.6.5' }),\n  android: {}, keymap: {}, shell: {},\n};\n// The preload bridge names are methods, not IPC channels; fill the rest with\n// harmless defaults so that screenshot states never fail on a missing method.\nconst target = { shell: {}, android: {}, keymap: {}, on: () => () => {}, pathForFile: (f) => f?.name || '' };\nfor (const name of ['runtimeLog', 'leftoversScan', 'engineResources', 'displayState',\n  'keymapGetPresets', 'keymapIsEnabled', 'provisionCheck', 'startupInfo']) {\n  if (!fixture[name]) fixture[name] = () => Promise.resolve(EMPTY);\n}\nfixture.android.status = () => Promise.resolve({ running: false, wifi: true, airplane: false,\n  anim: true, volume: 50, font: 1, density: 320 });\nfixture.android.set = () => Promise.resolve(OK);\nfixture.android.open = () => Promise.resolve(OK);\nfixture.keymap.getPresets = () => Promise.resolve({ presets: [] });\nfixture.keymap.isEnabled = () => Promise.resolve({ enabled: true });\nfixture.shell.state = () => Promise.resolve({});\nfixture.pathForFile = (f) => (f && f.name) || '';\nconst bridge = new Proxy({ ...target, ...fixture }, {\n  get(obj, prop) {\n    if (prop in obj) return obj[prop];\n    return () => Promise.resolve(OK);\n  },\n});\nwindow.apkstart = bridge;\n"},"headersSize":194,"bodySize":6141,"redirectURL":"","_transferSize":6335},"cache":{},"timings":{"dns":0.076,"connect":0.206,"ssl":137.513,"send":0,"wait":1.772,"receive":0.998},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4412.101,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.528Z","time":141.00199999999998,"request":{"method":"GET","url":"http://127.0.0.1:8765/i18n.js","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":362,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/javascript"},{"name":"Content-Length","value":"19856"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":19856,"mimeType":"text/javascript","compression":0,"text":"'use strict';\n/**\n * Lightweight English UI layer for the Linux build.\n *\n * The original application ships Simplified Chinese strings in the markup and\n * in dynamically inserted messages. Rewriting every call site would touch\n * several thousand lines, so this module translates rendered text and the\n * common attributes after each DOM change. Identifiers, element ids and the\n * values sent to the main process are never modified.\n */\n(function () {\n  const DICT = {\n    // Navigation and sections\n    '常用与安装': 'Common & Install',\n    '显示与窗口': 'Display & Window',\n    '操作与输入': 'Input & Controls',\n    '性能与资源': 'Performance & Resources',\n    '网络与下载': 'Network & Downloads',\n    '诊断与修复': 'Diagnostics & Repair',\n    '集成与文件': 'Integration & Files',\n    '更新与关于': 'Update & About',\n    '实验室': 'Lab',\n    '运行状态': 'Status',\n    '设置': 'Settings',\n    '应用': 'Applications',\n    '教程': 'Guide',\n    '运行时': 'Runtime',\n    '系统镜像': 'System image',\n    '兼容镜像': 'Compatibility image',\n    '硬件加速': 'Hardware acceleration',\n    '资源策略': 'Resource strategy',\n    '省资源': 'Save resources',\n    '均衡': 'Balanced',\n    '流畅': 'Smooth',\n    '横屏': 'Landscape',\n    '竖屏': 'Portrait',\n    '飞行模式': 'Airplane mode',\n    '快照': 'Snapshot',\n    '代理': 'Proxy',\n    '中文输入法': 'Chinese input method',\n    '系统语言': 'System language',\n    '自动全屏': 'Auto fullscreen',\n    '窗口模式': 'Window mode',\n    '全屏': 'Fullscreen',\n    '重置': 'Reset',\n    '刷新': 'Refresh',\n    '浏览': 'Browse',\n    '打开': 'Open',\n    '关闭': 'Close',\n    '取消': 'Cancel',\n    '完成': 'Done',\n    '保存': 'Save',\n    '删除': 'Delete',\n    '卸载': 'Uninstall',\n    '安装': 'Install',\n    '启动': 'Start',\n    '停止': 'Stop',\n    '重启': 'Restart',\n    '应用推荐配置': 'Apply recommended settings',\n    '导出诊断报告': 'Export diagnostic report',\n    '打开内置教程': 'Open built-in guide',\n    '打开下载页': 'Open download page',\n    '立即更新': 'Update now',\n    '检查更新': 'Check for updates',\n    '重新检查': 'Check again',\n    '一键完成': 'One-click setup',\n    '重建快捷方式': 'Rebuild shortcuts',\n    '固定到顶部': 'Pin to top',\n    '搜索已安装应用': 'Search installed apps',\n    '安装 APK': 'Install APK',\n    '选择 APK 文件': 'Choose APK file',\n    '把 APK 拖进来就能装': 'Drop an APK here to install',\n    '松手开始安装': 'Release to install',\n    '支持单个或多个 .apk 文件': 'One or more .apk files are supported',\n    '下次启动不再自动弹出': 'Do not show this again',\n    '打开设置': 'Open settings',\n    '开始使用': 'Get started',\n    '你好': 'Welcome',\n    '已就绪': 'Ready',\n    '正在检测…': 'Checking…',\n    '尚未检测': 'Not checked yet',\n    '检查中…': 'Checking…',\n    '准备中…': 'Preparing…',\n    '正在引导 Android…': 'Starting Android…',\n    '正在检查运行时…': 'Checking the runtime…',\n    '正在解析 APK…': 'Parsing APK…',\n    '正在安装应用…': 'Installing app…',\n    '正在更新应用…': 'Updating app…',\n    '正在准备安卓运行时…': 'Preparing the Android runtime…',\n    '正在创建桌面快捷方式…': 'Creating desktop shortcut…',\n    '未知': 'Unknown',\n    '未知错误': 'Unknown error',\n    '请重试': 'Please try again',\n    '请稍后再试': 'Please try again later',\n    '成功': 'Success',\n    '失败': 'Failed',\n    '已生效': 'Applied',\n    '已关闭': 'Disabled',\n    '已取消': 'Cancelled',\n    '已关联 · 点击取消': 'Associated · click to remove',\n    '未关联 · 点击开启': 'Not associated · click to enable',\n    '运行时未启动': 'Runtime is not running',\n    '运行时已就绪': 'Runtime is ready',\n    '硬件加速已启用': 'Hardware acceleration is enabled',\n    '需要部署': 'Deployment required',\n    '未下载': 'Not downloaded',\n    '安装失败': 'Installation failed',\n    '启动失败': 'Startup failed',\n    '保存失败': 'Save failed',\n    '导入失败': 'Import failed',\n    '导出失败': 'Export failed',\n    '清理失败': 'Cleanup failed',\n    '重置失败': 'Reset failed',\n    '卸载失败': 'Uninstall failed',\n    '更新失败': 'Update failed',\n    '兼容性': 'Compatibility',\n    '无限制': 'Unlimited',\n    '自动': 'Automatic',\n    '标准': 'Standard',\n    '特大': 'Extra large',\n    '关闭': 'Off',\n    '开启': 'On',\n    '全部': 'All',\n    '默认': 'Default',\n    '分钟': 'minutes',\n    '下次重启安卓运行时后生效': 'Takes effect after the Android runtime restarts',\n    '重启运行时后生效': 'Takes effect after the runtime restarts',\n    '下次重启生效': 'Takes effect after the next restart',\n    '安装完成后会自动生成桌面图标，双击即以独立窗口运行，和普通 Windows 软件一样。':\n      'After installation a desktop launcher is created; double-click it to run the app in its own window.',\n    '已注册 .apk 关联时，在资源管理器里双击 APK 也会直接装到 ApkStart。':\n      'When .apk association is enabled, double-clicking an APK in the file manager installs it with ApkStart.',\n    '把报告发给作者可以最快定位问题': 'Sending the report helps diagnose the problem quickly',\n    '统计不可用': 'Statistics unavailable',\n    '使用手册（含故障解决方案）': 'User guide with troubleshooting',\n    '下次更新不再自动弹出': 'Do not show again on next update',\n    // Additional settings and status vocabulary\n    '未连接运行时': 'Runtime not connected',\n    'ApkStart 已就绪': 'ApkStart is ready',\n    '运行时与环境': 'Runtime and environment',\n    '正在检查…': 'Checking…',\n    '全自动：无需选择镜像、无需启用加速、无需调内存':\n      'Fully automatic: no image selection, acceleration setup or memory tuning needed',\n    '本机自适应参数': 'Adaptive settings for this machine',\n    '内存、核心数、渲染后端、端口、加速方式全部自动选择；启动失败会自动降级重试，不需要手动改。':\n      'Memory, cores, renderer, ports and acceleration are chosen automatically, with automatic fallback on failure.',\n    '磁盘总占用（运行时 + 安卓数据 + 缓存）': 'Total disk usage (runtime + Android data + cache)',\n    '正在统计…': 'Calculating…',\n    '清理可回收文件': 'Clean reclaimable files',\n    '清理旧版本残留': 'Remove leftovers from older versions',\n    '修复网络': 'Repair network',\n    '重置安卓数据': 'Reset Android data',\n    '我已安装完成': 'Installation finished',\n    '稍后再说': 'Later',\n    '自动模式（默认，无需设置）': 'Automatic mode (default, no setup needed)',\n    '应用窗口': 'Application window',\n    '显示模式': 'Display mode',\n    '竖屏窗口（可自由拉伸，记住每个应用的大小）': 'Portrait window (resizable, remembers size per app)',\n    '全屏（铺满屏幕，保持手机比例两侧留黑）': 'Fullscreen (fills height, keeps phone aspect ratio)',\n    '关闭（按上面选的显示模式走）': 'Off (follows the display mode above)',\n    '打开 · 每次启动应用都自动全屏': 'On · every app starts fullscreen',\n    '屏幕方向': 'Screen orientation',\n    '跟随应用（推荐 · 自动选横竖屏，画面铺满不留黑边）': 'Follow app (recommended, no letterboxing)',\n    '强制竖屏（手机比例，适合刷短视频、看小说）': 'Force portrait (phone aspect, for video and reading)',\n    '强制横屏（宽屏铺满，适合看剧、玩游戏）': 'Force landscape (wide, for video and games)',\n    '当前面板方向': 'Current panel orientation',\n    '竖屏面板': 'Portrait panel',\n    '横屏面板': 'Landscape panel',\n    '镜像自动旋转': 'Auto-rotate in guest',\n    '打开（默认）· 系统设置里显示自动旋转已开启': 'On by default · auto-rotate is enabled in guest settings',\n    '关闭 · 回到旧的锁定行为': 'Off · restores the locked behaviour',\n    '平板排版': 'Tablet layout',\n    '打开（推荐 · 逻辑密度 190dpi，sw606dp 走平板排版）': 'On (recommended, 190dpi tablet layout)',\n    '关闭（镜像默认密度，手机排版）': 'Off (image default, phone layout)',\n    '窗口承载方式': 'Window hosting',\n    '原生窗口（默认·推荐）· 模拟器自己开窗口，帧率与缩放最稳': 'Native window (default) · the emulator draws its own window',\n    '嵌入模式 · 安卓画面嵌在 ApkStart 窗口里，标题栏带旋转按钮':\n      'Embedded · Android is drawn inside the ApkStart window',\n    '竖屏画面大小': 'Portrait render size',\n    '小 · 720 × 1280': 'Small · 720 × 1280',\n    '中 · 900 × 1600': 'Medium · 900 × 1600',\n    '大 · 1080 × 1920': 'Large · 1080 × 1920',\n    '超大 · 1440 × 2560': 'Extra large · 1440 × 2560',\n    '窗口模式下可拖动边框任意缩放；这里调的是 Android 内部渲染尺寸，越小越省性能。':\n      'In window mode you can resize by dragging; this sets the internal Android render size.',\n    '鼠标键位': 'Mouse buttons',\n    '键盘映射': 'Key mapping',\n    '游戏手柄': 'Gamepad',\n    '资源占用': 'Resource usage',\n    '磁盘占用': 'Disk usage',\n    '缓存': 'Cache',\n    '日志': 'Logs',\n    '重置': 'Reset',\n    '清除': 'Clear',\n    '全机共享': 'Shared system-wide',\n    '差分层': 'Overlay layer',\n    '开始菜单': 'Start menu',\n    '桌面图标': 'Desktop icon',\n    '数据互通': 'File sharing',\n    '共享目录': 'Shared folder',\n    '开机自动启动': 'Start with the system',\n    '托盘': 'System tray',\n    '软件更新': 'Software update',\n    '检查更新': 'Check for updates',\n    '当前版本': 'Current version',\n    '最新版本': 'Latest version',\n    '发布页': 'Release page',\n    '反馈': 'Feedback',\n    '关于': 'About',\n    '许可': 'License',\n    '作者': 'Author',\n    '诊断报告': 'Diagnostic report',\n    '导出': 'Export',\n    '导入': 'Import',\n    '高级参数': 'Advanced options',\n    '恢复默认': 'Restore defaults',\n    '下载': 'Download',\n    '上传': 'Upload',\n    '速度': 'Speed',\n    '剩余': 'Remaining',\n    '暂停': 'Pause',\n    '继续': 'Continue',\n    '重试': 'Retry',\n    '完成': 'Done',\n    '跳过': 'Skip',\n    '全选': 'Select all',\n    '应用列表': 'Application list',\n    '已安装应用': 'Installed applications',\n    '上次使用': 'Last used',\n    '启动次数': 'Launch count',\n    '版本': 'Version',\n    '大小': 'Size',\n    '路径': 'Path',\n    '包名': 'Package name',\n    // On-screen keyboard control\n    '安卓软键盘': 'On-screen keyboard',\n    '默认关闭：直接用电脑键盘输入。需要屏幕键盘时再打开。':\n      'Off by default: type with the computer keyboard. Turn on for a touch keyboard.',\n    '安卓软键盘已开启，点输入框会弹出': 'On-screen keyboard on; it appears when you tap an input field',\n    '安卓软键盘已关闭，直接用电脑键盘输入': 'On-screen keyboard off; type with the computer keyboard',\n    // Glossary used when a whole sentence has no exact translation.\n    '自动检测': 'Auto-check', '自动': 'automatic', '运行': 'run', '运行时': 'runtime',\n    '失败': 'failed', '启动': 'start', '安装': 'install', '打开': 'open', '镜像': 'image',\n    '安卓': 'Android', '窗口': 'window', '系统': 'system', '数据': 'data', '目录': 'folder',\n    '问题': 'issue', '更新': 'update', '文件': 'file', '重启': 'restart', '正在': '',\n    '检测': 'check', '下载': 'download', '诊断': 'diagnostics', '没有': 'no', '加速': 'acceleration',\n    '版本': 'version', '修复': 'fix', '模拟': 'emulat', '兼容': 'compatibility', '关闭': 'off',\n    '桌面': 'desktop', '需要': 'requires', '图标': 'icon', '直接': 'directly', '完成': 'done',\n    '提示': 'notice', '显示': 'show', '生效': 'takes effect', '虚拟': 'virtual', '当前': 'current',\n    '会自动': 'automatically', '模拟器': 'emulator', '重试': 'retry', '系统镜像': 'system image',\n    '软件': 'software', '方式': 'mode', '面板': 'panel', '方向': 'orientation', '内存': 'memory',\n    '模式': 'mode', '报告': 'report', '按钮': 'button', '驱动': 'driver', '用户': 'user',\n    '下次': 'next', '快捷方式': 'shortcut', '硬件': 'hardware', '程序': 'program', '声音': 'sound',\n    '硬件加速': 'hardware acceleration', '教程': 'guide', '网络': 'network', '旋转': 'rotation',\n    '双击': 'double-click', '检查': 'check', '状态': 'status', '虚拟机': 'virtual machine',\n    '本机': 'this machine', '手动': 'manual', '卸载': 'uninstall', '切换': 'switch', '使用': 'use',\n    '安卓数据': 'Android data', '重置': 'reset', '默认': 'default', '诊断报告': 'diagnostic report',\n    '首次': 'first', '横屏': 'landscape', '竖屏': 'portrait', '确认': 'confirm', '商店': 'store',\n    '启用': 'enable', '磁盘': 'disk', '保留': 'keep', '关掉': 'turn off', '处理': 'handle',\n    '体检': 'health check', '分类': 'category', '一键': 'one-click', '分区': 'partition',\n    '已装': 'installed', '日志': 'logs', '重建': 'rebuild', '影响': 'affect', '后台': 'background',\n    '内置': 'built-in', '手册': 'manual', '开始': 'start', '清理': 'clean', '支持': 'support',\n    '如果': 'if', '或者': 'or', '并且': 'and', '但是': 'but', '因为': 'because', '所以': 'so',\n    '可以': 'can', '不能': 'cannot', '不会': 'will not', '没有': 'no', '这个': 'this', '那个': 'that',\n    '点击': 'click', '选择': 'select', '输入': 'input', '输出': 'output', '连接': 'connect',\n    '服务': 'service', '端口': 'port', '加速': 'acceleration', '安装完成': 'installation complete',\n    '等待': 'waiting', '准备': 'prepare', '进度': 'progress', '失败原因': 'failure reason',\n    '未知': 'unknown', '禁用': 'disable', '允许': 'allow', '拒绝': 'deny', '高级': 'advanced',\n    '搜索': 'search', '清除': 'clear', '保存': 'save', '取消': 'cancel', '确定': 'OK',\n    '重试': 'retry', '跳过': 'skip', '继续': 'continue', '暂停': 'pause', '完成': 'complete',\n    '时间': 'time', '大小': 'size', '速度': 'speed', '剩余': 'remaining', '路径': 'path',\n    '桌面图标': 'desktop shortcut', '开始菜单': 'Start menu', '快捷': 'shortcut',\n    '性能': 'performance', '资源': 'resources', '占用': 'usage', '优化': 'optimise',\n    '省电': 'power saving', '优先级': 'priority', '核心': 'cores', '显卡': 'GPU',\n    '画质': 'quality', '分辨率': 'resolution', '密度': 'density', '键盘': 'keyboard',\n    '鼠标': 'mouse', '手柄': 'gamepad', '触控': 'touch', '按键': 'key', '映射': 'mapping',\n    '预设': 'preset', '自定义': 'custom', '模板': 'template', '应用卡片': 'app card',\n    '右键': 'right-click', '左键': 'left-click', '滚轮': 'scroll wheel', '侧键': 'side button',\n    '滑动': 'swipe', '拖动': 'drag', '返回': 'back', '全屏': 'fullscreen', '窗口模式': 'window mode',\n    '铺满': 'fill', '比例': 'aspect ratio', '黑边': 'letterboxing', '自动旋转': 'auto-rotate',\n    '语言': 'language', '地区': 'region', '日期': 'date', '时间': 'time', '音量': 'volume',\n    '字体': 'font', '动画': 'animations', '后台进程': 'background processes', '白名单': 'whitelist',\n    '共享': 'shared', '文件夹': 'folder', '权限': 'permissions', '授权': 'grant',\n    '卸载': 'uninstall', '清除数据': 'clear data', '数据互通': 'file sharing',\n    '发行版': 'release', '通道': 'channel', '源': 'source', '镜像站': 'mirror', '代理': 'proxy',\n    '日志': 'logs', '导出': 'export', '导入': 'import', '反馈': 'feedback', '关于': 'about',\n    '许可': 'license', '作者': 'author', '官网': 'website', '发布页': 'release page',\n    // Status bar and app grid fragments. The glossary approach translates a\n    // whole sentence only when it has an exact entry; without these terms the\n    // longest-first pass leaves mixed Chinese/English phrases such as\n    // \"独立window已Enable\", which are hard to read in the English UI.\n    '独立窗口已启用': 'detached window enabled',\n    '运行时已就绪': 'Runtime is ready',\n    '网络正常': 'Network OK',\n    '添加应用': 'Add app',\n    '拖入 APK 即可安装': 'Drop an APK to install',\n    '个应用': ' apps',\n    '下次重启运行时生效': 'Takes effect after the next runtime restart',\n    '下次启动安卓运行时生效': 'Applies on the next Android runtime start',\n    '下次打开应用生效': 'Applies the next time an app opens',\n    '下次打开应用时生效': 'Applies the next time an app opens',\n    '下次打开应用会多花十几秒': 'The next app launch takes a few seconds longer',\n  };\n\n  const done = new WeakSet();\n  const attrs = ['title', 'placeholder', 'aria-label', 'alt'];\n  // Longest keys first, otherwise a short term can break a longer phrase.\n  const TERMS = Object.entries(DICT).sort((a, b) => b[0].length - a[0].length);\n\n  function translateText(value) {\n    const s = String(value || '');\n    if (!/[\\u4e00-\\u9fff]/.test(s)) return s;\n    if (DICT[s]) return DICT[s];\n    let out = s;\n    for (const [zh, en] of TERMS) {\n      if (out.includes(zh)) out = out.split(zh).join(en);\n    }\n    // Reject partial translations. Replacing a few glossary terms in a long\n    // sentence previously produced fragments such as \"独立window已Enable\",\n    // which are harder to read than the original Chinese. Keep a string in its\n    // source language unless every Chinese character was covered by a term or\n    // an exact dictionary entry.\n    if (/[\\u4e00-\\u9fff]/.test(out)) return s;\n    return out;\n  }\n\n  function walk(root) {\n    if (!root || done.has(root)) return;\n    done.add(root);\n    const nodeIterator = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);\n    const targets = [];\n    while (nodeIterator.nextNode()) targets.push(nodeIterator.currentNode);\n    for (const node of targets) {\n      if (node.nodeType === 3) {\n        if (node.nodeValue && /[\\u4e00-\\u9fff]/.test(node.nodeValue)) {\n          const next = translateText(node.nodeValue);\n          if (next !== node.nodeValue) node.nodeValue = next;\n        }\n      } else if (node.nodeType === 1) {\n        for (const a of attrs) {\n          const v = node.getAttribute && node.getAttribute(a);\n          if (v && /[\\u4e00-\\u9fff]/.test(v)) node.setAttribute(a, translateText(v));\n        }\n        if (node.tagName === 'BUTTON' && node.childNodes.length === 1\n            && node.firstChild.nodeType === 3 && /[\\u4e00-\\u9fff]/.test(node.firstChild.nodeValue)) {\n          node.firstChild.nodeValue = translateText(node.firstChild.nodeValue);\n        }\n      }\n    }\n  }\n\n  function install() {\n    document.documentElement.lang = 'en';\n    walk(document.body);\n    const observer = new MutationObserver((records) => {\n      for (const r of records) {\n        for (const n of r.addedNodes) {\n          if (n.nodeType === 1) walk(n);\n          else if (n.nodeType === 3 && /[\\u4e00-\\u9fff]/.test(n.nodeValue || '')) {\n            n.nodeValue = translateText(n.nodeValue);\n          }\n        }\n      }\n    });\n    observer.observe(document.body, { childList: true, subtree: true, characterData: true });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', install);\n  } else {\n    install();\n  }\n  window.ApkStartI18n = { translateText, install };\n})();\n"},"headersSize":195,"bodySize":19856,"redirectURL":"","_transferSize":20051},"cache":{},"timings":{"dns":0.051,"connect":0.079,"ssl":137.259,"send":0,"wait":2.06,"receive":1.553},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4412.81,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.529Z","time":141.04999999999998,"request":{"method":"GET","url":"http://127.0.0.1:8765/app.js","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":361,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"text/javascript"},{"name":"Content-Length","value":"123657"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":123657,"mimeType":"text/javascript","compression":0,"text":"'use strict';\n\nconst api = window.apkstart;\nconst $ = (id) => document.getElementById(id);\n\nconst state = {\n  apps: [],\n  settings: null,\n  status: null,\n  filter: '',\n  installing: false,\n  setupBusy: null,\n  menuPkg: null,\n};\n\n/* ---------------- 工具 ---------------- */\n\nfunction esc(s) {\n  return String(s == null ? '' : s).replace(/[&<>\"']/g, (c) => (\n    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]\n  ));\n}\n\nfunction initialOf(label) {\n  const t = String(label || '?').trim();\n  return (t[0] || '?').toUpperCase();\n}\n\nfunction fmtSize(bytes) {\n  if (!bytes) return '';\n  const mb = bytes / 1024 / 1024;\n  return mb >= 1024 ? `${(mb / 1024).toFixed(1)} GB` : `${mb.toFixed(0)} MB`;\n}\n\nfunction relTime(ts) {\n  if (!ts) return '';\n  const d = Date.now() - ts;\n  if (d < 60000) return '刚刚';\n  if (d < 3600000) return `${Math.floor(d / 60000)} 分钟前`;\n  if (d < 86400000) return `${Math.floor(d / 3600000)} 小时前`;\n  if (d < 86400000 * 30) return `${Math.floor(d / 86400000)} 天前`;\n  return new Date(ts).toLocaleDateString('zh-CN');\n}\n\n/**\n * 迷你 toast\n *\n * 同一类消息做去重 + 数量上限：\n * 安装失败时里面有「运行时启动日志」在持续推送，以前每条都新建一个 toast，\n * 于是屏幕上会不停叠加同一条错误，看起来像「失败信息一直循环」。\n */\nlet _toastSeq = 0;\nfunction toast({ title, body = '', type = 'info', progress = null, sticky = false, spinner = false }) {\n  const wrap = $('toastWrap');\n  // ① 去重：同样的标题 + 正文（4 秒内）只刷新那一条，不叠加\n  const key = `${title}|${body}`;\n  const dup = [...wrap.children].find((n) => n.dataset.key === key && Date.now() - Number(n.dataset.at || 0) < 4000);\n  if (dup) {\n    dup.dataset.at = String(Date.now());\n    return {\n      el: dup,\n      dismiss: () => dup.remove(),\n      update: ({ title: t2, body: b2 } = {}) => {\n        if (t2 !== undefined) dup.querySelector('.t-title-text').textContent = t2;\n        if (b2 !== undefined) dup.querySelector('.t-body').textContent = b2;\n      },\n    };\n  }\n  // ② 上限：同时最多 4 条，超出先挤掉最旧的\n  while (wrap.children.length >= 4) wrap.firstElementChild.remove();\n\n  const el = document.createElement('div');\n  el.className = `toast ${type === 'error' ? 'error' : ''}`;\n  el.dataset.key = key;\n  el.dataset.at = String(Date.now());\n  el.dataset.seq = String(++_toastSeq);\n  el.innerHTML = `\n    <div class=\"t-title\">\n      ${spinner ? '<span class=\"spinner\"></span>' : ''}\n      <span class=\"t-title-text\">${esc(title)}</span>\n    </div>\n    <div class=\"t-body\">${esc(body)}</div>\n    ${progress === null ? '' : '<div class=\"bar\"><i></i></div>'}\n  `;\n  $('toastWrap').appendChild(el);\n\n  const dismiss = () => {\n    el.style.transition = 'opacity .18s, transform .18s';\n    el.style.opacity = '0';\n    el.style.transform = 'translateY(4px)';\n    setTimeout(() => el.remove(), 200);\n  };\n\n  const ctl = {\n    el, dismiss,\n    update({ title: t2, body: b2, progress: p2, type: ty } = {}) {\n      if (t2 !== undefined) el.querySelector('.t-title-text').textContent = t2;\n      if (b2 !== undefined) el.querySelector('.t-body').textContent = b2;\n      if (p2 !== undefined && el.querySelector('.bar i')) {\n        el.querySelector('.bar i').style.width = `${Math.max(2, Math.min(100, p2))}%`;\n      }\n      if (ty === 'error') el.classList.add('error');\n      if (ty === 'ok') {\n        el.querySelector('.spinner')?.remove();\n        el.classList.remove('error');\n      }\n    },\n  };\n\n  if (!sticky) setTimeout(dismiss, type === 'error' ? 6000 : 3200);\n  return ctl;\n}\n\n/* ---------------- 内置手册 ---------------- */\n\n/** 打开内置手册；传故障信息时由主进程映射到对应章节 */\nfunction openManual(payload) {\n  if (!api || typeof api.openManual !== 'function') return Promise.resolve(null);\n  return api.openManual(payload || { topic: 'overview' }).catch(() => null);\n}\n\n/** 自动检测问题 → 对应教程。reason 只影响主进程的去重策略。 */\nfunction openManualForIssue(issue, reason = 'clicked') {\n  if (!issue) return openManual({ topic: 'overview', reason });\n  return openManual({\n    issue: issue.code,\n    title: issue.title,\n    detail: issue.detail,\n    reason,\n  });\n}\n\n/** 安装/运行原始报错 → 对应教程 */\nfunction openManualForError(message, reason = 'install-failed') {\n  return openManual({ error: message, reason });\n}\n\n/* ---------------- 渲染 ---------------- */\n\nfunction visibleApps() {\n  const q = state.filter.trim().toLowerCase();\n  if (!q) return state.apps;\n  return state.apps.filter((a) => (\n    a.label.toLowerCase().includes(q)\n    || a.package.toLowerCase().includes(q)\n  ));\n}\n\nfunction renderGrid() {\n  const apps = visibleApps();\n  const grid = $('grid');\n  const empty = $('empty');\n\n  const hasAny = state.apps.length > 0;\n  grid.classList.toggle('hidden', apps.length === 0);\n  empty.classList.toggle('hidden', apps.length > 0);\n\n  if (!hasAny) {\n    const s = state.status;\n    $('emptyHint').textContent = s && s.adbOk === false\n      ? '首次使用：打开右上角设置 → 运行时 → 一键完成，再回来安装应用即可。'\n      : '提示：所有应用共享同一个 Android 运行时，所以第二个应用的启动几乎是瞬时的。';\n    grid.innerHTML = '';\n    return;\n  }\n\n  // 末尾放一块「添加应用」虚线卡片。\n  // 目的不只是好看：应用少的时候下面是一大片空白，用户不知道该干什么；\n  // 这块卡片把「还能拖 APK 进来」这件事直接摆在眼前，也顺手填掉了空白。\n  grid.innerHTML = apps.map((a) => `\n    <div class=\"card\" data-pkg=\"${esc(a.package)}\" title=\"${esc(a.label)} · ${esc(a.package)}\">\n      ${a.pinned ? '<span class=\"pin\">★</span>' : ''}\n      ${a.running ? '<span class=\"badge-run\" title=\"正在运行\"></span>' : ''}\n      <div class=\"icon\">\n        ${a.iconUrl\n          ? `<img src=\"${esc(a.iconUrl)}\" alt=\"\" draggable=\"false\" />`\n          : `<div class=\"fallback\" style=\"background:${esc(a.accent || '#9aa6b2')}\">${esc(initialOf(a.label))}</div>`}\n      </div>\n      <div class=\"name\">${esc(a.label)}</div>\n      <div class=\"meta\">${a.running ? '运行中' : `v${esc(a.versionName)}${a.lastLaunchAt ? ' · ' + relTime(a.lastLaunchAt) : ''}`}</div>\n      <div class=\"open-hint\">${a.running ? '切换到前台' : '打开'}</div>\n    </div>\n  `).join('') + `\n    <div class=\"card card-add\" id=\"cardAdd\" role=\"button\" tabindex=\"0\" title=\"拖入 APK 文件，或点击选择\">\n      <div class=\"add-plus\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\n             stroke-linecap=\"round\"><path d=\"M12 6v12\"/><path d=\"M6 12h12\"/></svg>\n      </div>\n      <div class=\"name\">添加应用</div>\n      <div class=\"meta\">拖入 APK 即可安装</div>\n    </div>\n  `;\n}\n\n/* ---------------- 数据刷新 ---------------- */\n\nasync function refreshApps() {\n  try {\n    state.apps = await api.listApps();\n    renderGrid();\n    updateStats();\n  } catch (e) {\n    console.error(e);\n  }\n}\n\nfunction updateStats() {\n  const n = state.apps.length;\n  $('statusStats').textContent = n ? `${n} 个应用` : '暂无应用';\n}\n\nasync function refreshStatus() {\n  try {\n    state.status = await api.runtimeStatus();\n    const s = state.status;\n    const dot = $('statusDot');\n    const text = $('statusText');\n    const tag = $('engineTag');\n\n    if (!s.adbOk) {\n      dot.className = 'dot err';\n      text.textContent = '运行时未部署 —— 打开设置 → 运行时，一键完成';\n      tag.textContent = '需要部署';\n      tag.className = 'brand-tag';\n    } else if (s.deviceOnline) {\n      dot.className = 'dot ok';\n      text.textContent = `运行时已就绪 · Android ${s.android || '?'}${s.freeform ? ' · 独立窗口已启用' : ''}`;\n      tag.textContent = `Android ${s.android || ''}`.trim();\n      tag.className = 'brand-tag ok';\n    } else if (s.phase === 'booting' || s.vmStarting) {\n      dot.className = 'dot warn';\n      text.textContent = '正在引导 Android…';\n      tag.textContent = '引导中';\n      tag.className = 'brand-tag';\n    } else if (s.needsSetup === 'accel') {\n      dot.className = 'dot warn';\n      // 说清「怎么修」而不是只说「没开」——这句是状态条上最容易被看到的位置\n      text.textContent = '未启用硬件加速：已回退软件模拟（很慢）。点右下角「环境自检 → 修复」开启';\n      tag.textContent = '软件模拟';\n      tag.className = 'brand-tag';\n    } else if (s.needsSetup === 'sysimg') {\n      dot.className = 'dot err';\n      text.textContent = '缺少 Android 14 通用系统镜像 —— 设置 → 运行时里下载（约 1.5GB，只下一次）';\n      tag.textContent = '待下载镜像';\n      tag.className = 'brand-tag';\n    } else if (s.needsSetup === 'emulator') {\n      dot.className = 'dot err';\n      text.textContent = '运行时引擎未安装 —— 打开设置 → 运行时一键完成';\n      tag.textContent = '需要部署';\n      tag.className = 'brand-tag';\n    } else if (s.needsSetup === 'boot') {\n      dot.className = 'dot warn';\n      text.textContent = '运行时已就绪 —— 安装 APK 或双击桌面图标会自动开机';\n      tag.textContent = '待开机';\n      tag.className = 'brand-tag';\n    } else if (s.installing) {\n      dot.className = 'dot warn';\n      text.textContent = '安装程序运行中 —— 请在虚拟机窗口里完成安装';\n      tag.textContent = '安装中';\n      tag.className = 'brand-tag';\n    } else {\n      dot.className = 'dot';\n      text.textContent = s.installed\n        ? '运行时待机（安装或打开应用时会自动拉起）'\n        : '运行时尚未安装 Android 系统 —— 打开设置 → 运行时继续';\n      tag.textContent = s.installed ? '待机' : '待安装';\n      tag.className = 'brand-tag';\n    }\n    $('statusDevice').textContent = s.deviceOnline ? (s.serial || '') : '';\n    // 网络状态：这是用户最容易踩的坑（应用里一直「网络错误」，但看不出是虚拟机没网）。\n    // 直接摆在状态栏，出问题时一眼能看到，不用去翻日志。\n    const netEl = $('statusNet');\n    const netSep = $('statusNetSep');\n    if (netEl) {\n      const show = !!s.deviceOnline && !!s.network;\n      netEl.hidden = !show;\n      if (netSep) netSep.hidden = !show;\n      if (show) {\n        netEl.textContent = s.network.ok ? `网络正常 ${s.network.ip || ''}`.trim() : '虚拟机未联网';\n        netEl.className = 'status-item status-net ' + (s.network.ok ? 'ok' : 'warn');\n        netEl.title = s.network.ok\n          ? '安卓虚拟机已联网，联网类应用可以正常加载'\n          : '安卓虚拟机没有网络，联网页面会一直是空白/报错。可在「设置 → 修复网络」处理';\n      }\n    }\n\n    renderSetup(s);\n  } catch (e) {\n    $('statusText').textContent = `状态检查失败：${e.message}`;\n  }\n}\n\n/* ---------------- 运行时部署（固定在设置里） ---------------- */\n\n/**\n * 运行时/部署/自检面板现在都收在「设置」里，主界面只留已安装应用。\n * 保留 showSetup 给托盘菜单与 ui:navigate 复用，语义改为「打开设置并定位到运行时」。\n */\nfunction showSetup(on) {\n  if (!on) { $('setupGuide').hidden = true; return; }\n  openSettings().then(() => {\n    focusGroup($('runtimeGroup'));\n  }).catch(() => {});\n}\n\nfunction fmtGB(n) { return n ? `${(n / 1073741824).toFixed(2)} GB` : ''; }\n\nfunction stepRow(opt) {\n  const cls = ['step'];\n  if (opt.done) cls.push('done');\n  if (opt.busy) cls.push('busy');\n  return `\n    <div class=\"${cls.join(' ')}\" data-step=\"${opt.key}\">\n      <div class=\"idx\">${opt.done ? '✓' : opt.index}</div>\n      <div class=\"body\">\n        <div class=\"t\">${esc(opt.title)}${opt.tag ? `<span class=\"tag ${opt.req ? 'req' : ''}\">${esc(opt.tag)}</span>` : ''}</div>\n        <div class=\"d\" data-desc>${esc(opt.desc)}</div>\n        <div class=\"bar\"><i data-bar></i></div>\n      </div>\n      <div class=\"act\">${opt.actions || ''}</div>\n    </div>`;\n}\n\nfunction renderSetup(s) {\n  if (!s) return;\n  const env = s.env || {};\n  const hv = env.hypervisor || {};\n  const accel = env.accel || s.accel || {};\n\n  // 启动即见已安装应用：不再用部署向导整屏接管主界面，\n  // 状态只在设置里的运行时面板 + 底部状态条上体现。\n  const accelOk = accel.ok || hv.whpx;\n  const adbDone = !!(env.adb && env.adb.ok);\n  const emuDone0 = !!(env.emulator && env.emulator.ok);\n  const imgDone0 = !!(env.sysimg && env.sysimg.ok);\n  const allDone0 = adbDone && emuDone0 && imgDone0;\n  const stateText = $('setupStateText');\n  if (stateText) {\n    const missing = [];\n    if (!adbDone) missing.push('adb');\n    if (!emuDone0) missing.push('引擎');\n    if (!imgDone0) missing.push('系统镜像');\n    stateText.textContent = s.deviceOnline\n      ? `已就绪 · Android ${s.android || ''}`\n      : s.phase === 'booting' || s.vmStarting\n        ? '正在引导 Android…'\n        : allDone0\n          ? '组件齐全 · 待开机（打开应用时自动拉起）'\n          : `缺少 ${missing.join('、')}${accelOk ? '' : '（无硬件加速，将回退软件模拟）'}`;\n    stateText.title = s.autoProfile || accel.note || hv.note || '';\n  }\n\n  const emuDone = !!(env.emulator && env.emulator.ok);\n  const imgDone = !!(env.sysimg && env.sysimg.ok);\n  const busy = state.setupBusy;\n  const booting = s.phase === 'booting';\n\n  // 只保留一个步骤：下载、参数自适应、开机全部由「一键完成」串起来，\n  // 且首次启动会在后台自动跑，用户不需要逐步点击。\n  const allDone = !!(env.adb && env.adb.ok) && emuDone && imgDone;\n  const left = [];\n  if (!(env.adb && env.adb.ok)) left.push('adb 工具链');\n  if (!emuDone) left.push('Android 运行时');\n  if (!imgDone) left.push('系统镜像');\n  const step = {\n    key: 'all',\n    index: 1,\n    title: allDone ? '一切就绪' : '一键完成',\n    tag: allDone ? '已自动完成' : '自动',\n    done: allDone,\n    busy: !!busy,\n    desc: s.deviceOnline\n      ? `Android ${s.android || ''} 已就绪 · 应用窗口会按屏幕自动适配`\n      : booting\n        ? '正在引导 Android…'\n        : allDone\n          ? '组件齐全，双击任意 APK 或桌面图标即会自动开机'\n          : `还差 ${left.join('、')}；点下面「一键完成」，会在后台一次装好并自动开机`,\n    actions: s.deviceOnline\n      ? '<button class=\"btn ghost sm\" data-act=\"vmStop\">停止运行时</button>'\n      : '',\n  };\n\n  $('setupSteps').innerHTML = stepRow(step);\n  $('btnDeployAll').disabled = !!busy;\n  $('btnDeployAll').textContent = busy ? '准备中…' : (allDone ? '已完成 · 点此复查' : '一键完成');\n  // 「上次为什么没起来」优先显示落盘的失败记录：进程重启后内存里的 diagnosis 是空的，\n  // 只显示 autoProfile 会让用户完全看不出原因（issue #20/#25 的报告就是这样）。\n  const lf = s.lastFailure;\n  const lastMsg = (lf && lf.diagnosis && lf.diagnosis.title)\n    ? `上次启动失败：${lf.diagnosis.title}`\n    : (s.diagnosis ? `上次启动自动诊断：${s.diagnosis.title}` : '');\n  $('setupNote').textContent = lastMsg\n    || s.autoProfile || '全自动：无需选择镜像、无需启用加速、无需调内存';\n}\n\nfunction store_getDiskSize() {\n  return (state.settings && state.settings.runtime && state.settings.runtime.diskSizeGB) || 24;\n}\n\nfunction setStepBusy(key, on) {\n  state.setupBusy = on ? key : null;\n  // 五步已合并成一行，所有子步骤的进度都落在这唯一的进度条上\n  const row = $('setupSteps').querySelector('[data-step=\"all\"]');\n  if (row) {\n    row.classList.toggle('busy', !!on);\n    if (on) {\n      const bar = row.querySelector('[data-bar]');\n      if (bar) bar.style.width = '3%';\n    }\n  }\n}\n\nfunction updateStepProgress(component, p) {\n  if (!component) return;\n  const row = $('setupSteps').querySelector('[data-step=\"all\"]');\n  if (!row) return;\n  if (p.percent !== undefined) {\n    const bar = row.querySelector('[data-bar]');\n    if (bar) bar.style.width = `${Math.max(3, Math.min(100, p.percent))}%`;\n  }\n  if (p.message) {\n    const d = row.querySelector('[data-desc]');\n    if (d) d.textContent = p.message;\n  }\n}\n\nasync function deployAll() {\n  if (state.setupBusy) return;\n  setStepBusy('all', true);\n  try {\n    // 一次调用把 adb / 引擎 / 系统镜像全装完，进度统一显示在唯一那一行\n    // 用户点「一键部署」属于明确的手动重试，绕过失败冷却\n    const r = await api.autoDeploy({ force: true });\n    if (!r || !r.ok) {\n      toast({ title: '准备失败', body: (r && r.error) || '请检查网络后重试', type: 'error', sticky: true });\n      return;\n    }\n    await refreshStatus();\n    toast({ title: '组件已就绪，正在自动开机…', body: '首次约 1-3 分钟，之后几秒即可。', type: 'info' });\n    const started = await api.runtimeStart();\n    await refreshStatus();\n    toast(started && started.ok\n      ? { title: '运行时已就绪', body: '现在把 APK 拖进窗口，或双击桌面图标即可。', type: 'ok' }\n      : { title: '开机未完成', body: (started && started.error) || '请导出诊断报告查看原因', type: 'error', sticky: true });\n  } catch (e) {\n    toast({ title: '准备失败', body: e.message, type: 'error', sticky: true });\n  } finally {\n    setStepBusy('all', false);\n    await refreshStatus();\n    selfCheck();\n  }\n}\n\nasync function runStep(key) {\n  if (state.setupBusy) return { ok: false, error: '已有部署任务进行中' };\n  setStepBusy(key, true);\n  let r;\n  try {\n    if (key === 'adb') r = await api.installAdb();\n    else if (key === 'emulator') r = await api.installEmulator();\n    else if (key === 'sysimg') r = await api.installSysimg();\n    else if (key === 'accel') {\n      const t = toast({\n        title: '正在安装硬件加速驱动…',\n        body: '请在弹出的是否允许窗口点「是」',\n        sticky: true,\n        spinner: true,\n      });\n      r = await api.enableAccel();\n      if (r.ok) t.update({ title: '硬件加速已启用', type: 'ok' });\n      else t.update({ title: '加速未启用', body: r.error, type: 'error', sticky: true });\n    } else if (key === 'qemu') r = await api.installQemu();\n    else if (key === 'iso') r = await api.downloadIso();\n    else if (key === 'disk') r = await api.createDisk(store_getDiskSize());\n    else r = { ok: false, error: '未知步骤' };\n  } catch (e) {\n    r = { ok: false, error: e.message };\n  }\n  setStepBusy(key, false);\n  await refreshStatus();\n  return r;\n}\n\nasync function startInstall() {\n  const r = await api.startInstaller();\n  if (!r.ok) {\n    toast({ title: '无法启动安装环境', body: r.error, type: 'error', sticky: true });\n    return;\n  }\n  $('setupGuide').hidden = false;\n  $('setupGuide').scrollIntoView({ behavior: 'smooth', block: 'start' });\n  toast({ title: '虚拟机窗口已打开', body: '按下方 6 步完成安装；装好后点「我已安装完成」。', type: 'ok', sticky: true });\n}\n\nasync function markInstalled() {\n  await api.markInstalled();\n  await api.runtimeStop();\n  $('setupGuide').hidden = true;\n  await refreshStatus();\n  toast({ title: '安装完成，运行时已接管', body: '现在可以直接把 APK 拖进来安装了。', type: 'ok' });\n}\n\n\n\n/* ---------------- 安装 ---------------- */\n\n/** 把安装失败翻译成「下一步该做什么」，只对最常见的几种做提示，其它原样显示 */\nfunction friendlyInstallErrorText(msg) {\n  const s = String(msg || '未知错误');\n  if (/INSUFFICIENT_STORAGE|not enough space|空间不足|ENOSPC/i.test(s)) {\n    return `${s}\\n安卓数据分区不够用：设置 → 性能与资源占用 → 安卓数据分区调大后点「立即扩容」。`;\n  }\n  // 只有真正失败才走到这里：切换镜像是「进行中」的进度提示（install:progress），\n  // 绝不能在红色失败横幅里再说「正在重试」——那会让用户以为还在处理，其实是真的失败了。\n  if (/NO_MATCHING_ABIS/i.test(s)) {\n    return /已切换到.*仍然安装失败|abiRetried/i.test(s)\n      ? `${s}\\nARM 兼容镜像已启用仍装不上，请到「设置 → 诊断与修复」导出诊断报告反馈。`\n      : `${s}\\n这个包只有 ARM 库。程序会自动切到兼容镜像重装一次，请留意后续提示。`;\n  }\n  if (/INSTALL_FAILED_ALREADY_EXISTS|signatures do not match/i.test(s)) {\n    return `${s}\\n同包名但签名不同（常见于从别的渠道装过）。在应用卡片右键「卸载」后再装。`;\n  }\n  if (/INSTALL_FAILED_VERSION_DOWNGRADE/i.test(s)) return `${s}\\n已装版本更高，先在右键菜单里卸载再装。`;\n  if (/ERR_FS_FILE_TOO_LARGE|greater than possible Buffer|Cannot allocate|ENOMEM|out of memory/i.test(s)) {\n    return `${s}\\n这个安装包过大或内存不足，解析被系统拒绝了。请确认磁盘与内存充足后重试；`\n      + '仍失败请把安装包路径换成纯英文短路径（如 D:\\\\a.apk）。';\n  }\n  return s;\n}\n\n/* 当前那条「正在安装…」的 sticky 提示。install:error 事件要能把它收掉：\n * 主进程是先 send('install:error') 再让 invoke 失败的，两者都可能到得很晚，\n * 只靠 catch 收会出现「报错了右下角还在转圈」。 */\nlet installToast = null;\n\nasync function installFiles(paths) {\n  if (!paths || !paths.length) return;\n  if (state.installing) {\n    toast({ title: '已有安装任务在进行', body: '请等当前应用装完再继续。' });\n    return;\n  }\n  state.installing = true;\n  let ok = 0;\n  let failed = 0;\n\n  for (const p of paths) {\n    const name = p.split(/[\\\\/]/).pop();\n    const t = toast({ title: `正在安装 ${name}`, body: '解析 APK…', progress: 8, sticky: true, spinner: true });\n    installToast = t;\n    let off = () => {};\n    try {\n      off = api.on('install:progress', (pr) => {\n        const base = { parse: 12, 'parse-done': 24, runtime: 38, install: 62, shortcut: 88, done: 100 }[pr.stage] || 50;\n        const pct = pr.percent != null ? Math.min(60, Math.round((pr.percent / 100) * 60)) : base;\n        t.update({ title: pr.meta ? `正在安装 ${pr.meta.label}` : `正在安装 ${name}`, body: pr.message, progress: pct });\n      });\n      const r = await api.installApk(p);\n      t.update({ title: `${r.app.label} 已安装`, body: r.app.shortcutPath ? '桌面快捷方式已创建，双击即可直接打开。' : '可在应用卡片右键创建桌面快捷方式。', progress: 100, type: 'ok' });\n      t.el.querySelector('.spinner')?.remove();\n      setTimeout(t.dismiss, 3600);\n      if (r.warnings && r.warnings.length) {\n        toast({ title: `${r.app.label} 兼容性提示`, body: r.warnings.join(' '), type: 'error', sticky: false });\n      }\n      ok++;\n    } catch (e) {\n      failed++;\n      // 先把那条「正在安装…」的 sticky 提示收掉，否则它会一直转圈、还继续被\n      // 运行时日志刷新 —— 用户看到的就是「失败信息一直在循环」。\n      // 错误提示统一由下面的 install:error 监听器负责（带文件名与中文原因），\n      // 这里不再重复弹一条。\n      try { off(); } catch (_) { /* ignore */ }\n      t.dismiss();\n      if (installToast === t) installToast = null;\n    } finally {\n      try { off(); } catch (_) { /* ignore */ }\n    }\n  }\n\n  state.installing = false;\n  await refreshApps();\n  if (ok && !failed) $('search').value = '';\n}\n\n/* ---------------- 应用操作 ---------------- */\n\nasync function launchApp(pkg) {\n  const app = state.apps.find((a) => a.package === pkg);\n  state.launchPkg = pkg;\n  const t = toast({\n    title: `正在打开 ${app ? app.label : pkg}`,\n    body: '首次启动需要预热运行时，请稍候…',\n    sticky: true,\n    spinner: true,\n  });\n  const r = await api.launch(pkg);\n  if (r.ok) {\n    // 应用有自己的窗口，主界面自动收起；这里只留一句提示，然后隐藏窗口\n    t.update({ title: '已启动', body: '应用正在独立窗口中运行（顶部可旋转屏幕）。', type: 'ok' });\n    setTimeout(t.dismiss, 1600);\n    setTimeout(() => api.winHide(), 900);\n    setTimeout(refreshApps, 1200);\n  } else {\n    t.update({ title: '启动失败', body: r.error, type: 'error' });\n    setTimeout(t.dismiss, 6000);\n  }\n}\n\nasync function createShortcut(pkg) {\n  try {\n    const r = await api.createShortcut(pkg);\n    toast({ title: '桌面快捷方式已创建', body: r.path, type: 'ok' });\n    refreshApps();\n  } catch (e) {\n    toast({ title: '创建快捷方式失败', body: e.message, type: 'error' });\n  }\n}\n\nasync function uninstall(pkg) {\n  const app = state.apps.find((a) => a.package === pkg);\n  if (!app) return;\n  const ok = window.confirm(`确定卸载「${app.label}」？\\n\\n应用数据会一并被清除，桌面快捷方式也会被删除。`);\n  if (!ok) return;\n  try {\n    await api.uninstall(pkg);\n    toast({ title: '已卸载', body: app.label, type: 'ok' });\n    refreshApps();\n  } catch (e) {\n    toast({ title: '卸载失败', body: e.message, type: 'error' });\n  }\n}\n\n/* ---------------- 右键菜单 ---------------- */\n\nconst MENU_ITEMS = [\n  { key: 'open', label: '打开应用', kbd: 'Enter' },\n  // 只在应用真的在运行时才出现（见 showMenu 里的过滤）。\n  // 以前完全没有这一项，独立窗口模式下又没有可点的关闭按钮，\n  // 应用一起来就关不掉，只能退到托盘退出整个 ApkStart。\n  { key: 'stop', label: '关闭应用', onlyRunning: true },\n  { key: 'shortcut', label: '创建桌面快捷方式' },\n  { key: 'orientation', label: '横屏 / 竖屏' },\n  { key: 'pin', label: '固定到顶部' },\n  { key: 'keymap', label: '按键映射…' },\n  { divider: true },\n  { key: 'reveal', label: '打开 APK 所在位置' },\n  { key: 'clear', label: '清除应用数据' },\n  { divider: true },\n  { key: 'uninstall', label: '卸载', danger: true },\n];\n\nfunction showMenu(x, y, pkg) {\n  const menu = $('ctxmenu');\n  state.menuPkg = pkg;\n  const app = state.apps.find((a) => a.package === pkg);\n  const items = MENU_ITEMS.filter((it) => !it.onlyRunning || (app && app.running));\n  menu.innerHTML = items.map((it) => {\n    if (it.divider) return '<div class=\"divider\"></div>';\n    const label = it.key === 'pin' ? (app && app.pinned ? '取消固定' : '固定到顶部')\n      : (it.key === 'orientation'\n        ? (app && app.orientationOverride === 'landscape' ? '竖屏启动（当前横屏）'\n          : (app && app.orientationOverride === 'portrait' ? '横屏启动（当前竖屏）' : '设为横屏启动'))\n        : it.label);\n    return `<div class=\"item ${it.danger ? 'danger' : ''}\" data-key=\"${it.key}\" data-act=\"${it.key}\">\n      <span>${esc(label)}</span>${it.kbd ? `<span class=\"k\">${it.kbd}</span>` : ''}\n    </div>`;\n  }).join('');\n  menu.classList.add('on');\n\n  const rect = menu.getBoundingClientRect();\n  menu.style.left = `${Math.min(x, window.innerWidth - rect.width - 10)}px`;\n  menu.style.top = `${Math.min(y, window.innerHeight - rect.height - 10)}px`;\n}\n\nfunction hideMenu() {\n  $('ctxmenu').classList.remove('on');\n  state.menuPkg = null;\n}\n\nasync function handleMenu(act) {\n  const pkg = state.menuPkg;\n  const app = state.apps.find((a) => a.package === pkg);\n  hideMenu();\n  if (!app) return;\n  switch (act) {\n    case 'open': return launchApp(pkg);\n    case 'stop': {\n      try {\n        const r = await api.stop(pkg);\n        if (r && r.ok) {\n          toast({ title: '已关闭', body: app.label, type: 'ok' });\n        } else {\n          toast({ title: '关闭失败', body: (r && r.error) || '未知错误', type: 'error' });\n        }\n      } catch (e) {\n        toast({ title: '关闭失败', body: e.message, type: 'error' });\n      }\n      return refreshApps();\n    }\n    case 'shortcut': return createShortcut(pkg);\n    case 'orientation': {\n      // 三态循环：跟随应用 → 横屏 → 竖屏 → 跟随应用\n      // 这样红果这类被清单判成竖屏的应用，用户点一下就能强制横屏并记住。\n      const cur = app.orientationOverride;\n      const next = cur === 'landscape' ? 'portrait' : (cur === 'portrait' ? null : 'landscape');\n      try {\n        const r = await api.setAppOrientation(pkg, next);\n        const txt = next === 'landscape' ? '横屏启动' : (next === 'portrait' ? '竖屏启动' : '跟随应用');\n        toast({ title: `已设为${txt}`, body: '下次打开该应用时生效，无需重启整个环境。', type: 'ok' });\n        if (r && typeof r.landscape === 'boolean' && state.apps) {\n          const rec = state.apps.find((a) => a.package === pkg);\n          if (rec) rec.orientationOverride = next;\n        }\n      } catch (e) {\n        toast({ title: '设置方向失败', body: e.message, type: 'error' });\n      }\n      return refreshApps();\n    }\n    case 'pin': return api.pin(pkg, !app.pinned).then(refreshApps);\n    case 'keymap': return showKeymapPicker(pkg, app.label);\n    case 'reveal': return api.revealApk(pkg);\n    case 'clear': {\n      if (!window.confirm(`清除「${app.label}」的全部数据？此操作不可撤销。`)) return;\n      try {\n        await api.clearData(pkg);\n        toast({ title: '数据已清除', body: app.label, type: 'ok' });\n      } catch (e) {\n        toast({ title: '清除失败', body: e.message, type: 'error' });\n      }\n      return;\n    }\n    case 'uninstall': return uninstall(pkg);\n    default: return undefined;\n  }\n}\n\n/**\n * 按键映射预设选择器。用 confirm + prompt 做最简交互（不引入新 UI 组件）。\n * 后续可以做成更精致的弹窗编辑器。\n */\nasync function showKeymapPicker(pkg, label) {\n  try {\n    const presets = await api.keymap.getPresets();\n    const current = await api.keymap.getMap(pkg);\n    const hasCurrent = current && current.length > 0;\n    const lines = presets.map((p, i) => `${i + 1}. ${p.label} — ${p.desc}`);\n    if (hasCurrent) lines.unshift('0. 清除当前映射');\n    const msg = `为「${label}」选择按键映射预设：\\n\\n${lines.join('\\n')}\\n\\n输入编号：`;\n    const input = window.prompt(msg, hasCurrent ? '0' : '1');\n    if (input === null) return; // 取消\n    const idx = parseInt(input, 10);\n    if (hasCurrent && idx === 0) {\n      await api.keymap.setMap(pkg, []);\n      toast({ title: '已清除按键映射', body: label, type: 'ok' });\n      return;\n    }\n    const presetIdx = hasCurrent ? idx - 1 : idx;\n    if (presetIdx < 1 || presetIdx > presets.length) {\n      toast({ title: '无效编号', type: 'error' });\n      return;\n    }\n    const chosen = presets[presetIdx - 1];\n    await api.keymap.applyPreset(pkg, chosen.id);\n    toast({ title: `已套用「${chosen.label}」`, body: `${label} · 打开应用后键盘即可操控`, type: 'ok' });\n  } catch (e) {\n    toast({ title: '按键映射设置失败', body: e.message, type: 'error' });\n  }\n}\n\n/* ---------------- 设置 ---------------- */\n\n// ---------------- 安卓系统设置 ----------------\n\nlet volumeTimer = null;\n\nasync function refreshAndroid() {\n  const el = $('androidStatus');\n  if (!el) return;\n  el.textContent = '读取中…';\n  const r = await api.android.status().catch(() => null);\n  if (!r || !r.ok) {\n    el.textContent = r && r.error ? `运行时未就绪（${String(r.error).slice(0, 36)}）` : '运行时未启动';\n    return;\n  }\n  el.textContent = `Android ${r.sdk || '?'} · ${r.wifi ? 'Wi-Fi 已开' : 'Wi-Fi 已关'}` +\n    `${r.airplane ? ' · 飞行模式' : ''} · 音量 ${r.volume}%`;\n  $('setAndroidWifi').checked = !!r.wifi;\n  $('setAndroidAirplane').checked = !!r.airplane;\n  $('setAndroidAnim').checked = !r.animationsOff;\n  if ($('setAndroidSoftKeyboard')) $('setAndroidSoftKeyboard').checked = !!r.softKeyboard;\n  $('setAndroidVolume').value = r.volume;\n  $('androidVolumeText').textContent = `${r.volume}%`;\n  if (r.fontScale) $('setAndroidFont').value = Number(r.fontScale).toFixed(2);\n  if (r.density) {\n    const opt = [...$('setAndroidDensity').options].find((o) => o.value === String(r.density));\n    if (opt) $('setAndroidDensity').value = String(r.density);\n  }\n}\n\nfunction bindAndroid() {\n  const set = async (key, value, msg) => {\n    const r = await api.android.set(key, value).catch(() => null);\n    toast({\n      type: r && r.ok ? 'ok' : 'error',\n      title: r && r.ok ? (msg || '已生效') : `失败：${(r && r.error) || '运行时未就绪'}`,\n    });\n    if (r && r.ok) refreshAndroid();\n  };\n  $('setAndroidWifi').addEventListener('change', (e) => set('wifi', e.target.checked, e.target.checked ? 'Wi-Fi 已开启' : 'Wi-Fi 已关闭'));\n  $('setAndroidAirplane').addEventListener('change', (e) => set('airplane', e.target.checked, e.target.checked ? '已进入飞行模式' : '已退出飞行模式'));\n  $('setAndroidAnim').addEventListener('change', (e) => set('animations', e.target.checked, e.target.checked ? '系统动画已开启' : '系统动画已关闭，界面更快'));\n  if ($('setAndroidSoftKeyboard')) {\n    $('setAndroidSoftKeyboard').addEventListener('change', (e) => set('softKeyboard', e.target.checked,\n      e.target.checked ? '安卓软键盘已开启，点输入框会弹出' : '安卓软键盘已关闭，直接用电脑键盘输入'));\n  }\n  $('setAndroidFont').addEventListener('change', (e) => set('fontScale', Number(e.target.value), '字体大小已调整'));\n  $('setAndroidDensity').addEventListener('change', (e) => set('density', Number(e.target.value), '显示大小已调整'));\n  $('setAndroidVolume').addEventListener('input', (e) => {\n    $('androidVolumeText').textContent = `${e.target.value}%`;\n    clearTimeout(volumeTimer);\n    volumeTimer = setTimeout(() => set('volume', Number(e.target.value), '音量已调整'), 260);\n  });\n  $('btnAndroidRefresh').addEventListener('click', () => refreshAndroid());\n  $('btnAndroidTune').addEventListener('click', async () => {\n    const r = await api.android.tune(state.launchPkg || '').catch(() => null);\n    toast({ type: r && r.ok ? 'ok' : 'error', title: r && r.ok ? '已优化：动画关闭、后台放宽、电池白名单' : '优化失败，运行时可能未启动' });\n    if (r && r.ok) refreshAndroid();\n  });\n  const open = async (action) => {\n    const r = await api.android.open(action).catch(() => null);\n    if (!r || !r.ok) {\n      toast({ type: 'error', title: '需要先打开一次应用，让运行时启动' });\n    }\n  };\n  $('btnAndroidSettings').addEventListener('click', () => open('settings'));\n  $('btnAndroidDisplay').addEventListener('click', () => open('display'));\n  $('btnAndroidSound').addEventListener('click', () => open('sound'));\n  $('btnAndroidLocale').addEventListener('click', () => open('locale'));\n  $('btnAndroidApps').addEventListener('click', () => open('apps'));\n}\n\n/** 设置页字段同步：只剩自带运行时，所有资源项都露出来，不再按底座切换 */\nfunction syncBackendFields() {\n  const perf = $('perfGroup');\n  if (perf) perf.hidden = false;\n  refreshResources();\n}\n\n/** 本机资源上限 + 当前分配（设置页里那几行灰字） */\nasync function refreshResources() {\n  const bNote = $('builtinResNote');\n  if (!bNote) return;\n  const gb = (mb) => (Number(mb) > 0 ? `${Math.round(Number(mb) / 1024)} GB` : '未知');\n  const r = await api.resources().catch(() => null);\n  if (!r || r.ok === false) {\n    bNote.textContent = (r && (r.note || r.error)) || '暂时读不到资源分配信息';\n    return;\n  }\n  const host = r.host || {};\n  const lim = r.limits || {};\n  const free = Number(r.freeMB) || Number((r.current && r.current.freeMB) || 0);\n  bNote.textContent = `本机 ${gb(host.totalMB)} 内存 / ${host.cores} 核；`\n    + `内存最多可分 ${gb(lim.maxMB)}，核心最多 ${Math.max(1, (host.cores || 1) - 1)} 个（各留 1/4 内存与 1 核给 Windows）。`\n    + `数据分区上限 ${lim.maxGB || 0} GB${free ? `（所在磁盘剩余 ${(free / 1024).toFixed(1)} GB）` : ''}。`\n    + (r.verdict && r.verdict.note ? ` ${r.verdict.note}` : '');\n}\n\n/** 本机体检：渲染报告（每条带等级点和可执行动作） */\nfunction renderPreflight(res) {\n  const list = $('preflightList');\n  const sum = $('preflightSummary');\n  const applyBtn = $('btnPreflightApply');\n  if (!list) return;\n  list.textContent = '';\n  if (!res || !res.report) {\n    if (sum) sum.textContent = (res && res.error) || '体检没有返回结果，请重试';\n    return;\n  }\n  const { report, edition } = res;\n  for (const it of report.items) {\n    const item = document.createElement('div');\n    item.className = 'pf-item';\n    const head = document.createElement('div');\n    head.className = 'pf-head';\n    const dot = document.createElement('span');\n    dot.className = `pf-dot ${it.level}`;\n    const title = document.createElement('span');\n    title.className = 'pf-title';\n    title.textContent = it.title;\n    head.append(dot, title);\n    item.append(head);\n    if (it.detail) {\n      const d = document.createElement('div');\n      d.className = 'pf-detail';\n      d.textContent = it.detail;\n      item.append(d);\n    }\n    if (it.action && it.action.kind === 'elevate') {\n      const wrap = document.createElement('div');\n      wrap.className = 'pf-action';\n      const btn = document.createElement('button');\n      btn.className = 'btn ghost sm';\n      btn.textContent = it.action.label;\n      btn.addEventListener('click', async () => {\n        btn.disabled = true;\n        const old = btn.textContent;\n        btn.textContent = '正在处理…';\n        let r = null;\n        if (it.action.id === 'accel') r = await api.enableAccel().catch(() => null);\n        else r = await api.enableVirtualization().catch(() => null);\n        btn.disabled = false;\n        btn.textContent = old;\n        if (!r) { toast({ type: 'error', title: '操作没有完成', body: '可以稍后重试，或手动按提示操作' }); return; }\n        if (r.cancelled) toast({ type: 'warn', title: '已取消', body: '没有修改系统设置' });\n        else if (r.ok || r.already) {\n          const reboot = r.restartNeeded === true;\n          toast({\n            type: 'ok',\n            title: r.already ? '硬件加速已经可用' : (reboot ? '已提交，需要重启' : '已生效'),\n            body: r.already ? '' : (reboot ? '重启电脑后硬件加速才会生效，回来点「开始体检」确认' : '可以点「开始体检」确认结果'),\n          });\n          if (r.already || !reboot) setTimeout(() => runPreflight().catch(() => {}), 1200);\n        } else {\n          toast({ type: 'error', title: '没能自动完成', body: (r.error || r.note || '请按提示手动操作') });\n        }\n      });\n      wrap.append(btn);\n      item.append(wrap);\n    } else if (it.action && it.action.kind === 'manual') {\n      const wrap = document.createElement('div');\n      wrap.className = 'pf-action pf-detail';\n      wrap.textContent = `⚠ ${it.action.label}`;\n      item.append(wrap);\n    }\n    list.append(item);\n  }\n  const rec = report.recommended || {};\n  if (sum) {\n    sum.textContent = `${report.summary}。推荐配置：${Math.round((rec.memoryMB || 0) / 1024)} GB 内存 / `\n      + `${rec.cores || 2} 核 / ${rec.renderSize || 'auto'} · 渲染 ${rec.gpuMode || 'auto'}`\n      + (edition === 'store' ? '（商店版：系统功能只能在「Windows 功能」里手动开）' : '');\n  }\n  if (applyBtn) applyBtn.hidden = false;\n}\n\nasync function runPreflight() {\n  const btn = $('btnPreflight');\n  const sum = $('preflightSummary');\n  if (!btn) return null;\n  const old = btn.textContent;\n  btn.disabled = true;\n  btn.textContent = '体检中…';\n  if (sum) sum.textContent = '正在检查虚拟化、显卡、内存…（第一次约 2~3 秒）';\n  let r = null;\n  try {\n    r = await api.preflightRun();\n  } catch (e) {\n    r = { error: e.message || '体检失败' };\n  }\n  btn.disabled = false;\n  btn.textContent = old;\n  renderPreflight(r);\n  return r;\n}\n\n/** 驱动（兼容补丁）：渲染清单 + 命中状态 */\nfunction renderDrivers(r) {\n  const list = $('drvList');\n  const sum = $('drvSummary');\n  if (!list) return;\n  const host = (r && r.host) || {};\n  const drivers = (r && r.drivers) || [];\n  const errors = (r && r.errors) || [];\n  const onCount = drivers.filter((d) => d.enabled && d.matched).length;\n  if (sum) {\n    const accel = host.accel === 'none' ? '无硬件加速' : (host.accel || '未知');\n    sum.textContent = `本机：${host.platform || ''}/${host.arch || ''} · ${host.gpuVendor || '未知'} 显卡 · ${accel}`\n      + ` · emulator ${host.emulatorVersion || '未知'}；驱动 ${drivers.length} 个，本机已生效 ${onCount} 个。`\n      + (errors.length ? ` ${errors.length} 个文件加载失败（见下）。` : '');\n  }\n  list.textContent = '';\n  for (const d of drivers) {\n    const item = document.createElement('div');\n    item.className = d.enabled ? 'drv-item on' : 'drv-item';\n\n    const head = document.createElement('div');\n    head.className = 'drv-head';\n    const cb = document.createElement('input');\n    cb.type = 'checkbox';\n    cb.checked = !!d.enabled;\n    cb.addEventListener('change', async () => {\n      const res = await api.driversSetEnabled(d.id, cb.checked).catch(() => null);\n      if (res && res.ok && res.overview) renderDrivers(res.overview);\n      else { cb.checked = !cb.checked; toast({ type: 'error', title: '保存失败', body: (res && res.error) || '请稍后再试' }); }\n    });\n    const name = document.createElement('span');\n    name.className = 'drv-name';\n    name.textContent = d.name;\n    head.append(cb, name);\n\n    if (d.matched && d.enabled) {\n      const b = document.createElement('span');\n      b.className = 'drv-badge hit';\n      b.textContent = '已生效';\n      head.append(b);\n    }\n    if (d.builtin) {\n      const b = document.createElement('span');\n      b.className = 'drv-badge';\n      b.textContent = '内置示例';\n      head.append(b);\n    }\n    item.append(head);\n\n    const meta = document.createElement('div');\n    meta.className = 'drv-meta';\n    meta.textContent = `v${d.version || '?'}`\n      + (d.author ? ` · ${d.author}` : '')\n      + ` · priority ${d.priority}`\n      + (d.hits && d.hits.length ? ` · 命中：${d.hits.join(' / ')}` : ' · 本机不匹配');\n    item.append(meta);\n\n    if (d.description) {\n      const desc = document.createElement('div');\n      desc.className = 'drv-meta';\n      desc.textContent = d.description;\n      item.append(desc);\n    }\n    list.append(item);\n  }\n  for (const e of errors) {\n    const err = document.createElement('div');\n    err.className = 'drv-err';\n    err.textContent = `${String(e.file || '').split(/[\\\\/]/).pop()}：${(e.errors || []).join('；')}`;\n    list.append(err);\n  }\n  if (!drivers.length && !errors.length) {\n    const empty = document.createElement('div');\n    empty.className = 'drv-meta';\n    empty.textContent = '还没有任何驱动。可以点「导出本机模板」做一个，或导入别人做好的 JSON。';\n    list.append(empty);\n  }\n}\n\nasync function refreshDrivers() {\n  if (!$('drvList')) return;\n  const r = await api.driversList().catch(() => null);\n  if (!r) {\n    if ($('drvSummary')) $('drvSummary').textContent = '读不到驱动列表（运行时可能还没部署）';\n    return;\n  }\n  renderDrivers(r);\n}\n\nfunction fillSettings(s) {\n  syncBackendFields();\n  refreshDrivers().catch(() => {});\n  $('setAdbPath').value = s.adbPath || '';\n  $('setSystemImage').value = s.runtime.isoPath || '';\n  $('setMemory').value = s.engine.memoryMB;\n  $('setCores').value = s.engine.cores;\n  $('setIdle').value = s.engine.idleShutdownMinutes;\n  if ($('setSourcePref')) $('setSourcePref').value = (s.runtime && s.runtime.sourcePreference) || 'auto';\n  if ($('setAutoMirror')) $('setAutoMirror').checked = (s.runtime && s.runtime.autoMirror) !== false;\n  if ($('setGiteeToken')) $('setGiteeToken').value = (s.runtime && s.runtime.giteeToken) || '';\n  if ($('setMirrorPrefix')) $('setMirrorPrefix').value = (s.runtime && s.runtime.mirrorPrefix) || '';\n  if ($('setConnections')) $('setConnections').value = Number((s.runtime && s.runtime.downloadConnections) || 8);\n  $('setAudio').checked = s.engine.audio !== false;\n  $('setLiteMode').checked = s.engine.liteMode !== false;\n  $('setPrewarm').checked = s.engine.prewarm !== false;\n  $('setPriorityMode').value = ['performance', 'game'].includes(s.engine.priorityMode)\n    ? s.engine.priorityMode : 'balanced';\n  $('setDeepTrim').checked = !!s.engine.deepTrim;\n  $('setMouseRightBack').checked = s.engine.mouseRightBack !== false;\n  $('setMouseWheelMode').value = ['smooth', 'native', 'off'].includes(s.engine.mouseWheelMode)\n    ? s.engine.mouseWheelMode : 'smooth';\n  $('setMouseSideButtons').checked = !!s.engine.mouseSideButtons;\n  if ($('setKeymapEnabled')) $('setKeymapEnabled').checked = s.engine.keymapEnabled !== false;\n  // 实验室：原生多窗口多开（实验性）\n  if ($('setMultiWindow')) $('setMultiWindow').checked = !!s.engine.multiWindow;\n  if ($('setKeepBackground')) $('setKeepBackground').value = String(\n    Number(s.engine.keepBackground) >= 0 ? Number(s.engine.keepBackground) : 1,\n  );\n  $('setCompat').checked = !!(s.runtime && s.runtime.compatImage);\n  $('setAutoShortcut').checked = !!s.createShortcutOnInstall;\n  $('setStartMenuShortcut').checked = s.createStartMenuShortcut !== false;\n  $('setShortcutDir').value = s.shortcutDir || '';\n  $('setSharedDir').value = s.sharedDir || '';\n  $('setDeviceSharedDir').value = s.deviceSharedDir || '';\n  const d = s.display || {};\n  $('setAutoStart').checked = s.autoStart !== false;\n  const eng = s.engine || {};\n  if ($('setResourceMode')) $('setResourceMode').value = eng.resourceMode || 'balanced';\n  if ($('setRenderSize')) $('setRenderSize').value = eng.renderSize || 'auto';\n  if ($('setDataGB')) $('setDataGB').value = String(Number(eng.dataPartitionGB || 0));\n  if ($('setDnsPreset')) {\n    // 0.6.4 前的配置只有布尔 fastDns：true -> cn，false -> off。\n    const legacyOff = eng.fastDns === false;\n    $('setDnsPreset').value = eng.dnsPreset || (legacyOff ? 'off' : 'cn');\n  }\n  if ($('setLocale')) $('setLocale').value = eng.locale || 'zh-CN';\n  if ($('setChineseIme')) $('setChineseIme').checked = eng.chineseIme !== false;\n  if ($('setKeepSnapshot')) $('setKeepSnapshot').checked = eng.keepSnapshot !== false;\n  $('setDisplayMode').value = d.mode === 'fullscreen' ? 'fullscreen' : 'window';\n  if ($('setAutoFullscreen')) $('setAutoFullscreen').value = d.autoFullscreenOnLaunch === true ? 'on' : 'off';\n  if ($('setLandscape')) $('setLandscape').value = d.landscape === true ? 'landscape' : 'portrait';\n  if ($('setOrientationMode')) $('setOrientationMode').value = d.orientationMode || 'auto';\n  if ($('setAutoRotate')) $('setAutoRotate').value = d.autoRotate === false ? 'off' : 'on';\n  if ($('setTabletMode')) $('setTabletMode').value = d.tabletMode === false ? 'off' : 'on';\n  $('setPortrait').value = d.portrait || '900x1600';\n  // 0.6.0 起默认原生窗口：只有显式 true 才是嵌入模式（旧配置里 undefined 视为原生）\n  if ($('setWindowEmbed')) $('setWindowEmbed').value = d.windowEmbed === true ? 'embed' : 'detached';\n  $('portraitField').hidden = $('setDisplayMode').value === 'fullscreen';\n}\n\n/** 数据分区实际大小 + 磁盘余量，显示在设置页容量选择下方 */\nasync function refreshDataInfo() {\n  const el = $('dataNote');\n  if (!el) return;\n  const info = await api.dataInfo().catch(() => null);\n  if (!info) { el.textContent = '读取数据分区信息失败'; return; }\n  const auto = Number(($('setDataGB') || {}).value || 0) === 0;\n  // 有 quickboot 差量盘时底座镜像的大小不等于 guest 看到的容量（实测 8GB 镜像、guest 5.7GB），\n  // 与其显示一个会误导人的数字，不如明确说「以运行时为准」。\n  const img = info.overlay\n    ? '快速启动差量盘（实际容量以运行时 /data 为准）'\n    : (info.fsGB ? `实际文件系统 ${info.fsGB} GB` : (info.imageGB ? `${info.imageGB} GB` : '尚未创建'));\n  const free = info.freeDiskMB ? `${(info.freeDiskMB / 1024).toFixed(1)} GB` : '未知';\n  const pending = Number(info.pendingGB) > 0\n    ? ` 目标 ${info.configuredGB} GB 还没生效：安卓正在用快速启动差量盘，需要「重置安卓数据」后按新容量重建（会清空已装应用）。`\n    : '';\n  el.textContent = `当前数据分区：${img}${auto ? '（自动）' : ''} · 所在磁盘剩余 ${free}。${pending}`\n    + '游戏提示「存储空间不足」就把这里调大后点「立即扩容」；能就地扩容时不丢已装应用。';\n}\n\n/* ---------------- 设置页：分类导航 + 搜索 ---------------- */\n\n/**\n * 设置项越来越多，一条长滚动找起来很费劲（用户 0.6.0 的原话：\n * 「设置内做好分类功能」）。这里把设置按用途分成 8 类，左侧一列导航。\n *\n * 分类表必须与 index.html 里每个分组的 data-cat 一致 ——\n * test/settings-categories-test.js 会校验这一致性。\n */\nconst SETTINGS_CATS = [\n  { id: 'basic', name: '常用与安装' },\n  { id: 'display', name: '显示与窗口' },\n  { id: 'input', name: '操作与输入' },\n  { id: 'perf', name: '性能与资源' },\n  { id: 'net', name: '网络与下载' },\n  { id: 'diag', name: '诊断与修复' },\n  { id: 'files', name: '集成与文件' },\n  { id: 'about', name: '更新与关于' },\n  { id: 'lab', name: '实验室' },\n];\n\nconst settingsCatState = { cat: 'basic', query: '' };\n\n/** 设置里所有带分类标记的分组（.group 和 details.advanced-group 都算） */\nfunction settingsGroups() {\n  return Array.from(document.querySelectorAll('#settingsBody [data-cat]'));\n}\n\n/** 分组内是否命中搜索词：标题、字段名、说明文字都算 */\nfunction groupMatches(group, q) {\n  if (!q) return true;\n  const text = (group.textContent || '').toLowerCase();\n  if (text.includes(q)) return true;\n  const title = group.querySelector('.group-title');\n  return !!title && title.textContent.toLowerCase().includes(q);\n}\n\n/** 切到某个分类 */\nfunction switchSettingsCat(cat, { keepQuery = false } = {}) {\n  const target = SETTINGS_CATS.some((c) => c.id === cat) ? cat : 'basic';\n  settingsCatState.cat = target;\n  if (!keepQuery) settingsCatState.query = '';\n  try { localStorage.setItem('apkstart.settings.cat', target); } catch (_) { /* ignore */ }\n  const search = $('setSearch');\n  if (search && !keepQuery) search.value = '';\n  const clear = $('btnClearSearch');\n  if (clear) clear.hidden = !settingsCatState.query;\n  document.querySelectorAll('#setNav .set-nav-item').forEach((b) => {\n    b.classList.toggle('on', b.dataset.cat === target);\n  });\n  applySettingsFilter();\n}\n\n/**\n * 应用可见性：搜索时跨分类展示命中的分组（否则搜到的东西藏在别的分类里，\n * 用户会以为「搜了没反应」）；没搜索时只显示当前分类。\n */\nfunction applySettingsFilter() {\n  const q = settingsCatState.query.trim().toLowerCase();\n  const groups = settingsGroups();\n  const hitPerCat = {};\n  for (const g of groups) {\n    const hit = groupMatches(g, q);\n    const inCat = g.dataset.cat === settingsCatState.cat;\n    g.hidden = q ? !hit : !inCat;\n    if (hit) hitPerCat[g.dataset.cat] = (hitPerCat[g.dataset.cat] || 0) + 1;\n  }\n  // 分类按钮：搜索时标出哪些分类有命中项\n  document.querySelectorAll('#setNav .set-nav-item').forEach((b) => {\n    const n = hitPerCat[b.dataset.cat] || 0;\n    b.classList.toggle('dim', !!q && n === 0);\n    b.title = q ? `${n} 项命中` : '';\n  });\n  // 最后一个可见分组不画分隔线（分组被隐藏后 :last-child 会选错对象）\n  const visible = groups.filter((g) => !g.hidden);\n  visible.forEach((g) => g.classList.remove('last-visible'));\n  if (visible.length) visible[visible.length - 1].classList.add('last-visible');\n  updateCatBadges();\n}\n\n/** 定位到某个分组：先切到它所属的分类，再滚动过去 */\nfunction focusGroup(el) {\n  if (!el) return;\n  const cat = el.dataset && el.dataset.cat;\n  if (cat) switchSettingsCat(cat);\n  const body = $('settingsBody');\n  if (body) body.scrollTop = 0;\n  if (typeof el.scrollIntoView === 'function') {\n    el.scrollIntoView({ block: 'start', behavior: 'smooth' });\n  }\n}\n\nfunction bindSettingsCategory() {\n  const nav = $('setNav');\n  if (nav) {\n    nav.addEventListener('click', (e) => {\n      const btn = e.target.closest('.set-nav-item');\n      if (!btn) return;\n      switchSettingsCat(btn.dataset.cat);\n      const body = $('settingsBody');\n      if (body) body.scrollTop = 0;\n    });\n  }\n\n  const search = $('setSearch');\n  const clear = $('btnClearSearch');\n  if (search) {\n    search.addEventListener('input', () => {\n      settingsCatState.query = search.value || '';\n      if (clear) clear.hidden = !settingsCatState.query;\n      applySettingsFilter();\n    });\n    // 回车：跳到第一个命中的分组\n    search.addEventListener('keydown', (e) => {\n      if (e.key !== 'Enter') return;\n      e.preventDefault();\n      const hit = settingsGroups().find((g) => !g.hidden);\n      if (hit) focusGroup(hit);\n    });\n  }\n  if (clear) {\n    clear.addEventListener('click', () => {\n      settingsCatState.query = '';\n      if (search) search.value = '';\n      clear.hidden = true;\n      applySettingsFilter();\n    });\n  }\n\n  // 记住上次停留的分类\n  try {\n    const last = localStorage.getItem('apkstart.settings.cat');\n    if (last && SETTINGS_CATS.some((c) => c.id === last)) settingsCatState.cat = last;\n  } catch (_) { /* ignore */ }\n  switchSettingsCat(settingsCatState.cat);\n}\n\n/* ---------------- 自动检测（自动 debug）---------------- */\n\n/** 自动检测的问题分类名（与 src/core/autodebug.js 的 CATEGORIES 对应） */\nconst DEBUG_CATS = [\n  { id: 'runtime', name: '运行时' },\n  { id: 'device', name: '设备连接' },\n  { id: 'storage', name: '存储' },\n  { id: 'settings', name: '设置' },\n  { id: 'network', name: '网络' },\n  { id: 'logs', name: '日志' },\n];\n\nlet autodebugLast = null;\n\nfunction renderAutodebug(res) {\n  const list = $('autodebugList');\n  const txt = $('autodebugStateText');\n  if (!list) return;\n  autodebugLast = res || null;\n  const issues = (res && res.issues) || [];\n  const at = res && res.at;\n\n  if (txt) {\n    if (res && res.running) txt.textContent = '正在检测…';\n    else if (!at) txt.textContent = '尚未检测';\n    else if (!issues.length) txt.textContent = `上次检测 ${relTime(at)} · 一切正常`;\n    else txt.textContent = `上次检测 ${relTime(at)} · ${issues.length} 项待处理`;\n  }\n\n  if (!issues.length) {\n    list.innerHTML = `<div class=\"dbg-ok\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n      <span>没有发现影响使用的问题。运行时、adb 授权、磁盘、数据分区、快照与设置冲突都检查过了。</span>\n    </div>`;\n    updateCatBadges();\n    return;\n  }\n\n  const byCat = new Map();\n  for (const it of issues) {\n    const key = it.category || 'runtime';\n    if (!byCat.has(key)) byCat.set(key, []);\n    byCat.get(key).push(it);\n  }\n  const order = DEBUG_CATS.map((c) => c.id);\n  const keys = Array.from(byCat.keys()).sort((a, b) => {\n    const ia = order.indexOf(a); const ib = order.indexOf(b);\n    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);\n  });\n\n  list.innerHTML = keys.map((key) => {\n    const name = (DEBUG_CATS.find((c) => c.id === key) || {}).name || key;\n    const items = byCat.get(key);\n    return `<div class=\"dbg-group\">\n      <div class=\"dbg-group-title\">${esc(name)}<span class=\"dbg-count\">${items.length}</span></div>\n      ${items.map((it) => `\n        <div class=\"dbg-item ${esc(it.severity || 'info')}\">\n          <span class=\"dbg-sev\"></span>\n          <div class=\"dbg-body\">\n            <div class=\"dbg-name\">${esc(it.title || '')}</div>\n            <div class=\"dbg-hint\">${esc(it.hint || '')}</div>\n            ${it.detail ? `<div class=\"dbg-detail\">${esc(it.detail)}</div>` : ''}\n          </div>\n          ${it.fix ? `<button class=\"dbg-fix\" data-code=\"${esc(it.code)}\">处理</button>` : ''}\n          <button class=\"dbg-help\" data-code=\"${esc(it.code)}\" title=\"打开内置教程\">教程</button>\n        </div>`).join('')}\n    </div>`;\n  }).join('');\n\n  list.querySelectorAll('.dbg-fix').forEach((b) => {\n    b.addEventListener('click', () => {\n      const issue = issues.find((x) => x.code === b.dataset.code);\n      if (issue) fixIssue(issue);\n    });\n  });\n  list.querySelectorAll('.dbg-help').forEach((b) => {\n    b.addEventListener('click', () => {\n      const issue = issues.find((x) => x.code === b.dataset.code);\n      if (issue) openManualForIssue(issue, 'clicked');\n    });\n  });\n\n  updateCatBadges();\n}\n\n/** 分类按钮上的问题角标：只在有问题的分类上显示数字 */\nfunction updateCatBadges() {\n  const issues = (autodebugLast && autodebugLast.issues) || [];\n  document.querySelectorAll('#setNav .set-nav-badge').forEach((el) => {\n    const cat = el.dataset.badge;\n    // 自动检测的问题不一定都归属某个设置分类，只有设置类问题才在「诊断与修复」上打标\n    const n = cat === 'diag' ? issues.filter((i) => i.severity === 'error').length : 0;\n    el.hidden = n === 0;\n    el.textContent = n ? String(n) : '';\n    el.classList.toggle('warn', false);\n  });\n}\n\nfunction bindAutodebug() {\n  const btn = $('btnAutodebugRun');\n  if (btn) {\n    btn.addEventListener('click', async () => {\n      btn.disabled = true;\n      const old = btn.textContent;\n      btn.textContent = '检测中…';\n      try {\n        const r = await api.autodebugRun().catch(() => null);\n        if (r) renderAutodebug(r);\n        else toast({ title: '检测失败', body: '采集状态时出错，稍后再试一次', type: 'error' });\n      } finally {\n        btn.disabled = false;\n        btn.textContent = old;\n      }\n    });\n  }\n\n  const report = $('btnAutodebugReport');\n  if (report) {\n    report.addEventListener('click', async () => {\n      const r = await api.doctorReport().catch(() => null);\n      if (r && r.ok !== false) toast({ title: '诊断报告已导出', body: '把报告发给作者可以最快定位问题', type: 'ok' });\n      else toast({ title: '导出失败', body: (r && r.error) || '请重试', type: 'error' });\n    });\n  }\n\n  const auto = $('setAutodebugAuto');\n  if (auto) {\n    auto.addEventListener('change', async () => {\n      const r = await api.autodebugConfig({ auto: auto.checked }).catch(() => null);\n      if (r) fillAutodebugSettings(r);\n      toast({\n        title: auto.checked ? '已开启自动检测' : '已关闭自动检测',\n        body: auto.checked ? '后台会定时检查，发现新问题才提醒' : '随时可以点「立即检测」手动跑一次',\n        type: 'info',\n      });\n    });\n  }\n\n  const interval = $('setAutodebugInterval');\n  if (interval) {\n    interval.addEventListener('change', async () => {\n      const r = await api.autodebugConfig({ intervalMin: Number(interval.value) }).catch(() => null);\n      if (r) fillAutodebugSettings(r);\n      toast({ title: '检测间隔已更新', body: `每 ${r ? r.intervalMin : interval.value} 分钟检测一次`, type: 'ok' });\n    });\n  }\n\n  const notify = $('setAutodebugNotify');\n  if (notify) {\n    notify.addEventListener('change', async () => {\n      const r = await api.autodebugConfig({ notify: notify.checked }).catch(() => null);\n      if (r) fillAutodebugSettings(r);\n    });\n  }\n}\n\nfunction fillAutodebugSettings(cfg) {\n  if (!cfg) return;\n  const auto = $('setAutodebugAuto');\n  if (auto) auto.checked = cfg.auto !== false;\n  const interval = $('setAutodebugInterval');\n  if (interval) interval.value = String(cfg.intervalMin || 10);\n  const notify = $('setAutodebugNotify');\n  if (notify) notify.checked = cfg.notify !== false;\n}\n\nasync function openSettings() {\n  state.settings = await api.getSettings();\n  fillSettings(state.settings);\n  fillAutodebugSettings((state.settings && state.settings.debug) || {});\n  const info = await api.info();\n  $('setRuntimeDir').value = info.runtimeDir || info.dataDir;\n  if ($('setAvdDir')) {\n    const di = await api.dataInfo().catch(() => null);\n    $('setAvdDir').value = (di && di.avdDir) || '';\n  }\n  const verEl = document.getElementById('aboutVer');\n  if (verEl && info.version) verEl.textContent = `v${info.version}`;\n  const curVerEl = document.getElementById('updateCurrent');\n  if (curVerEl && info.version) curVerEl.textContent = `v${info.version}`;\n  const assoc = await api.assocStatus();\n  const btn = $('btnAssoc');\n  btn.textContent = assoc.registered ? '已关联 · 点击取消' : '未关联 · 点击开启';\n  btn.dataset.on = assoc.registered ? '1' : '0';\n\n  api.doctorProfile().then((r) => {\n    if (r && r.text) $('autoProfileText').textContent = r.text;\n  }).catch(() => { $('autoProfileText').textContent = '自动模式'; });\n  api.runtimeUsage().then((u) => {\n    $('usageText').textContent = u\n      ? `共 ${u.totalText}${u.reclaimable ? ` · 可回收 ${u.reclaimableText}（${u.count} 项）` : ' · 已是精简状态'}`\n      : '统计不可用';\n  }).catch(() => { $('usageText').textContent = '统计不可用'; });\n\n  $('settingsMask').classList.add('on');\n  refreshAndroid();\n  refreshDataInfo();\n  applySettingsFilter();\n  // 先把上一次的检测结果铺上（别让面板空着等），再后台刷新一份\n  api.autodebugState().then((r) => { if (r) renderAutodebug(r); }).catch(() => {});\n}\n\nfunction closeSettings() {\n  $('settingsMask').classList.remove('on');\n}\n\n/* ---------------- 软件更新 ---------------- */\n\nlet lastUpdate = null;\n\n/** 把一次检查结果画到设置面板（也用于启动时静默检查推送过来的状态） */\nfunction renderUpdate(info) {\n  lastUpdate = info || null;\n  const cur = $('updateCurrent');\n  const st = $('updateState');\n  const btn = $('btnDoUpdate');\n  const bar = $('updateBar');\n  if (!cur || !st || !btn) return;\n  if (!info) return;\n  if (info.current) cur.textContent = `v${info.current}`;\n\n  if (info.ok === false) {\n    st.textContent = `检查失败：${info.error || '网络不可用'}`;\n    // 检查失败也要给一条出路：直接把发布页打开，用户至少能手动下载。\n    // 以前这里是「什么都不显示」，用户只会觉得「更新功能坏了」。\n    showUpdateBtn(true);\n    btn.textContent = '打开下载页';\n    btn.dataset.mode = 'manual';\n    lastUpdate = { htmlUrl: info.htmlUrl || '' };\n    if (bar) bar.hidden = true;\n    return;\n  }\n  if (info.hasUpdate) {\n    // 如实说明这次是哪个源给出的版本、另一个源为什么没参与 ——\n    // 用户排查「为什么检查更新很慢」时，这一行比任何日志都直接。\n    const src = (info.sources || []).map((x) => `${x.name} ${x.tag || ''}`.trim()).join(' / ');\n    const bad = (info.unreachable || []).map((x) => x.name).join('、');\n    const stale = info.stale ? '（离线缓存，可能不是最新）' : '';\n    st.textContent = `发现新版本 ${info.tag}${src ? `（${src}）` : ''}${bad ? `；${bad} 不可达` : ''}${stale}`;\n    showUpdateBtn(true);\n    btn.textContent = info.asset ? '立即更新' : '打开下载页';\n    btn.dataset.mode = info.asset ? 'auto' : 'manual';\n    const note = $('updateNote');\n    if (note && info.notes) {\n      const brief = String(info.notes).split('\\n').slice(0, 8).join('\\n').trim();\n      if (brief) note.textContent = `更新内容：\\n${brief}`;\n    }\n    if (bar) bar.hidden = true;\n  } else {\n    const src = (info.sources || []).map((x) => x.name).join(' / ');\n    const stale = info.stale ? '（离线缓存）' : '';\n    st.textContent = `已是最新版本（v${info.current}）${src ? ` · 经由 ${src}` : ''}${stale}`;\n    showUpdateBtn(false);\n    if (bar) bar.hidden = true;\n  }\n}\n\n/** .btn 自带 display:inline-flex，会盖掉 hidden 属性，所以这里直接改 display */\nfunction showUpdateBtn(on) {\n  const btn = $('btnDoUpdate');\n  if (!btn) return;\n  btn.hidden = !on;\n  btn.style.display = on ? '' : 'none';\n}\n\nfunction renderUpdateProgress(p) {\n  if (!p) return;\n  const st = $('updateState');\n  const bar = $('updateBar');\n  const fill = $('updateBarFill');\n  if (p.stage === 'error') {\n    if (st) st.textContent = `更新失败：${p.message || ''}`;\n    if (bar) bar.hidden = true;\n    toast({ title: '更新失败', body: p.message || '', type: 'error' });\n    return;\n  }\n  if (st) st.textContent = p.message || '正在更新…';\n  if (bar && fill) {\n    bar.hidden = false;\n    fill.style.width = `${Math.max(0, Math.min(100, p.percent || 0))}%`;\n  }\n}\n\nfunction bindUpdate() {\n  const check = $('btnCheckUpdate');\n  const go = $('btnDoUpdate');\n  if (!check || !go) return;\n\n  const runCheck = async (silent) => {\n    if (!silent) {\n      check.disabled = true;\n      const old = check.textContent;\n      check.textContent = '检查中…';\n      $('updateState').textContent = '正在连接 GitHub…';\n      try {\n        const info = await api.updateCheck();\n        renderUpdate(info);\n        if (info && info.hasUpdate) toast({ title: `发现新版本 ${info.tag}`, body: '点「立即更新」自动下载安装', type: 'info' });\n        else if (info && info.ok !== false) toast({ title: '已是最新版本', body: `v${info.current}`, type: 'ok' });\n      } catch (e) {\n        $('updateState').textContent = `检查失败：${e.message}`;\n      } finally {\n        check.disabled = false;\n        check.textContent = old;\n      }\n      return;\n    }\n    const info = await api.updateCheck().catch(() => null);\n    if (info) renderUpdate(info);\n  };\n\n  check.addEventListener('click', () => runCheck(false));\n\n  go.addEventListener('click', async () => {\n    if (go.dataset.mode === 'manual') {\n      api.updateOpenRelease(lastUpdate && lastUpdate.htmlUrl);\n      return;\n    }\n    go.disabled = true;\n    go.textContent = '更新中…';\n    const r = await api.updateApply().catch((e) => ({ ok: false, error: e.message }));\n    if (!r || !r.ok) {\n      go.disabled = false;\n      go.textContent = '立即更新';\n      if (r && r.error && !r.manual) {\n        $('updateState').textContent = `更新失败：${r.error}`;\n        toast({ title: '更新失败', body: r.error, type: 'error' });\n      }\n    } else {\n      $('updateState').textContent = `已下载 v${r.version}，正在重启完成安装…`;\n    }\n  });\n\n  // 打开设置时如果还没结果，就顺手查一次（放后台，不打扰）\n  runCheck(true).catch(() => {});\n}\n\nfunction bindSettings() {\n  const save = async (patch) => {\n    state.settings = await api.setSettings(patch);\n  };\n\n  if ($('btnPreflight')) $('btnPreflight').addEventListener('click', () => runPreflight());\n  if ($('btnPreflightApply')) {\n    $('btnPreflightApply').addEventListener('click', async () => {\n      const btn = $('btnPreflightApply');\n      btn.disabled = true;\n      const r = await api.preflightApply().catch(() => null);\n      btn.disabled = false;\n      if (!r || !r.ok) {\n        toast({ type: 'error', title: '应用失败', body: (r && r.error) || '请稍后再试' });\n        return;\n      }\n      state.settings = r.settings;\n      toast({\n        type: 'ok',\n        title: '已按这台机器配置好',\n        body: `内存 ${Math.round((r.recommended.memoryMB || 0) / 1024)} GB / ${r.recommended.cores} 核 / ${r.recommended.renderSize}`\n          + (r.driverFile ? '；已生成驱动，下次开机会自动套用' : ''),\n      });\n      if (r.driverError) toast({ type: 'warn', title: '驱动没写成功', body: r.driverError });\n      fillSettings(r.settings);\n      refreshStatus();\n    });\n  }\n  if ($('btnDrvReload')) $('btnDrvReload').addEventListener('click', () => refreshDrivers());\n  if ($('btnDrvFolder')) {\n    $('btnDrvFolder').addEventListener('click', async () => {\n      const r = await api.driversOpenFolder().catch(() => null);\n      if (!r || !r.ok) toast({ type: 'error', title: '打不开驱动目录' });\n    });\n  }\n  if ($('btnDrvImport')) {\n    $('btnDrvImport').addEventListener('click', async () => {\n      const r = await api.driversImport().catch(() => null);\n      if (!r || r.canceled) return;\n      if (!r.ok) {\n        toast({ type: 'error', title: '导入失败', body: (r.errors || []).slice(0, 3).join('；') });\n        return;\n      }\n      toast({ type: 'ok', title: '驱动已导入并启用', body: `${r.driver.name} v${r.driver.version}` });\n      if (r.overview) renderDrivers(r.overview);\n    });\n  }\n  if ($('btnDrvExport')) {\n    $('btnDrvExport').addEventListener('click', async () => {\n      const r = await api.driversExportTemplate().catch(() => null);\n      if (!r || r.canceled) return;\n      if (!r.ok) { toast({ type: 'error', title: '导出失败' }); return; }\n      toast({ type: 'ok', title: '模板已导出', body: '改完 effect 后放到驱动目录，点「刷新」即可生效' });\n      refreshDrivers();\n    });\n  }\n\n  $('setAdbPath').addEventListener('change', (e) => save({ adbPath: e.target.value.trim() }));\n  $('setSystemImage').addEventListener('change', (e) => save({ runtime: { isoPath: e.target.value.trim() } }));\n  // 内存 / 核心：填了具体值就关掉「自动」，填 0 又回到自动。\n  // 旧代码只写 memoryMB，而 overridesFromSettings 只在 autoMemory=false 时才认它，\n  // 于是「手动填了内存」一直被忽略 —— 这是设置页最容易被当成“没用”的一项。\n  $('setMemory').addEventListener('change', (e) => {\n    const v = Number(e.target.value) || 0;\n    save(v > 0 ? { engine: { memoryMB: v, autoMemory: false } } : { engine: { memoryMB: 0, autoMemory: true } });\n  });\n  $('setCores').addEventListener('change', (e) => {\n    const v = Number(e.target.value) || 0;\n    save(v > 0 ? { engine: { cores: v, autoMemory: false } } : { engine: { cores: 0, autoMemory: true } });\n  });\n  if ($('setResourceMode')) {\n    $('setResourceMode').addEventListener('change', async (e) => {\n      // 资源策略会连带改 liteMode / priorityMode / renderSize（主进程里翻译）\n      state.settings = await api.setSettings({ engine: { resourceMode: e.target.value } });\n      fillSettings(state.settings);\n      toast({ title: '资源策略已切换', body: '下一次打开应用生效', type: 'ok' });\n    });\n  }\n  if ($('setRenderSize')) {\n    $('setRenderSize').addEventListener('change', (e) => save({ engine: { renderSize: e.target.value } }));\n  }\n  if ($('setDnsPreset')) {\n    $('setDnsPreset').addEventListener('change', (e) => {\n      save({ engine: { dnsPreset: e.target.value, fastDns: e.target.value !== 'off' } });\n    });\n  }\n  if ($('setLocale')) {\n    $('setLocale').addEventListener('change', async (e) => {\n      state.settings = await api.setSettings({ engine: { locale: e.target.value } });\n      toast({ title: '系统语言已更新', body: '下次重启安卓运行时后生效', type: 'ok' });\n    });\n  }\n  if ($('setChineseIme')) {\n    $('setChineseIme').addEventListener('change', async (e) => {\n      state.settings = await api.setSettings({ engine: { chineseIme: e.target.checked } });\n      toast({\n        title: e.target.checked ? '已开启中文输入法' : '已关闭中文输入法',\n        body: '下次重启安卓运行时后生效',\n        type: 'ok',\n      });\n    });\n  }\n  if ($('setKeepSnapshot')) {\n    $('setKeepSnapshot').addEventListener('change', (e) => save({ engine: { keepSnapshot: e.target.checked } }));\n  }\n  if ($('setDataGB')) {\n    $('setDataGB').addEventListener('change', (e) => {\n      save({ engine: { dataPartitionGB: Number(e.target.value) || 0 } });\n      refreshDataInfo();\n    });\n  }\n  if ($('btnGrowData')) {\n    $('btnGrowData').addEventListener('click', async () => {\n      const gb = Number($('setDataGB').value) || 0;\n      if (!gb) { toast({ title: '先选一个容量', body: '「自动」表示由软件按磁盘余量决定，不需要扩容', type: 'info' }); return; }\n      const { response } = await api.confirm({\n        title: '立刻把安卓数据分区扩容？',\n        message: `将把 /data 调整为 ${gb} GB（就地扩容，已装应用和存档都会保留）。`,\n        detail: '扩容需要先关掉正在运行的安卓应用，完成后下次打开应用会重新引导，约多花十几秒。',\n        okLabel: '开始扩容',\n      });\n      if (response !== 1) return;\n      $('btnGrowData').disabled = true;\n      const old = $('btnGrowData').textContent;\n      $('btnGrowData').textContent = '扩容中…';\n      const r = await api.setDataSize(gb).catch((e) => ({ ok: false, error: e.message }));\n      $('btnGrowData').disabled = false;\n      $('btnGrowData').textContent = old;\n      if (r && !r.ok && r.needsReset) {\n        // 快速启动的差量盘挡着：就地扩容做不到，只能按新容量重建 /data。\n        // 这是明确的数据丢失操作，必须单独再确认一次。\n        const again = await api.confirm({\n          title: '需要重置安卓数据才能扩容',\n          message: `安卓正在使用快速启动差量盘，就地扩容改不到它。要拿到 ${gb} GB 空间，必须按新容量重建 /data。`,\n          detail: '重建会清空已安装的应用与存档（模拟器本身和镜像不受影响）。确定继续吗？',\n          okLabel: '清空并重建',\n        });\n        if (again.response !== 1) { refreshDataInfo(); return; }\n        $('btnGrowData').disabled = true;\n        $('btnGrowData').textContent = '重建中…';\n        const rr = await api.resetAndResize(gb).catch((e) => ({ ok: false, error: e.message }));\n        $('btnGrowData').disabled = false;\n        $('btnGrowData').textContent = old;\n        toast({\n          type: rr && rr.ok ? 'ok' : 'error',\n          title: rr && rr.ok ? '已按新容量重建' : '重建失败',\n          body: rr && rr.ok\n            ? `下次打开应用会按 ${gb} GB 重建 /data（首次进入会多等几十秒）`\n            : (rr && rr.error) || '未知错误',\n        });\n        refreshDataInfo();\n        return;\n      }\n      toast({\n        type: r && r.ok ? 'ok' : 'error',\n        title: r && r.ok ? '数据分区已扩容' : '扩容失败',\n        body: r && r.ok ? `现在约 ${r.fsGB || r.imageGB || gb} GB 可用` : (r && r.error) || '未知错误',\n      });\n      refreshDataInfo();\n    });\n  }\n  $('setIdle').addEventListener('change', (e) => save({ engine: { idleShutdownMinutes: Number(e.target.value) || 0 } }));\n  if ($('setSourcePref')) {\n    $('setSourcePref').addEventListener('change', (e) => save({ runtime: { sourcePreference: e.target.value } }));\n  }\n  if ($('setAutoMirror')) {\n    $('setAutoMirror').addEventListener('change', (e) => save({ runtime: { autoMirror: e.target.checked } }));\n  }\n  if ($('setGiteeToken')) {\n    $('setGiteeToken').addEventListener('change', (e) => save({ runtime: { giteeToken: e.target.value.trim() } }));\n  }\n  if ($('setMirrorPrefix')) {\n    $('setMirrorPrefix').addEventListener('change', (e) => save({ runtime: { mirrorPrefix: e.target.value.trim() } }));\n  }\n  if ($('setConnections')) {\n    $('setConnections').addEventListener('change', (e) => {\n      const n = Math.max(1, Math.min(16, Number(e.target.value) || 8));\n      e.target.value = n;\n      save({ runtime: { downloadConnections: n } });\n    });\n  }\n  $('setAudio').addEventListener('change', (e) => save({ engine: { audio: e.target.checked } }));\n  $('setLiteMode').addEventListener('change', (e) => save({ engine: { liteMode: e.target.checked } }));\n  $('setPrewarm').addEventListener('change', (e) => save({ engine: { prewarm: e.target.checked } }));\n  $('setPriorityMode').addEventListener('change', (e) => save({ engine: { priorityMode: e.target.value } }));\n  const savePointer = async (patch) => {\n    await save({ engine: patch });\n    // 立刻按当前窗口焦点重装/卸载钩子，不用等下次切窗口\n    api.refreshPointerMapping().catch(() => {});\n  };\n  $('setMouseRightBack').addEventListener('change', (e) => savePointer({ mouseRightBack: e.target.checked }));\n  $('setMouseWheelMode').addEventListener('change', (e) => savePointer({ mouseWheelMode: e.target.value }));\n  $('setMouseSideButtons').addEventListener('change', (e) => savePointer({ mouseSideButtons: e.target.checked }));\n  if ($('setKeymapEnabled')) {\n    $('setKeymapEnabled').addEventListener('change', async (e) => {\n      await api.keymap.setEnabled(e.target.checked);\n      toast({ title: e.target.checked ? '键盘映射已开启' : '键盘映射已关闭', type: 'ok' });\n    });\n  }\n  // 实验室：多开开关与后台保留数。改完提示下次打开应用生效（切换应用路径才读它）。\n  if ($('setMultiWindow')) {\n    $('setMultiWindow').addEventListener('change', (e) => {\n      save({ engine: { multiWindow: e.target.checked } });\n      toast({\n        title: e.target.checked ? '多窗口多开已开启（实验性）' : '已回到单应用模式',\n        body: e.target.checked ? '下次打开应用生效：多个应用可并存、各自独立原生窗口。' : '',\n        type: 'ok',\n      });\n    });\n  }\n  if ($('setKeepBackground')) {\n    $('setKeepBackground').addEventListener('change', (e) => {\n      save({ engine: { keepBackground: Number(e.target.value) } });\n    });\n  }\n  $('setDeepTrim').addEventListener('change', async (e) => {\n    await save({ engine: { deepTrim: e.target.checked } });\n    // 关掉深度裁剪必须把之前 pm disable-user 的包恢复回来，否则影响是持久的\n    if (!e.target.checked) {\n      api.restoreSystemApps().catch(() => {});\n      toast({ title: '已恢复系统组件', body: '深度裁剪关闭，后台包正在恢复', type: 'info' });\n    }\n  });\n  $('setCompat').addEventListener('change', async (e) => {\n    const on = e.target.checked;\n    await save({ runtime: { compatImage: on } });\n    const env = ((state.status = await api.runtimeStatus()).env) || {};\n    const ok = env.playImage && env.playImage.ok;\n    $('compatInstallField').hidden = !on || !!ok;\n    if (on && !ok) toast({ title: 'ARM 兼容模式已开启', body: '还需要下载 Google Play 兼容镜像（Android 14，约 1.5GB），点击下方按钮开始', type: 'info' });\n    else if (on) toast({ title: 'ARM 兼容模式已开启', body: '重启运行时后生效', type: 'info' });\n  });\n  $('setAutoShortcut').addEventListener('change', (e) => save({ createShortcutOnInstall: e.target.checked }));\n  $('setStartMenuShortcut').addEventListener('change', (e) => save({ createStartMenuShortcut: e.target.checked }));\n  $('setShortcutDir').addEventListener('change', (e) => save({ shortcutDir: e.target.value.trim() }));\n  $('setDeviceSharedDir').addEventListener('change', (e) => save({ deviceSharedDir: e.target.value.trim() }));\n  $('setAutoStart').addEventListener('change', (e) => save({ autoStart: e.target.checked }));\n  $('setDisplayMode').addEventListener('change', async (e) => {\n    const mode = e.target.value;\n    $('portraitField').hidden = mode === 'fullscreen';\n    state.settings = await api.setSettings({ display: { mode } });\n    toast({ title: mode === 'fullscreen' ? '已切全屏' : '已切竖屏窗口', type: 'ok' });\n  });\n  if ($('setAutoFullscreen')) {\n    $('setAutoFullscreen').addEventListener('change', async (e) => {\n      const on = e.target.value === 'on';\n      state.settings = await api.setSettings({ display: { autoFullscreenOnLaunch: on } });\n      toast({ title: on ? '已开启自动全屏' : '已关闭自动全屏', body: '下次打开应用时生效', type: 'ok' });\n    });\n  }\n  if ($('setOrientationMode')) {\n    $('setOrientationMode').addEventListener('change', async (e) => {\n      const mode = e.target.value;\n      state.settings = await api.setSettings({ display: { orientationMode: mode } });\n      toast({\n        title: mode === 'auto' ? '已设为跟随应用' : (mode === 'landscape' ? '已强制横屏' : '已强制竖屏'),\n        body: mode === 'auto'\n          ? '下次打开应用时会按应用自己的方向选面板，方向不一致的话会重启一次运行时。'\n          : '下次打开应用时会重启一次运行时把面板切到指定方向，之后不再重启。',\n        type: 'ok',\n      });\n    });\n  }\n  if ($('setAutoRotate')) {\n    $('setAutoRotate').addEventListener('change', async (e) => {\n      const on = e.target.value === 'on';\n      state.settings = await api.setSettings({ display: { autoRotate: on } });\n      toast({\n        title: on ? '已打开镜像自动旋转' : '已关闭镜像自动旋转',\n        body: '下次打开应用时写进安卓镜像。画面方向仍由屏幕方向策略决定，不受此开关影响。',\n        type: 'ok',\n      });\n    });\n  }\n  if ($('setTabletMode')) {\n    $('setTabletMode').addEventListener('change', async (e) => {\n      const on = e.target.value === 'on';\n      state.settings = await api.setSettings({ display: { tabletMode: on } });\n      toast({\n        title: on ? '已打开平板排版' : '已关闭平板排版',\n        body: '下次打开应用时生效（会重启一次运行时来改逻辑密度）。',\n        type: 'ok',\n      });\n    });\n  }\n  if ($('setLandscape')) {\n    $('setLandscape').addEventListener('change', async (e) => {\n      const landscape = e.target.value === 'landscape';\n      state.settings = await api.setSettings({ display: { landscape } });\n      toast({\n        title: landscape ? '面板已设为横屏' : '面板已设为竖屏',\n        body: '下次打开应用时会重启一次运行时来切换物理面板方向（约十几秒），之后就不会再重启。',\n        type: 'ok',\n      });\n    });\n  }\n  $('setPortrait').addEventListener('change', async (e) => {\n    state.settings = await api.setSettings({ display: { portrait: e.target.value } });\n    toast({ title: '画面大小已更新', body: '下次打开应用或切换应用时生效', type: 'ok' });\n  });\n  $('setWindowEmbed').addEventListener('change', async (e) => {\n    const embed = e.target.value === 'embed';\n    // windowEmbedChosen 标记「用户自己选过」：之后升级不会再被默认值迁移覆盖。\n    state.settings = await api.setSettings({\n      display: { windowEmbed: embed, windowEmbedChosen: true },\n    });\n    toast({\n      title: embed ? '已切回嵌入模式' : '已切到原生窗口',\n      body: embed\n        ? '下次打开应用时生效。嵌入模式观感统一、标题栏带旋转按钮，但缩放/旋转时更容易掉帧或出现黑边。'\n        : '下次打开应用时生效。原生窗口由模拟器自己渲染与排布，帧率和缩放更稳，横屏可用托盘菜单或 Ctrl+Alt+R。',\n      type: 'ok',\n    });\n  });\n  $('btnRebuildShortcuts').addEventListener('click', async () => {\n    const r = await api.rebuildShortcuts();\n    toast({\n      title: r && r.fixed && r.fixed.length ? '已补齐快捷方式' : '快捷方式都还在',\n      body: r && r.fixed && r.fixed.length ? r.fixed.join('、') : '桌面与开始菜单入口正常',\n      type: 'ok',\n    });\n  });\n\n  $('btnDiagnostics').addEventListener('click', async () => {\n    try {\n      const r = await api.doctorReport();\n      toast({ title: '诊断报告已导出', body: `${r.diagnosis.title} · ${r.file}`, type: 'ok', sticky: true });\n    } catch (e) {\n      toast({ title: '导出失败', body: e.message, type: 'error' });\n    }\n  });\n\n  $('btnCleanup').addEventListener('click', async () => {\n    const btn = $('btnCleanup');\n    const includeSnapshots = $('chkCleanSnapshots') && $('chkCleanSnapshots').checked;\n    btn.disabled = true;\n    try {\n      const preview = await api.runtimeCleanup({ apply: false, includeSnapshots });\n      if (!preview.candidates.length) {\n        toast({ title: '已经是精简状态', body: '没有可回收的旧镜像或快照。', type: 'ok' });\n        return;\n      }\n      const r = await api.runtimeCleanup({ apply: true, includeSnapshots });\n      if (r.cancelled) return;\n      toast({\n        title: '清理完成',\n        body: `释放约 ${(r.saved / 1048576).toFixed(0)} MB（${r.removed.length} 项），已安装应用保留。`,\n        type: 'ok',\n      });\n      const u = await api.runtimeUsage();\n      $('usageText').textContent = `共 ${u.totalText} · 可回收 ${u.reclaimableText}（${u.count} 项）`;\n    } catch (e) {\n      toast({ title: '清理失败', body: e.message, type: 'error' });\n    } finally {\n      btn.disabled = false;\n    }\n  });\n\n  // 重置安卓数据：二级确认（先确认意图，再确认不可撤销），清完刷新占用统计\n  $('btnResetData').addEventListener('click', async () => {\n    const btn = $('btnResetData');\n    btn.disabled = true;\n    try {\n      const first = await api.confirm({\n        type: 'warning',\n        title: '重置安卓数据？',\n        message: '这会把安卓系统还原成「刚装好系统」的干净状态：',\n        detail: '• 删除全部已安装的第三方 app（含红果、游戏等）及其数据、登录态\\n'\n          + '• 删除当前 AVD 的快速启动快照\\n'\n          + '• 系统镜像本身不受影响，重新打开应用会再次冷启动建数据\\n\\n'\n          + '此操作不可撤销。是否继续？',\n        buttons: ['取消', '继续'],\n        defaultId: 0,\n        cancelId: 0,\n      });\n      if (!first || first.response !== 1) return;\n      const second = await api.confirm({\n        type: 'warning',\n        title: '再确认一次',\n        message: '已安装的 app 和它们的数据将被永久删除，确定要重置吗？',\n        detail: '可放心的是：系统镜像、其它 AVD、本机的 APK 缓存和图标都不会动。',\n        buttons: ['取消', '确定重置'],\n        defaultId: 0,\n        cancelId: 0,\n      });\n      if (!second || second.response !== 1) return;\n      const r = await api.runtimeResetData();\n      if (!r || !r.ok) {\n        toast({ title: '重置失败', body: (r && r.error) || '请重试', type: 'error' });\n        return;\n      }\n      toast({\n        title: '安卓数据已重置',\n        body: `释放约 ${r.reclaimedMB} MB，已安装应用记录已清空。`,\n        type: 'ok',\n      });\n      const u = await api.runtimeUsage();\n      $('usageText').textContent = `共 ${u.totalText} · 可回收 ${u.reclaimableText}（${u.count} 项）`;\n    } catch (e) {\n      toast({ title: '重置失败', body: e.message, type: 'error' });\n    } finally {\n      btn.disabled = false;\n    }\n  });\n\n  // 修复网络：安卓里联网页面一直黑屏（红果点「同意并继续」后整屏黑）时用。\n  // 根因是虚拟机 /data 里的 Wi-Fi 配置坏了，wlan0 没起来、没有默认路由。\n  // Play Store 镜像不允许 root，只能整体重置 /data；应用清单保留，点开时会自动重装。\n  $('btnRepairNetwork').addEventListener('click', async () => {\n    const btn = $('btnRepairNetwork');\n    btn.disabled = true;\n    try {\n      const ok = await api.confirm({\n        type: 'warning',\n        title: '修复虚拟机网络？',\n        message: '应用里需要联网的页面一直黑屏/转圈，通常是安卓虚拟机没有网络。',\n        detail: '修复会按「代价从小到大」依次尝试：\\n\\n'\n          + '1. 冷启动虚拟机（不加载快照）后等待联网 —— 不影响任何数据\\n'\n          + '2. 仍不行才重置安卓数据 —— 应用清单保留、点开会自动重装，\\n'\n          + '   但应用内的登录态、追剧记录等会丢失\\n\\n'\n          + '只影响当前 AVD，系统镜像和本机 APK 缓存都不动。整个过程约 1–5 分钟。是否继续？',\n        buttons: ['取消', '开始修复'],\n        defaultId: 0,\n        cancelId: 0,\n      });\n      if (!ok || ok.response !== 1) return;\n      const r = await api.runtimeRepairNetwork();\n      if (!r || !r.ok) {\n        toast({\n          title: '网络仍未恢复',\n          body: (r && r.error) || '重置后虚拟机还是没网，请检查本机网络/防火墙是否拦住了模拟器。',\n          type: 'error',\n        });\n        return;\n      }\n      toast({\n        title: '网络已恢复',\n        body: `${(r.network && r.network.ip) || '已联网'}${r.wiped ? '（为修复网络重置过安卓数据，点开应用会自动重装）' : '（未动你的数据）'}`,\n        type: 'ok',\n      });\n    } catch (e) {\n      toast({ title: '修复失败', body: e.message, type: 'error' });\n    } finally {\n      btn.disabled = false;\n    }\n  });\n\n  // 清理旧版本残留：扫描旧程序目录 / 失效卸载项 / 更新临时文件，确认后一次性清掉。\n  $('btnLeftovers').addEventListener('click', async () => {\n    const btn = $('btnLeftovers');\n    btn.disabled = true;\n    try {\n      const r = await api.leftoversScan();\n      if (!r || !r.ok) {\n        toast({ title: '扫描失败', body: (r && r.error) || '请重试', type: 'error' });\n        return;\n      }\n      const items = r.items || [];\n      if (!items.length) {\n        toast({ title: '很干净', body: '没有发现旧版本残留。', type: 'ok' });\n        return;\n      }\n      const mb = Math.round((r.totalBytes || 0) / 1048576);\n      const lines = items.slice(0, 8).map((x) => `• ${x.note}：${x.path}`);\n      if (items.length > 8) lines.push(`…另有 ${items.length - 8} 项`);\n      const ok = await api.confirm({\n        type: 'warning',\n        title: '清理旧版本残留？',\n        message: `找到 ${items.length} 项残留，约 ${mb} MB：`,\n        detail: `${lines.join('\\n')}\\n\\n只删除「旧版本程序目录 / 已失效的卸载项 / 更新临时文件」，`\n          + '当前正在运行的版本和你的应用数据都不会动。',\n        buttons: ['取消', '开始清理'],\n        defaultId: 1,\n        cancelId: 0,\n      });\n      if (!ok || ok.response !== 1) return;\n      const c = await api.leftoversClean(items);\n      if (!c || !c.ok) {\n        toast({ title: '清理失败', body: (c && c.error) || '请重试', type: 'error' });\n        return;\n      }\n      const failNote = (c.failed && c.failed.length) ? `，${c.failed.length} 项被占用未删` : '';\n      toast({\n        title: '已清理旧版本残留',\n        body: `删除 ${c.removed.length} 项，释放 ${c.freedMB || 0} MB${failNote}。`,\n        type: 'ok',\n      });\n      const u = await api.runtimeUsage();\n      $('usageText').textContent = `共 ${u.totalText} · 可回收 ${u.reclaimableText}（${u.count} 项）`;\n    } catch (e) {\n      toast({ title: '清理失败', body: e.message, type: 'error' });\n    } finally {\n      btn.disabled = false;\n    }\n  });\n\n  $('btnOpenShared').addEventListener('click', () => api.openSharedDir());\n\n  // 重建快捷方式：桌面图标被误删 / 被安全软件拦掉时的兜底入口\n  $('btnRebuildShortcuts').addEventListener('click', async () => {\n    const btn = $('btnRebuildShortcuts');\n    btn.disabled = true;\n    try {\n      const r = await api.rebuildShortcuts().catch(() => ({ ok: false }));\n      const fixed = (r && r.fixed) || [];\n      toast(fixed.length\n        ? { title: '快捷方式已重建', body: fixed.join('、'), type: 'ok' }\n        : { title: '快捷方式都在', body: '没有需要重建的入口', type: 'info' });\n    } finally {\n      btn.disabled = false;\n    }\n  });\n\n  // 共享目录：先浏览选目录，再「保存并迁移」把旧文件一次性搬到新目录\n  $('btnBrowseShared').addEventListener('click', async () => {\n    const picked = await api.openDir();\n    if (!picked) return;\n    $('setSharedDir').value = picked;\n    toast({ title: '已选新目录', body: '点「保存并迁移」把旧文件搬过去', type: 'info' });\n  });\n  $('btnSaveShared').addEventListener('click', async () => {\n    const dir = $('setSharedDir').value.trim();\n    if (!dir) { toast({ title: '请先填写或浏览目录', type: 'error' }); return; }\n    const btn = $('btnSaveShared');\n    btn.disabled = true;\n    const r = await api.setSharedDir(dir).catch(() => ({ ok: false }));\n    btn.disabled = false;\n    if (r.ok) {\n      const moved = r.oldDir && r.oldDir !== r.newDir;\n      toast({ title: '共享目录已更新', body: moved ? '旧目录里已有的文件已迁移到新目录' : '已保存', type: 'ok' });\n    } else {\n      toast({ title: '保存失败', body: r.error, type: 'error' });\n    }\n  });\n\n  // 一键卸载 ApkStart 本体（取消 .apk 关联 + 启动卸载程序；便携版手动删除）\n  $('btnUninstall').addEventListener('click', async () => {\n    const ok = window.confirm('确定卸载 ApkStart？\\n\\n将取消 .apk 文件关联并移除程序。此操作不可撤销。');\n    if (!ok) return;\n    const btn = $('btnUninstall');\n    btn.disabled = true;\n    const r = await api.removeSelf().catch(() => ({ ok: false }));\n    if (r.ok && r.portable) {\n      btn.disabled = false;\n      toast({\n        title: '便携版无法自动卸载',\n        body: `请手动删除程序目录（${r.exeDir}）与数据目录（${r.dataDir}）`,\n        type: 'info', sticky: true,\n      });\n      return;\n    }\n    if (!r.ok) {\n      btn.disabled = false;\n      toast({ title: '卸载失败', body: r.error, type: 'error' });\n      return;\n    }\n    toast({ title: '正在卸载…', body: '卸载程序已启动，ApkStart 即将退出', type: 'ok', sticky: true });\n  });\n\n  // ARM 兼容镜像下载（带进度 toast）\n  $('btnInstallPlay').addEventListener('click', async () => {\n    const btn = $('btnInstallPlay');\n    btn.disabled = true;\n    const t = toast({ title: '开始下载 ARM 兼容镜像', body: '准备中…', sticky: true, spinner: true, progress: 3 });\n    const un = api.on('provision:progress', (p) => {\n      if (p.component !== 'playimg') return;\n      t.update({ title: '下载 ARM 兼容镜像', body: p.message || '', progress: p.percent });\n    });\n    try {\n      const r = await api.installPlayImage();\n      if (r && r.ok) {\n        t.update({ title: 'ARM 兼容镜像就绪', body: '重启运行时后生效', progress: 100 });\n        setTimeout(() => t.dismiss(), 3000);\n        $('compatInstallField').hidden = true;\n        refreshStatus();\n      } else {\n        t.update({ title: '兼容镜像下载失败', body: (r && r.error) || '未知错误', progress: null });\n        t.dismiss();\n        toast({ title: '兼容镜像下载失败', body: (r && r.error) || '未知错误', type: 'error' });\n      }\n    } catch (e) {\n      t.dismiss();\n      toast({ title: '兼容镜像下载失败', body: e.message, type: 'error' });\n    } finally {\n      un();\n      btn.disabled = false;\n    }\n  });\n\n  // 兼容镜像状态显示\n  (async () => {\n    const env = ((state.status = await api.runtimeStatus()).env) || {};\n    const s = state.settings;\n    const on = !!(s && s.runtime && s.runtime.compatImage);\n    const ok = env.playImage && env.playImage.ok;\n    $('compatInstallField').hidden = !on || !!ok;\n    if (env.playImage) {\n      $('compatImgStatus').textContent = ok\n        ? `已就绪（${(env.playImage.size / 1073741824).toFixed(2)} GB）` : '未下载';\n    }\n  })();\n  $('btnOpenData').addEventListener('click', async () => {\n    const info = await api.info();\n    const dir = info.runtimeDir || info.dataDir;\n    window.open(`file:///${dir.replace(/\\\\/g, '/')}`);\n  });\n  $('btnBrowseRuntimeDir').addEventListener('click', async () => {\n    const info = await api.info();\n    const picked = await api.openDir();\n    if (!picked) return;\n    await api.setSettings({ runtime: { dir: picked } });\n    $('setRuntimeDir').value = picked;\n    toast({ title: '数据目录已更新', body: '请重启 ApkStart 使其生效（旧数据不会自动搬移）', type: 'ok', sticky: true });\n  });\n\n  // 安卓数据目录（AVD + 快照）：真正吃盘的那块，单独指到别的盘\n  if ($('btnBrowseAvdDir')) {\n    $('btnBrowseAvdDir').addEventListener('click', async () => {\n      const picked = await api.openDir();\n      if (!picked) return;\n      await api.setSettings({ runtime: { avdDir: picked } });\n      $('setAvdDir').value = picked;\n      toast({\n        title: '安卓数据目录已更新',\n        body: '请重启 ApkStart 使其生效。旧目录里的 apkstart.avd 可以整体搬到新目录，再删掉旧的。',\n        type: 'ok',\n        sticky: true,\n      });\n    });\n  }\n  if ($('btnOpenAvdDir')) {\n    $('btnOpenAvdDir').addEventListener('click', async () => {\n      const info = await api.dataInfo().catch(() => null);\n      const dir = (info && info.avdDir) || (await api.info()).dataDir;\n      window.open(`file:///${String(dir).replace(/\\\\/g, '/')}`);\n    });\n  }\n\n  $('btnRuntimeStart').addEventListener('click', async () => {\n    const el = $('probeResult');\n    el.textContent = '正在启动…';\n    const r = await api.runtimeStart();\n    el.textContent = r.ok ? `已就绪：${r.engine}` : `启动失败：${r.error}`;\n    refreshStatus();\n  });\n\n  $('btnRuntimeStop').addEventListener('click', async () => {\n    await api.runtimeStop();\n    $('probeResult').textContent = '已停止内置虚拟机';\n    refreshStatus();\n  });\n\n  $('btnAssoc').addEventListener('click', async () => {\n    const btn = $('btnAssoc');\n    if (btn.dataset.on === '1') {\n      await api.assocUnregister();\n      btn.textContent = '未关联 · 点击开启';\n      btn.dataset.on = '0';\n      toast({ title: '.apk 关联已取消' });\n    } else {\n      const r = await api.assocRegister();\n      btn.textContent = '已关联 · 点击取消';\n      btn.dataset.on = '1';\n      toast({ title: '.apk 关联已开启', body: r.ok ? '现在双击 APK 会直接安装到 ApkStart' : '', type: r.ok ? 'ok' : 'error' });\n    }\n  });\n}\n\n/* ---------------- 事件绑定 ---------------- */\n\nfunction bindEvents() {\n  // 链接统一走系统浏览器\n  document.addEventListener('click', (e) => {\n    const a = e.target.closest && e.target.closest('a[href^=\"http\"]');\n    if (!a) return;\n    e.preventDefault();\n    api.openExternal(a.getAttribute('href'));\n  });\n\n  $('btnSettings').addEventListener('click', openSettings);\n  // 0.6.2：内置手册从标题栏和「关于」页都能直接打开\n  $('btnManual')?.addEventListener('click', () => openManual({ topic: 'overview', reason: 'toolbar' }));\n  $('btnOpenManual')?.addEventListener('click', () => openManual({ topic: 'overview', reason: 'about' }));\n  // 状态标签也当入口：点「需要部署 / 引导中 / Android 14」直接进设置的运行时面板\n  $('engineTag').addEventListener('click', () => showSetup(true));\n  $('btnCloseSettings').addEventListener('click', closeSettings);\n  $('btnDoneSettings').addEventListener('click', closeSettings);\n  $('settingsMask').addEventListener('click', (e) => {\n    if (e.target === $('settingsMask')) closeSettings();\n  });\n\n  // 运行时部署：入口已收进设置，这里只处理面板内的按钮\n  $('btnDeployAll').addEventListener('click', deployAll);\n  $('btnMarkInstalled').addEventListener('click', markInstalled);\n  $('btnGuideClose').addEventListener('click', () => { $('setupGuide').hidden = true; });\n  $('btnSetupAdvanced').addEventListener('click', () => {\n    const adv = document.querySelector('.advanced-group');\n    if (adv) {\n      adv.open = true;\n      adv.scrollIntoView({ block: 'start', behavior: 'smooth' });\n    }\n  });\n\n  // 状态条上的自检计数：点开就是设置里的运行时面板\n  $('envChip').addEventListener('click', () => {\n    openSettings().then(() => {\n      const box = $('envCheck');\n      if (box && !box.hidden) focusGroup(box);\n      else focusGroup($('runtimeGroup'));\n    }).catch(() => {});\n  });\n\n  $('setupSteps').addEventListener('click', async (e) => {\n    const btn = e.target.closest('[data-act]');\n    if (!btn || btn.disabled) return;\n    const act = btn.dataset.act;\n    if (act === 'emulator' || act === 'sysimg' || act === 'accel'\n      || act === 'adb' || act === 'qemu' || act === 'iso' || act === 'disk') {\n      const r = await runStep(act);\n      if (!r.ok) toast({ title: '操作失败', body: r.error, type: 'error', sticky: true });\n      return;\n    }\n    if (act === 'isoImport') {\n      const r = await api.importIso();\n      if (r.ok) { toast({ title: '系统镜像已导入', body: r.path, type: 'ok' }); refreshStatus(); }\n      else if (!r.canceled) toast({ title: '导入失败', body: r.error, type: 'error' });\n      return;\n    }\n    if (act === 'diskImport') {\n      const r = await api.importDisk();\n      if (r.ok) { toast({ title: '虚拟磁盘已导入', body: '可直接启动运行时', type: 'ok' }); refreshStatus(); }\n      else if (!r.canceled) toast({ title: '导入失败', body: r.error, type: 'error' });\n      return;\n    }\n    if (act === 'install') { await startInstall(); return; }\n    if (act === 'vmStart') {\n      const t = toast({ title: '正在启动运行时…', body: '首次启动需要引导 Android 系统', sticky: true, spinner: true });\n      const r = await api.runtimeStart();\n      if (r.ok) { t.update({ title: '运行时已就绪', type: 'ok' }); setTimeout(t.dismiss, 2200); }\n      else t.update({ title: '启动失败', body: r.error, type: 'error' });\n      refreshStatus();\n      return;\n    }\n    if (act === 'vmStop') {\n      await api.runtimeStop();\n      toast({ title: '运行时会话已结束' });\n      refreshStatus();\n    }\n  });\n\n  const pick = async () => {\n    const files = await api.pickApk();\n    if (files.length) installFiles(files);\n  };\n  $('btnInstall').addEventListener('click', pick);\n  $('btnInstall2').addEventListener('click', pick);\n  // 共享目录入口移到设置里：同步 + 打开都在「文件互通」组内\n  const btnSync = $('btnSyncShared');\n  if (btnSync) btnSync.addEventListener('click', async () => {\n    btnSync.disabled = true;\n    try {\n      await api.syncShared();\n      toast({ title: '已同步共享目录', type: 'ok' });\n    } catch (_) {\n      toast({ title: '同步失败', body: '运行时未就绪时会跳过同步', type: 'error' });\n    } finally {\n      btnSync.disabled = false;\n    }\n  });\n\n  $('search').addEventListener('input', (e) => {\n    state.filter = e.target.value;\n    renderGrid();\n  });\n\n  $('grid').addEventListener('click', (e) => {\n    const card = e.target.closest('.card');\n    if (!card) return;\n    // 「添加应用」卡片没有 data-pkg，走安装流程而不是启动。\n    // 直接转调工具栏那个「安装 APK」按钮，复用它的文件选择逻辑。\n    if (card.classList.contains('card-add')) { $('btnInstall').click(); return; }\n    if (card.dataset.pkg) launchApp(card.dataset.pkg);\n  });\n\n  $('grid').addEventListener('contextmenu', (e) => {\n    const card = e.target.closest('.card');\n    if (!card) return;\n    e.preventDefault();\n    showMenu(e.clientX, e.clientY, card.dataset.pkg);\n  });\n\n  $('grid').addEventListener('dblclick', (e) => {\n    const card = e.target.closest('.card');\n    if (card) createShortcut(card.dataset.pkg);\n  });\n\n  $('ctxmenu').addEventListener('click', (e) => {\n    const item = e.target.closest('.item');\n    if (item) handleMenu(item.dataset.act);\n  });\n\n  document.addEventListener('click', (e) => {\n    if (!e.target.closest('#ctxmenu')) hideMenu();\n  });\n\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      hideMenu();\n      closeSettings();\n    }\n    if (e.ctrlKey && e.key.toLowerCase() === 'f') {\n      e.preventDefault();\n      $('search').focus();\n    }\n  });\n\n  // 拖放安装\n  let dragDepth = 0;\n  window.addEventListener('dragenter', (e) => {\n    e.preventDefault();\n    dragDepth++;\n    $('dropzone').classList.add('on');\n  });\n  window.addEventListener('dragover', (e) => e.preventDefault());\n  window.addEventListener('dragleave', (e) => {\n    e.preventDefault();\n    dragDepth = Math.max(0, dragDepth - 1);\n    if (dragDepth === 0) $('dropzone').classList.remove('on');\n  });\n  window.addEventListener('drop', (e) => {\n    e.preventDefault();\n    dragDepth = 0;\n    $('dropzone').classList.remove('on');\n    const files = [...(e.dataTransfer?.files || [])];\n    const paths = files\n      .map((f) => { try { return api.pathForFile(f); } catch (_) { return null; } })\n      .filter((p) => p && /\\.apk$/i.test(p));\n    if (paths.length) installFiles(paths);\n    else toast({ title: '只能拖入 .apk 文件', type: 'error' });\n  });\n\n  // 主进程事件\n  api.on('install:error', (p) => {\n    // 报错了就别再让「正在安装…」那条一直转圈（可能来自双击 APK 的另一条链路）\n    if (installToast) { try { installToast.dismiss(); } catch (_) { /* ignore */ } installToast = null; }\n    const name = p && p.file ? String(p.file).split(/[\\\\/]/).pop() : '';\n    const raw = (p && p.message) || '未知错误';\n    toast({\n      title: name ? `安装失败：${name}` : '安装失败',\n      body: friendlyInstallErrorText(raw),\n      type: 'error',\n    });\n    // 0.6.2：安装失败自动把对应章节推到用户面前（ARM / 签名 / 空间…）\n    openManualForError(raw, 'install-failed');\n  });\n  api.on('toast', (p) => toast({ title: p.message, type: p.type === 'error' ? 'error' : 'info' }));\n  api.on('app:launched', () => setTimeout(refreshApps, 800));\n  // 应用被关掉（托盘「关闭当前应用」、右键菜单、或窗口被关）后要刷新「运行中」标记\n  api.on('apps:changed', () => setTimeout(refreshApps, 300));\n  api.on('runtime:log', (m) => console.log('[runtime]', m));\n  api.on('ui:navigate', (v) => {\n    if (v === 'settings') openSettings();\n    if (v === 'setup') { showSetup(true); refreshStatus(); }\n  });\n  api.on('provision:progress', (p) => updateStepProgress(p.component, p));\n  api.on('update:state', (info) => {\n    if (!info) return;\n    renderUpdate(info);\n    // 启动 8 秒后才拿到更新信息：欢迎卡若还开着，把「发现新版本」这条补进去\n    const wm = $('welcomeMask');\n    if (wm && !wm.hidden) renderWelcomeTips();\n  });\n  api.on('update:progress', (p) => renderUpdateProgress(p));\n  // 自动检测：主进程定时跑完后把结果推过来，设置页开着就直接刷新面板\n  api.on('autodebug:state', (r) => {\n    if (r && r.running) {\n      const txt = $('autodebugStateText');\n      if (txt) txt.textContent = '正在检测…';\n      return;\n    }\n    renderAutodebug(r);\n  });\n}\n\n/* ---------------- 启动 ---------------- */\n\nasync function init() {\n  bindEvents();\n  bindSettings();\n  bindSettingsCategory();\n  bindAutodebug();\n  bindUpdate();\n  bindAndroid();\n  bindWelcome();\n  state.settings = await api.getSettings();\n  await refreshStatus();\n  await refreshApps();\n  refreshAndroid();\n  selfCheck();\n  maybeShowWelcome();\n  setInterval(refreshStatus, 6000);\n  setInterval(refreshApps, 15000);\n  setInterval(selfCheck, 60000);\n}\n\n/* ---------------- 启动欢迎卡 ---------------- */\n\nlet startupInfo = null;\n\nfunction greetingOf(h) {\n  if (h < 5) return '夜深了';\n  if (h < 11) return '早上好';\n  if (h < 13) return '中午好';\n  if (h < 18) return '下午好';\n  return '晚上好';\n}\n\nfunction bindWelcome() {\n  const mask = $('welcomeMask');\n  if (!mask) return;\n  const close = () => { mask.hidden = true; };\n  const never = $('welcomeNever');\n  $('welcomeOk').addEventListener('click', () => {\n    if (never && never.checked) api.setSettings({ welcome: { disabled: true } }).catch(() => {});\n    close();\n  });\n  $('welcomeSettings').addEventListener('click', () => { close(); openSettings(); });\n  mask.addEventListener('click', (e) => { if (e.target === mask) close(); });\n  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mask.hidden) close(); });\n}\n\n/** 决定要不要弹：开机自启必弹；手动打开则每天最多一次，且用户可永久关闭 */\nasync function maybeShowWelcome() {\n  const mask = $('welcomeMask');\n  if (!mask) return;\n  // 冒烟截图时不要弹欢迎卡：否则每次自动截图都被它挡住主界面\n  try { if ((await api.startupInfo()).smoke) return; } catch (_) { /* ignore */ }\n  try { startupInfo = await api.startupInfo(); } catch (_) { startupInfo = null; }\n  const cfg = (state.settings && state.settings.welcome) || {};\n  if (cfg.disabled) return;\n  const today = new Date().toISOString().slice(0, 10);\n  if (!(startupInfo && startupInfo.autostart) && cfg.lastDate === today) return;\n\n  const h = new Date().getHours();\n  $('welcomeHi').textContent = `${greetingOf(h)}，欢迎回来`;\n  const ver = (startupInfo && startupInfo.version) || (state.status && state.status.version) || '';\n  const ready = state.status && state.status.ready;\n  $('welcomeSub').textContent = `ApkStart${ver ? ` v${ver}` : ''} · ${ready ? '运行时就绪，点开即用' : '运行时会按需自动准备'}`;\n\n  const apps = (state.apps || []).length;\n  const dev = $('statusDevice') ? $('statusDevice').textContent.trim() : '';\n  const chips = [\n    { k: String(apps), v: '已装应用' },\n    { k: ready ? '就绪' : '待命', v: '安卓运行时' },\n    { k: dev ? dev.replace(/^.*?(\\d+)/, '$1') : '—', v: '设备 / 端口' },\n  ];\n  $('welcomeStats').innerHTML = chips\n    .map((c) => `<div class=\"welcome-stat\"><b>${esc(c.k)}</b><span>${esc(c.v)}</span></div>`)\n    .join('');\n\n  const tips = [];\n  $('welcomeTips').innerHTML = '';\n  mask.hidden = false;\n  renderWelcomeTips();\n  api.setSettings({ welcome: { lastDate: today } }).catch(() => {});\n}\n\n/** 提示区单独渲染：启动 8 秒后才拿到更新信息，那时卡片可能还开着，需要补一次 */\nfunction renderWelcomeTips() {\n  const box = $('welcomeTips');\n  if (!box) return;\n  const apps = (state.apps || []).length;\n  const tips = [];\n  if (lastUpdate && lastUpdate.hasUpdate) {\n    tips.push(`发现新版本 <b>${esc(lastUpdate.tag || '')}</b>，可在「设置 → 软件更新」一键更新`);\n  }\n  if (!apps) {\n    tips.push('把 APK 拖进窗口就能安装，装完会自动生成桌面图标');\n  } else {\n    tips.push('双击应用卡片即可在独立窗口中运行，右上角可旋转 / 缩放 / 关闭');\n  }\n  tips.push('关窗口只是退出那个应用，安卓环境会留着，下次点开更快');\n  box.innerHTML = tips\n    .map((t, i) => `<div class=\"welcome-tip\"><i>${i + 1}</i><span>${t}</span></div>`)\n    .join('');\n}\n\n/* ---------------- 环境自检 ---------------- */\n\nlet envBusy = false;\n\n/** 拉取 doctor:selfCheck：把问题渲染到设置里的自检面板，并在状态条上留一个计数 */\nasync function selfCheck() {\n  if (envBusy) return;\n  envBusy = true;\n  try {\n    const r = await api.selfCheck().catch(() => null);\n    if (r) renderEnvCheck(r);\n  } catch (_) { /* 自检失败不阻断主流程 */ }\n  finally { envBusy = false; }\n}\n\nfunction renderEnvCheck(r) {\n  const box = $('envCheck');\n  if (!box) return;\n  // 「组件缺失」在同一个面板的一键完成里已经覆盖，不再重复列出\n  const needDeploy = !!(state.status && state.status.needsSetup);\n  const issues = (r.issues || []).filter((i) => !(needDeploy && i.fix === 'deploy'));\n\n  // 主界面不再放横幅：只在底部状态条上留一个可点的计数，点开就是设置里的自检面板\n  const chip = $('envChip');\n  if (chip) {\n    const errs = issues.filter((i) => i.severity === 'error').length;\n    chip.hidden = issues.length === 0;\n    chip.textContent = errs ? `${errs} 项待修复` : `${issues.length} 项提示`;\n    chip.className = `status-chip${errs ? ' err' : ''}`;\n    chip.title = issues.map((i) => i.title).join('；');\n  }\n\n  if (!issues.length) {\n    box.hidden = false;\n    box.innerHTML = `\n      <div class=\"env-check-ok\">\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n        <span>环境自检通过，没有发现会影响运行的问题。</span>\n        <span style=\"flex:1\"></span>\n        <button class=\"btn ghost sm\" id=\"btnEnvRecheck\">重新检查</button>\n      </div>`;\n    const re = $('btnEnvRecheck');\n    if (re) re.addEventListener('click', selfCheck);\n    return;\n  }\n  const errs = issues.filter((i) => i.severity === 'error').length;\n  const warns = issues.length - errs;\n  box.hidden = false;\n  box.innerHTML = `\n    <div class=\"env-check-head\">\n      <span class=\"ec-title\">环境自检</span>\n      ${errs ? `<span class=\"ec-count\">${errs} 个严重</span>` : ''}\n      ${warns ? `<span class=\"ec-count warn\">${warns} 个提示</span>` : ''}\n      <span class=\"ec-spacer\"></span>\n      <button class=\"btn ghost sm\" id=\"btnEnvRecheck\">重新检查</button>\n      <button class=\"btn primary sm\" id=\"btnEnvFixAll\">一键修复全部</button>\n    </div>\n    <div class=\"env-check-list\">\n      ${issues.map((i) => `\n        <div class=\"env-check-item ${i.severity}\">\n          <span class=\"ec-sev\"></span>\n          <div class=\"ec-body\">\n            <div class=\"ec-name\">${esc(i.title)}</div>\n            <div class=\"ec-hint\">${esc(i.hint || '')}</div>\n          </div>\n          ${i.fix ? `<button class=\"ec-fix\" data-code=\"${esc(i.code)}\">修复</button>` : ''}\n          <button class=\"ec-help\" data-code=\"${esc(i.code)}\" title=\"打开内置教程\">教程</button>\n        </div>`).join('')}\n    </div>`;\n  const re = $('btnEnvRecheck');\n  if (re) re.addEventListener('click', selfCheck);\n  const fixAll = $('btnEnvFixAll');\n  if (fixAll) fixAll.addEventListener('click', () => fixAllIssues(issues));\n  box.querySelectorAll('.ec-fix').forEach((b) => {\n    b.addEventListener('click', () => {\n      const issue = issues.find((x) => x.code === b.dataset.code);\n      if (issue) fixIssue(issue);\n    });\n  });\n  box.querySelectorAll('.ec-help').forEach((b) => {\n    b.addEventListener('click', () => {\n      const issue = issues.find((x) => x.code === b.dataset.code);\n      if (issue) openManualForIssue(issue, 'clicked');\n    });\n  });\n}\n\n/** 修复没成功：如实报错，并把对应教程自动打开（同一章节主进程 60 秒内只弹一次） */\nfunction failFix(issue, ctl, body) {\n  const msg = body || '请按教程手动处理';\n  if (ctl && typeof ctl.update === 'function') ctl.update({ body: msg, type: 'error', sticky: true });\n  else toast({ title: '修复未完成', body: msg, type: 'error' });\n  openManualForIssue(issue, 'fix-failed');\n}\n\nasync function fixIssue(issue) {\n  switch (issue.fix) {\n    case 'vcRedist': {\n      const r = await api.installVcRedist().catch(() => ({ ok: false }));\n      if (!r.ok && r.reason === 'no-installer') {\n        api.openExternal('https://learn.microsoft.com/zh-CN/cpp/windows/latest-supported-vc-redist?view=msvc-170#visual-studio-2015-2017-2019-and-2022');\n        toast({ title: '未找到内置安装包', body: '已打开微软官方下载页，请下载 x64 版本', type: 'info' });\n        break;\n      }\n      toast(r.ok\n        ? { title: 'VC++ 运行库已安装', type: 'ok' }\n        : { title: '安装未完成', body: r.error || '请重试', type: 'error' });\n      break;\n    }\n    case 'virtualization': {\n      const t = toast({ title: '正在开启硬件加速…', body: '请在弹出的窗口点「是」', sticky: true, spinner: true });\n      const r = await api.enableVirtualization().catch(() => ({ ok: false }));\n      if (r.ok) {\n        t.update({ title: '硬件加速已启用', body: r.restartNeeded ? '请重启电脑以获得最佳性能' : (r.note || ''), type: 'ok' });\n        setTimeout(t.dismiss, 3200);\n      } else if (r.manual) {\n        // 商店（MSIX）版：包固定 mediumIL，通常拿不到管理员授权。\n        // 与其让用户点一个注定失败的按钮，不如直接把「启用或关闭 Windows 功能」\n        // 对话框弹出来，并告诉他勾哪一项。\n        t.dismiss();\n        await api.openWindowsFeatures?.().catch(() => null);\n        toast({\n          title: '需要手动开启一次（仅此一次）',\n          body: r.note || '在打开的窗口里勾选「Windows 虚拟机监控程序平台」，确定后重启电脑。',\n          type: 'info',\n          sticky: true,\n        });\n        // 自动提权走不通时，同步把图文教程打开，避免用户对着系统窗口不知道勾哪个\n        openManualForIssue(issue, 'fix-failed');\n      } else if (r.cancelled) {\n        t.update({ title: '已取消', body: r.error || '没有拿到管理员授权，硬件加速没有改动。', type: 'info', spinner: false });\n        setTimeout(t.dismiss, 4200);\n      } else {\n        failFix(issue, t, r.error || r.note || '未能开启硬件加速，已打开对应教程');\n      }\n      break;\n    }\n    case 'disk': {\n      // 主进程会弹出原生确认框（含可释放空间预览），这里不再重复 confirm\n      const r = await api.runtimeCleanup({ apply: true }).catch(() => null);\n      if (!r) { toast({ title: '清理失败', body: '请重试', type: 'error' }); break; }\n      if (r.cancelled) break;\n      toast({ title: '清理完成', body: `释放约 ${((r.saved || 0) / 1048576).toFixed(0)} MB`, type: 'ok' });\n      break;\n    }\n    case 'path': {\n      toast({ title: '建议改到纯英文目录', body: '在 设置 → 系统集成 里修改「运行时数据目录」，再重启软件。', type: 'info', sticky: true });\n      openSettings();\n      break;\n    }\n    case 'deploy': {\n      toast({ title: '正在补齐缺失的运行时组件…', type: 'info', sticky: true, spinner: true });\n      await deployAll();\n      break;\n    }\n    case 'lock': {\n      const r = await api.clearLocks().catch(() => ({ ok: false }));\n      toast(r.ok ? { title: '已清理残留锁文件', type: 'ok' } : { title: '清理失败', body: r.error, type: 'error' });\n      break;\n    }\n    // ---- 自动检测（自动 debug）新增的修复动作 ----\n    case 'restartRuntime': {\n      // unauthorized / 引导卡死 / 孤儿锁的首选自愈动作：停一次再拉起来（走冷启动）\n      const t = toast({ title: '正在重启安卓运行时…', body: '会重新引导一次，大约十几秒', type: 'info', sticky: true, spinner: true });\n      const r = await api.restartRuntime().catch(() => ({ ok: false }));\n      if (r && r.ok) {\n        t.update({ title: '安卓运行时已重启', body: '授权弹窗请点「允许」', type: 'ok' });\n        setTimeout(t.dismiss, 3000);\n      } else {\n        failFix(issue, t, (r && r.error) || '重启失败，已打开对应教程');\n      }\n      break;\n    }\n    case 'orphans': {\n      const r = await api.clearOrphans().catch(() => ({ ok: false }));\n      toast(r && r.ok\n        ? { title: '已清理残留的模拟器进程', type: 'ok' }\n        : { title: '清理失败', body: (r && r.error) || '请重试', type: 'error' });\n      break;\n    }\n    case 'snapshots': {\n      const r = await api.clearSnapshot().catch(() => ({ ok: false }));\n      toast(r && r.ok\n        ? { title: '已作废快速启动快照', body: '下次打开应用会走一次完整冷启动', type: 'ok' }\n        : { title: '作废失败', body: (r && r.error) || '请重试', type: 'error' });\n      break;\n    }\n    case 'dataReset': {\n      // 扩容被差量盘挡住时必须重建：会清掉已装应用，所以只引导、不自动做。\n      toast({\n        title: '需要重建安卓数据分区',\n        body: '到「设置 → 性能与资源」点「立即扩容」；提示需要重置时确认一次（会清空已装应用）。',\n        type: 'info',\n        sticky: true,\n      });\n      openSettings().then(() => focusGroup($('perfGroup'))).catch(() => {});\n      break;\n    }\n    case 'orientation': {\n      // 让物理面板方向跟上策略：策略要横屏就切横屏，要竖屏就切竖屏\n      const s = (state.settings && state.settings.display) || {};\n      const mode = s.orientationMode || 'auto';\n      if (mode === 'auto') {\n        toast({ title: '当前是「跟随应用」', body: '面板方向会按应用自动切换；若某个应用方向不对，可对它单独指定。', type: 'info' });\n        break;\n      }\n      const wantLandscape = mode === 'landscape';\n      state.settings = await api.setSettings({ display: { landscape: wantLandscape } });\n      fillSettings(state.settings);\n      toast({\n        title: wantLandscape ? '面板已切成横屏' : '面板已切成竖屏',\n        body: '下次打开应用生效',\n        type: 'ok',\n      });\n      break;\n    }\n    case 'shared': {\n      toast({ title: '请检查共享目录', body: '到「设置 → 集成与文件」确认本机共享目录存在且可写。', type: 'info', sticky: true });\n      openSettings().then(() => focusGroup(document.querySelector('#settingsBody [data-cat=\"files\"]'))).catch(() => {});\n      break;\n    }\n    // ---- 0.6.2 声音检测对应的修复动作 ----\n    case 'audio': {\n      const t = toast({ title: '正在打开安卓应用声音…', body: '马上重启运行时让 -no-audio 失效', type: 'info', sticky: true, spinner: true });\n      const s = await api.setSettings({ engine: { audio: true } }).catch(() => null);\n      if (!s) { failFix(issue, t, '没能保存声音设置，已打开对应教程'); break; }\n      state.settings = s;\n      fillSettings(s);\n      const r = await api.restartRuntime().catch(() => ({ ok: false }));\n      if (r && r.ok !== false) {\n        t.update({ title: '声音已打开', body: '运行时已重启，现在应该能听到应用声音了', type: 'ok' });\n        setTimeout(t.dismiss, 3600);\n      } else {\n        failFix(issue, t, '声音开关已打开，但运行时重启失败，已打开对应教程');\n      }\n      break;\n    }\n    case 'audioService': {\n      // MSIX / 普通权限都拿不到系统服务的提权操作，直接把教程送到用户面前\n      toast({ title: '需要手动启动 Windows Audio', body: '已打开教程，照着做一次即可', type: 'info', sticky: true });\n      openManualForIssue(issue, 'clicked');\n      break;\n    }\n    case 'repairNetwork': {\n      const t = toast({ title: '正在重置安卓网络…', body: '应用清单会保留', type: 'info', sticky: true, spinner: true });\n      const r = await api.runtimeRepairNetwork().catch(() => ({ ok: false }));\n      if (r && r.ok !== false) {\n        t.update({ title: '安卓网络已重置', body: '下次打开应用重新联网', type: 'ok' });\n        setTimeout(t.dismiss, 3000);\n      } else {\n        t.update({ title: '重置失败', body: (r && r.error) || '请重试', type: 'error' });\n      }\n      break;\n    }\n    case 'report': {\n      const r = await api.doctorReport().catch(() => null);\n      toast(r && r.ok !== false\n        ? { title: '诊断报告已导出', body: '把报告发给作者可以最快定位问题', type: 'ok' }\n        : { title: '导出失败', body: (r && r.error) || '请重试', type: 'error' });\n      break;\n    }\n    case 'settings': {\n      openSettings();\n      break;\n    }\n    default:\n      toast({ title: '暂不支持自动修复', body: issue.hint || '', type: 'info' });\n  }\n  // 修复后重新自检，刷新横幅与状态\n  setTimeout(selfCheck, 600);\n  setTimeout(refreshStatus, 600);\n}\n\nasync function fixAllIssues(issues) {\n  const fixable = issues.filter((i) => i.fix);\n  for (const i of fixable) {\n    // eslint-disable-next-line no-await-in-loop\n    await fixIssue(i);\n    // eslint-disable-next-line no-await-in-loop\n    await new Promise((res) => setTimeout(res, 500));\n  }\n}\n\ninit().catch((e) => {\n  console.error(e);\n  toast({ title: '初始化失败', body: e.message, type: 'error', sticky: true });\n});\n"},"headersSize":196,"bodySize":123657,"redirectURL":"","_transferSize":123853},"cache":{},"timings":{"dns":0.213,"connect":0.083,"ssl":137.342,"send":0,"wait":2.271,"receive":1.141},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4415.255,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}},{"pageref":"page@4c64dcba6b879337edd4a42cb471a1fa","startedDateTime":"2026-11-27T23:27:19.525Z","time":146.63400000000001,"request":{"method":"GET","url":"http://127.0.0.1:8765/assets/logo.png","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Host","value":"127.0.0.1:8765"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64; rv:159.0) Gecko/20100101 Firefox/159.0"},{"name":"Accept","value":"image/avif,image/jxl,image/webp,image/png,image/svg+xml,image/*;q=0.8,*/*;q=0.5"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"http://127.0.0.1:8765/index.html"},{"name":"Sec-Fetch-Dest","value":"image"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":445,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"http/1.0","cookies":[],"headers":[{"name":"Server","value":"SimpleHTTP/0.6 Python/3.14.10"},{"name":"Date","value":"Fri, 27 Nov 2026 23:27:19 GMT"},{"name":"Content-type","value":"image/png"},{"name":"Content-Length","value":"189942"},{"name":"Last-Modified","value":"Fri, 27 Nov 2026 23:27:13 GMT"}],"content":{"size":189942,"mimeType":"image/png","compression":0,"text":"","encoding":"base64"},"headersSize":190,"bodySize":189942,"redirectURL":"","_transferSize":190132},"cache":{},"timings":{"dns":0.053,"connect":0.102,"ssl":144.396,"send":0,"wait":1.211,"receive":0.872},"_frameref":"frame@4ee5dd3fc46e42c13c6ad53ca8b3f64c","_monotonicTime":4469.208,"_resourceType":"image","serverIPAddress":"127.0.0.1","_serverPort":8765,"_securityDetails":{}}]}}